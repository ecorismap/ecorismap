{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "extends": [
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:react/recommended",
    "@react-native",
    "plugin:react-native/all",
    "prettier"
  ],
  "globals": {
    "JSX": true
  },
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react", "react-hooks", "prettier", "react-native", "jest"],
  "rules": {
    "no-console": "warn",
    "no-alert": "off",
    "react-native/no-inline-styles": 0,
    "react-native/no-raw-text": ["error", { "skip": ["SvgText"] }],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "caughtErrors": "none", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "react-native/sort-styles": "off",
    // SDK 56: ルートの"expo-media-library"が返す旧関数API(createAssetAsync等)は実行時に例外を投げるスタブ。
    // 従来APIは必ず"expo-media-library/legacy"から読み込む（0.6.8の写真保存不具合の再発防止）
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "expo-media-library",
            "message": "ルートの旧関数APIは実行時に例外を投げます。'expo-media-library/legacy' から読み込んでください"
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='require'] > Literal[value='expo-media-library']",
        "message": "ルートの旧関数APIは実行時に例外を投げます。require('expo-media-library/legacy') を使ってください"
      },
      {
        "selector": "CallExpression[callee.object.name='jest'][callee.property.name='mock'] > Literal[value='expo-media-library']",
        "message": "テストではルートではなく 'expo-media-library/legacy' をモックしてください（ルートのモックは実挙動を隠します）"
      }
    ]
    //"complexity": ["error", 10]
  }
}
