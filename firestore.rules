rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{project} {
        function isSignedIn() {
          return request.auth != null && request.auth.token.email_verified;
        }
        function verifyFields(requiredFields, optionalFields) {
  				return (request.resource.data.keys().hasAll(requiredFields) && 
          request.resource.data.keys().hasOnly(requiredFields.concat(optionalFields)));
				}
        function verifyUpdateFields(fields) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
        }
        allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && verifyFields(["ownerUid", "adminsUid", "membersUid","encdata","encryptedAt"],["cryptoScheme","dekPublicKey"]);

        // 更新: オーナーは常に可。更新後がDEK方式(エンベロープ暗号)になるなら管理者も可。
        // request.resource(更新後)を見ることで、管理者による「メンバー追加(既にdek)」と
        // 「group→dekへの移行(Phase ii)」の両方を許可する。
        // アーカイブ/復元は平文フラグ archived だけの更新（再暗号化不要）なので、
        // 暗号方式に関わらず管理者にも許可する。
        allow update: if isSignedIn()
        && verifyUpdateFields(["adminsUid", "membersUid","encdata","encryptedAt","cryptoScheme","dekPublicKey","archived"])
        && (
             request.auth.uid == resource.data.ownerUid
          || (request.resource.data.cryptoScheme == "dek" && request.auth.uid in resource.data.adminsUid)
          || (
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(["archived"])
            && request.auth.uid in resource.data.adminsUid
          )
        );
 

        allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
        allow read: if isSignedIn() && ((request.auth.uid in resource.data.membersUid) || (request.auth.uid == resource.data.ownerUid));
        match /settings/{settings} {
          allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid;
          allow write: if isSignedIn() 
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
          && verifyFields(["editorUid","encdata","encryptedAt"],[]);
        }
        match /data/{data} {
          // isSignedIn()(email_verified検証)は全分岐に効かせる必要があるため、
          // ||で並ぶ分岐全体を括弧で囲む（&&が||より優先されるので括弧が無いと後半分岐が検証を迂回する）
          allow create,update: if isSignedIn()
          && (
              (
                 (
                    (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && request.resource.data.permission == "PRIVATE")
                 || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && request.resource.data.permission == "PUBLIC")
                 || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid && request.resource.data.permission == "COMMON")
                 || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid && request.resource.data.permission == "TEMPLATE")
                 )
                && request.auth.uid == request.resource.data.userId
                && verifyFields(["layerId", "userId", "permission","encdata","encryptedAt"],["chunkIndex","cryptoScheme"])
              )
           || (
                request.method == "update"
                && request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
                && verifyUpdateFields(["permission"])
              )
           // Phase ii(移行)用: 管理者は共有データ(COMMON/TEMPLATE)を任意ユーザーのuserIdで再暗号化・書き戻しできる。
           // COMMON/TEMPLATEは管理者管理の共有データであり、所有者本人でなくても書ける（移行/再暗号化のため）。
           || (
                request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
                && (request.resource.data.permission == "COMMON" || request.resource.data.permission == "TEMPLATE")
                && verifyFields(["layerId", "userId", "permission","encdata","encryptedAt"],["chunkIndex","cryptoScheme"])
              )
          );

          allow delete: if isSignedIn() 
          && (request.auth.uid == resource.data.userId
          || request.auth.uid == get(/databases/$(database)/documents/projects/$(project)).data.ownerUid 
          || request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid);

 
          allow read: if isSignedIn() 
          && (
             (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && request.auth.uid == resource.data.userId)
          || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && resource.data.permission == "PUBLIC")
          || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && resource.data.permission == "COMMON")
          || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid && resource.data.permission == "TEMPLATE")
          || (request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid) 
          );
        }
        match /position/{position} {
          allow read,write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid;
        }
        // DEK（エンベロープ暗号）の鍵配布。各メンバー宛てにラップされたDEK秘密鍵を格納する。
        match /keys/{uid} {
          // 自分宛ての鍵は読める。管理者は全メンバーの鍵を読める（移行・ローテーション用）。
          allow read: if isSignedIn()
          && (
               request.auth.uid == uid
            || request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
          );
          // 鍵の作成/更新は管理者またはオーナーのみ（オーナーは新規作成時のために許可）。
          // 例外: メンバーは「オーナー宛ての鍵」のみ書ける。管理者不在のプロジェクトでオーナーが
          // 鍵をリセットした場合の復旧用。メンバーは元々DEKを開封できるため機密性は変わらない。
          allow create, update: if isSignedIn()
          && (
               request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
            || request.auth.uid == get(/databases/$(database)/documents/projects/$(project)).data.ownerUid
            || (
                 uid == get(/databases/$(database)/documents/projects/$(project)).data.ownerUid
              && request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.membersUid
            )
          )
          && verifyFields(["encDek","wrapperUid","encryptedAt"],[]);
          // 削除は管理者またはオーナー（メンバー削除時）。
          allow delete: if isSignedIn()
          && (
               request.auth.uid in get(/databases/$(database)/documents/projects/$(project)).data.adminsUid
            || request.auth.uid == get(/databases/$(database)/documents/projects/$(project)).data.ownerUid
          );
        }
    }

    // 署名付きタイル配信の許可設定（レイヤ名 -> allowedDomains / allowedEmails）。
    // Functions(getTileSignatures)がAdmin SDKで読む。Admin SDKはRulesをバイパスするため、
    // クライアントからは読み書きとも一切許可しない。許可リストが誰に見えるかは秘匿情報。
    match /tileAccess/{layer} {
      allow read, write: if false;
    }

    // ユーザー識別鍵の公開鍵台帳（Virgil Cards の後継、脱Virgil移行）。
    // DEKのラップ/署名検証に使うため全認証済みユーザーが読める。
    // 書き込みは本人のみ。台帳の差し替えには本人のFirebase認証の奪取が必要＝E2Eの本人性前提と同等。
    // keyVersion の巻き戻し禁止で「古い（漏洩済みかもしれない）鍵への差し戻し」を塞ぐ。
    match /publicKeys/{uid} {
      function isVerifiedUser() {
        return request.auth != null && request.auth.token.email_verified;
      }
      function verifyPublicKeyFields() {
        return request.resource.data.keys().hasAll(["publicKey", "keyVersion", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasOnly(["publicKey", "keyVersion", "createdAt", "updatedAt", "card"]);
      }
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser()
      && request.auth.uid == uid
      && verifyPublicKeyFields()
      && request.resource.data.keyVersion == 1;
      allow update: if isVerifiedUser()
      && request.auth.uid == uid
      && verifyPublicKeyFields()
      && request.resource.data.keyVersion >= resource.data.keyVersion;
      // アカウント削除時の掃除はFunctions(Admin SDK)側で行う
      allow delete: if false;

      // ローテーションで退避した旧世代の公開鍵（旧ラップの署名検証フォールバック用）
      match /history/{keyVersion} {
        allow read: if isVerifiedUser();
        allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["publicKey", "keyVersion", "createdAt", "rotatedAt"]);
        allow delete: if false;
      }
    }

    // 識別秘密鍵のPINバックアップblobとレート制限カウンタ（脱Virgil: Keyknox/Pythia の後継）。
    // 総当たり防御のためクライアント直接アクセスは全面禁止。読み書きはFunctions(Admin SDK)経由のみ。
    match /keyBackups/{uid} {
      allow read, write: if false;
    }
    match /keyBackupAttempts/{uid} {
      allow read, write: if false;
    }

  }
}
