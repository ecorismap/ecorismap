+//   if (zoom <= self.maximumNativeZ) {
+//     return [self getTile:zoom x:x y:y];
+//   }
+//   BOOL leftColumn = x % 2 == 0;
+//   BOOL topRow = y % 2 == 0;
+//   NSData *Data = [self drawOverZoomTile:(zoom - 1) x:(x / 2) y:(y / 2)];
+//   return [self getHalfTile:Data leftColumn:1 - leftColumn topRow:1 -
