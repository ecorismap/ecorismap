+                                               regionX0:regionX0 regionY0:regionY0 region:region];
+    const float *buffer = (const float *)bufferData.bytes;
+    double metersPerPx = MetersPerPixel(zoom, y, size);
+
+    // レイキャストの標本位置は全画素で共通なので、添字差分と距離の逆数を先に作る
+    NSInteger samples = kNumDirections * kSearchRadius;
+    NSInteger *offsets = (NSInteger *)malloc((size_t)samples * sizeof(NSInteger));
+    float *invDistances = (float *)malloc((size_t)samples * sizeof(float));
+    if (!offsets || !invDistances) {
+        free(offsets);
+        free(invDistances);
+        return nil;
+    }
+    for (NSInteger d = 0; d < kNumDirections; d++) {
+        double theta = 2.0 * M_PI * (double)d / (double)kNumDirections;
+        double dx = cos(theta);
+        double dy = sin(theta);
+        for (NSInteger s = 1; s <= kSearchRadius; s++) {
+            NSInteger i = d * kSearchRadius + (s - 1);
+            offsets[i] = (NSInteger)lround(dy * s) * bufferSize + (NSInteger)lround(dx * s);
+            invDistances[i] = (float)(1.0 / ((double)s * metersPerPx));
+        }
+    }
+
+    NSMutableData *rgbaData = [NSMutableData dataWithLength:(NSUInteger)(region * region * 4)];
+    uint8_t *rgba = (uint8_t *)rgbaData.mutableBytes;
+    const float toDeg = (float)(180.0 / M_PI);
+    const float slopeInv = (float)(1.0 / (2.0 * metersPerPx));
+    const double lightEast = sin(kLightAzimuthDeg * M_PI / 180.0) * cos(kLightAltitudeDeg * M_PI / 180.0);
+    const double lightNorth = cos(kLightAzimuthDeg * M_PI / 180.0) * cos(kLightAltitudeDeg * M_PI / 180.0);
+    const double lightUp = sin(kLightAltitudeDeg * M_PI / 180.0);
+
+    // 陰影段彩用: 等深線の間隔（zoomは計算を実行したsourceZoom）
+    const BOOL reliefMode = self.reliefMode;
+    int contourMinor = 0;
+    int contourMajor = 0;
+    BOOL hasContour = NO;
+    if (reliefMode) {
+        // 等深線の間隔は画素密度で決まるので、terrarium（512px）は256px換算のズームで引く
+        NSInteger contourZoom = [self isTerrarium] ? (NSInteger)zoom + kTerrariumDemZoomOffset : (NSInteger)zoom;
+        hasContour = ContourIntervalsForZoom(contourZoom, &contourMinor, &contourMajor);
+    }
+
+    for (NSInteger py = 0; py < region; py++) {
+        NSInteger rowBase = (kHalo + regionY0 + py) * bufferSize + kHalo + regionX0;
+        for (NSInteger px = 0; px < region; px++) {
+            NSInteger center = rowBase + px;
+            NSInteger out = (py * region + px) * 4;
+            float z0 = buffer[center];
+            if (isnan(z0)) {
+                rgba[out] = rgba[out + 1] = rgba[out + 2] = rgba[out + 3] = 0; // 透明
+                continue;
+            }
+
+            // MPI: 各方位の最大仰角の平均
+            float sumUp = 0.0f;
+            for (NSInteger d = 0; d < kNumDirections; d++) {
+                NSInteger base = d * kSearchRadius;
+                float maxTan = -INFINITY;
+                for (NSInteger s = 0; s < kSearchRadius; s++) {
+                    NSInteger k = base + s;
+                    float zp = buffer[center + offsets[k]];
+                    if (isnan(zp)) continue;
+                    float t = (zp - z0) * invDistances[k];
+                    if (t > maxTan) maxTan = t;
+                }
+                // 有効な標本がなければ水平とみなす。尾根では負になるので丸めない
+                sumUp += isinf(maxTan) ? 0.0f : atanf(maxTan);
+            }
+            float mpi = (sumUp / (float)kNumDirections) * toDeg;
+
+            // 傾斜: 中央差分
+            float gx = (buffer[center + 1] - buffer[center - 1]) * slopeInv;
+            float gy = (buffer[center + bufferSize] - buffer[center - bufferSize]) * slopeInv;
+            float slope = atanf(sqrtf(gx * gx + gy * gy)) * toDeg;
+            if (isnan(slope)) {
+                rgba[out] = rgba[out + 1] = rgba[out + 2] = rgba[out + 3] = 0; // 透明
+                continue;
+            }
+
+            // 2つの暗さを乗算する
+            float sTerm = fmaxf(0.0f, fminf(1.0f, slope / kSlopeMaxDeg));
+            float mTerm = powf(fmaxf(0.0f, fminf(1.0f, mpi / kMpiMaxDeg)), kMpiGamma);
+
+            if (reliefMode) {
+                // 海岸優先: 海に接する陸画素は透明にして下のベース地図の海岸線を見せる。
+                // 海陸統合DEMは境界画素で陸のデータが優先され、近海を陸として塗ってしまうため
+                if (z0 >= 0.0f && HasSeaNeighbor(buffer, center, bufferSize)) {
+                    rgba[out] = rgba[out + 1] = rgba[out + 2] = rgba[out + 3] = 0; // 透明
+                    continue;
+                }
+                // 段彩色×陰影係数（下限付きで緩和）、海域には等深線を焼き込む
+                double shade = (1.0 - (double)sTerm) * (1.0 - (double)mTerm);
+                double factor = kReliefShadeMin + (1.0 - kReliefShadeMin) * shade;
+                if (hasContour && z0 < 0.0f) {
+                    float eRight = buffer[center + 1];
+                    float eDown = buffer[center + bufferSize];
+                    if (IsContourPixel(z0, eRight, eDown, contourMajor)) {
+                        factor *= kContourMajorFactor;
+                    } else if (IsContourPixel(z0, eRight, eDown, contourMinor)) {
+                        factor *= kContourMinorFactor;
+                    }
+                }
+                double rgb[3];
+                ReliefColor((double)z0, kReliefRamp, kReliefRampCount, rgb);
+                rgba[out]     = (uint8_t)fmax(0.0, fmin(255.0, round(rgb[0] * factor)));
+                rgba[out + 1] = (uint8_t)fmax(0.0, fmin(255.0, round(rgb[1] * factor)));
+                rgba[out + 2] = (uint8_t)fmax(0.0, fmin(255.0, round(rgb[2] * factor)));
+                rgba[out + 3] = 255;
+                continue;
+            }
+
+            // 方向陰影: Horn法の勾配と光源方向の内積。バッファの行は南へ進む
+            const NSInteger w = bufferSize;
+            double nw = buffer[center - w - 1], n = buffer[center - w], ne = buffer[center - w + 1];
+            double we = buffer[center - 1], ea = buffer[center + 1];
+            double sw = buffer[center + w - 1], so = buffer[center + w], se = buffer[center + w + 1];
+            double dzdx = (ne + 2 * ea + se - (nw + 2 * we + sw)) / (8.0 * metersPerPx);
+            double dzdy = (nw + 2 * n + ne - (sw + 2 * so + se)) / (8.0 * metersPerPx);
+            double dot = (-dzdx * lightEast - dzdy * lightNorth + lightUp) / sqrt(dzdx * dzdx + dzdy * dzdy + 1.0);
+            if (isnan(dot)) {
+                rgba[out] = rgba[out + 1] = rgba[out + 2] = rgba[out + 3] = 0; // 透明
+                continue;
+            }
+            double h = dot < 0 ? 0 : dot;
+
+            // 下層（灰色h・不透明度a1）の上に上層（黒・不透明度a2＝MPIの乗算）を重ねたover合成。
+            // コンテキストは乗算済みアルファなのでRGBには色×不透明度を入れる
+            double g = (1.0 - (double)sTerm) * (1.0 - (double)mTerm);
+            double a1 = kDirectionalOpacity;
+            double a2 = kMpiOpacity * (1.0 - g);
+            double alpha = 1.0 - (1.0 - a1) * (1.0 - a2);
+            uint8_t premulGray = (uint8_t)fmax(0.0, fmin(255.0, round(255.0 * (1.0 - a2) * a1 * h)));
+
+            rgba[out] = rgba[out + 1] = rgba[out + 2] = premulGray;
+            rgba[out + 3] = (uint8_t)fmax(0.0, fmin(255.0, round(255.0 * alpha)));
+        }
+    }
+
+    free(offsets);
+    free(invDistances);
+
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGContextRef ctx = CGBitmapContextCreate(rgba, (size_t)region, (size_t)region, 8, (size_t)(region * 4), colorSpace,
+                                             kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+    CGColorSpaceRelease(colorSpace);
+    if (!ctx) {
+        return nil;
+    }
+    CGImageRef cgImage = CGBitmapContextCreateImage(ctx);
+    CGContextRelease(ctx);
+    if (!cgImage) {
+        return nil;
+    }
+    UIImage *image = [UIImage imageWithCGImage:cgImage];
+    CGImageRelease(cgImage);
+    return image;
+}
+
+/** maplibreのexponential補間係数（0-1） */
+static double ExponentialInterpolationFactor(double input, double base, double lower, double upper) {
+    double difference = upper - lower;
+    double progress = input - lower;
+    if (difference == 0) return 0;
+    if (base == 1) return progress / difference;
+    return (pow(base, progress) - 1.0) / (pow(base, difference) - 1.0);
+}
+
+/** GEBCO配色を指数補間(0.8)で求める */
+static void GebcoReliefColor(double elev, double *out) {
+    if (elev <= kGebcoReliefRamp[0][0]) {
+        out[0] = kGebcoReliefRamp[0][1]; out[1] = kGebcoReliefRamp[0][2]; out[2] = kGebcoReliefRamp[0][3];
+        return;
+    }
+    const double *last = kGebcoReliefRamp[kGebcoReliefRampCount - 1];
+    if (elev >= last[0]) {
+        out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+        return;
+    }
+    for (NSInteger i = 1; i < kGebcoReliefRampCount; i++) {
+        if (elev <= kGebcoReliefRamp[i][0]) {
+            const double *lo = kGebcoReliefRamp[i - 1];
+            const double *hi = kGebcoReliefRamp[i];
+            double t = ExponentialInterpolationFactor(elev, kGebcoExpBase, lo[0], hi[0]);
+            out[0] = lo[1] + (hi[1] - lo[1]) * t;
+            out[1] = lo[2] + (hi[2] - lo[2]) * t;
+            out[2] = lo[3] + (hi[3] - lo[3]) * t;
+            return;
+        }
+    }
+    out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+}
+
+/** 等値線の横断判定（海陸を問わない。GEBCOスタイル用）。NaN隣接は線にしない */
+static inline BOOL CrossesInterval(float e0, float eRight, float eDown, int interval) {
+    double level = floor((double)e0 / interval);
+    if (!isnan(eRight) && floor((double)eRight / interval) != level) return YES;
+    if (!isnan(eDown) && floor((double)eDown / interval) != level) return YES;
+    return NO;
+}
+
+/**
+ * GEBCOスタイル（デモ再現の近似）の描画。src/utils/colorRelief.ts の computeGebcoRelief と
+ * 同じ計算（指数補間の段彩×白0.85混合＋maplibre hillshadeシェーダの移植＋海陸両方の等値線）。
+ * 島名・海底地形名と等値線の数値ラベルは、タイル焼き込みではなくアプリ側のMarker
+ * オーバーレイで表示する（src/components/organisms/HomeSeaLabels.tsx）。
+ */
+- (UIImage *)gebcoImageForX:(NSUInteger)x y:(NSUInteger)y zoom:(NSUInteger)zoom size:(NSInteger)size {
+    NSInteger bufferSize = size + 2 * kHalo;
+    NSMutableData *bufferData = [self assembleWithHaloX:x y:y zoom:zoom size:size regionX0:0 regionY0:0 region:size];
+    const float *buffer = (const float *)bufferData.bytes;
+
+    int contourMinor = 0;
+    int contourMajor = 0;
+    BOOL hasContour = ContourIntervalsForZoom((NSInteger)zoom, &contourMinor, &contourMajor);
+
+    // maplibre hillshade prepareシェーダのズーム依存derivスケール
+    double zoomFactor = zoom < 2 ? 0.4 : zoom < 4.5 ? 0.35 : 0.3;
+    double exaggerationZ = zoom < 15 ? ((double)zoom - 15.0) * zoomFactor : 0.0;
+    double derivScale = 256.0 / pow(2.0, exaggerationZ + kGebcoDerivExp - (double)zoom);
+
+    // standard_hillshadeの定数
+    double azimuth = kGebcoIlluminationDeg * M_PI / 180.0 + M_PI;
+    double intensity = kGebcoHillshadeExaggeration;
+    double hillshadeBase = 1.875 - intensity * 1.75;
+    double maxValue = 0.5 * M_PI;
+    double intensityClamp = MIN(1.0, MAX(0.0, intensity * 2.0));
+
+    NSMutableData *rgbaData = [NSMutableData dataWithLength:(NSUInteger)(size * size * 4)];
+    uint8_t *rgba = (uint8_t *)rgbaData.mutableBytes;
+
+    for (NSInteger py = 0; py < size; py++) {
+        NSInteger rowBase = (kHalo + py) * bufferSize + kHalo;
+        for (NSInteger px = 0; px < size; px++) {
+            NSInteger center = rowBase + px;
+            NSInteger out = (py * size + px) * 4;
+            float z0 = buffer[center];
+            if (isnan(z0)) {
+                rgba[out] = rgba[out + 1] = rgba[out + 2] = rgba[out + 3] = 0; // 透明
+                continue;
+            }
+
+            // 段彩（指数補間＋白との混合）
+            double rgb[3];
+            GebcoReliefColor((double)z0, rgb);
+            double r = kGebcoBaseMix * rgb[0] + (1.0 - kGebcoBaseMix) * 255.0;
+            double g = kGebcoBaseMix * rgb[1] + (1.0 - kGebcoBaseMix) * 255.0;
+            double b = kGebcoBaseMix * rgb[2] + (1.0 - kGebcoBaseMix) * 255.0;
+
+            // maplibre hillshade（standard法）の合成
+            float a9 = buffer[center - bufferSize - 1];
+            float b9 = buffer[center - bufferSize];
+            float c9 = buffer[center - bufferSize + 1];
+            float d9 = buffer[center - 1];
+            float f9 = buffer[center + 1];
+            float g9 = buffer[center + bufferSize - 1];
+            float h9 = buffer[center + bufferSize];
+            float i9 = buffer[center + bufferSize + 1];
+            float window9 = a9 + b9 + c9 + d9 + f9 + g9 + h9 + i9;
+            if (!isnan(window9)) {
+                double derivX = (c9 + f9 + f9 + i9 - (a9 + d9 + d9 + g9)) * derivScale;
+                double derivY = (g9 + h9 + h9 + i9 - (a9 + b9 + b9 + c9)) * derivScale;
+                double slope = atan(0.625 * sqrt(derivX * derivX + derivY * derivY));
+                double aspect = derivX != 0 ? atan2(derivY, -derivX) : (M_PI / 2.0) * (derivY > 0 ? 1 : -1);
+                double scaledSlope = intensity != 0.5
+                    ? ((pow(hillshadeBase, slope) - 1.0) / (pow(hillshadeBase, maxValue) - 1.0)) * maxValue
+                    : slope;
+                double accentA = kGebcoAccentAlpha * (1.0 - cos(scaledSlope)) * intensityClamp;
+                double shade = fabs(fmod((aspect + azimuth) / M_PI + 0.5, 2.0) - 1.0);
+                double sinSlope = sin(scaledSlope) * intensityClamp;
+                double shadeR = 255.0 * kGebcoHighlightAlpha * shade * sinSlope;
+                double shadeA = (kGebcoShadowAlpha * (1.0 - shade) + kGebcoHighlightAlpha * shade) * sinSlope;
+                double fragA = accentA * (1.0 - shadeA) + shadeA;
+                r = shadeR + r * (1.0 - fragA);
+                g = shadeR + g * (1.0 - fragA);
+                b = shadeR + b * (1.0 - fragA);
+            }
+
+            // 等値線（海陸を問わず）。数値ラベルはアプリ側のMarkerで表示する（HomeSeaLabels.tsx）
+            if (hasContour) {
+                float eRight = buffer[center + 1];
+                float eDown = buffer[center + bufferSize];
+                if (CrossesInterval(z0, eRight, eDown, contourMajor)) {
+                    r *= kGebcoContourMajorFactor;
+                    g *= kGebcoContourMajorFactor;
+                    b *= kGebcoContourMajorFactor;
+                } else if (CrossesInterval(z0, eRight, eDown, contourMinor)) {
+                    r *= kGebcoContourMinorFactor;
+                    g *= kGebcoContourMinorFactor;
+                    b *= kGebcoContourMinorFactor;
+                }
+            }
+
+            rgba[out]     = (uint8_t)fmax(0.0, fmin(255.0, round(r)));
+            rgba[out + 1] = (uint8_t)fmax(0.0, fmin(255.0, round(g)));
+            rgba[out + 2] = (uint8_t)fmax(0.0, fmin(255.0, round(b)));
+            rgba[out + 3] = 255;
+        }
+    }
+
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGContextRef ctx = CGBitmapContextCreate(rgba, (size_t)size, (size_t)size, 8, (size_t)(size * 4), colorSpace,
+                                             kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+    CGColorSpaceRelease(colorSpace);
+    if (!ctx) return nil;
+    CGImageRef cgImage = CGBitmapContextCreateImage(ctx);
+    CGContextRelease(ctx);
+    if (!cgImage) return nil;
+    UIImage *image = [UIImage imageWithCGImage:cgImage];
+    CGImageRelease(cgImage);
+    return image;
+}
+
+/** オーバーズーム時に該当部分を切り出して拡大する */
+- (UIImage *)cropImage:(UIImage *)source scaleFactor:(NSInteger)scaleFactor
+               offsetX:(NSUInteger)offsetX offsetY:(NSUInteger)offsetY {
+    CGImageRef cgImage = source.CGImage;
+    if (!cgImage) return nil;
+
+    CGFloat width = (CGFloat)CGImageGetWidth(cgImage);
+    CGFloat subTileSize = width / (CGFloat)scaleFactor;
+    CGRect cropRect = CGRectMake((CGFloat)offsetX * subTileSize, (CGFloat)offsetY * subTileSize,
+                                 subTileSize, subTileSize);
+    CGImageRef cropped = CGImageCreateWithImageInRect(cgImage, cropRect);
+    if (!cropped) return nil;
+
+    // NoDataの透明を保つため不透明コンテキストは使わない
+    UIGraphicsBeginImageContextWithOptions(CGSizeMake(width, width), NO, 1.0);
+    [[UIImage imageWithCGImage:cropped] drawInRect:CGRectMake(0, 0, width, width)];
+    UIImage *result = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+    CGImageRelease(cropped);
+    return result;
+}
+
+/** 画像を指定寸法へ拡大・縮小する（NoDataの透明を保つため不透明コンテキストは使わない） */
+- (UIImage *)resizeImage:(UIImage *)source toSize:(CGFloat)size {
+    UIGraphicsBeginImageContextWithOptions(CGSizeMake(size, size), NO, 1.0);
+    [source drawInRect:CGRectMake(0, 0, size, size)];
+    UIImage *result = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+    return result;
+}
+
+#pragma mark - タイル要求
+
+- (UIImage *)tileForX:(NSUInteger)x y:(NSUInteger)y zoom:(NSUInteger)zoom {
+    NSString *cacheKey = [NSString stringWithFormat:@"%lu,%lu,%lu", (unsigned long)x, (unsigned long)y, (unsigned long)zoom];
+    UIImage *cached = [_shadingCache objectForKey:cacheKey];
+    if (cached) {
+        return cached;
+    }
+
+    // まずオーバーズーム分を落とす。terrariumは1段粗いズームの512pxタイルから切り出す
+    NSInteger maximumNativeZ = self.maximumNativeZ;
+    NSInteger startZoom = ((NSInteger)zoom > maximumNativeZ) ? maximumNativeZ : (NSInteger)zoom;
+    if ([self isTerrarium]) {
+        startZoom = MAX(0, startZoom - kTerrariumDemZoomOffset);
+    }
+    NSInteger lowestZoom = MAX(0, startZoom - kMaxZoomFallback);
+
+    // 標高タイルの提供範囲はズームによって地域差がある（例えば産総研の陸域統合DEMは
+    // z14は全国にあるがz15は佐渡島・知床・屋久島などで欠ける）。取れなければ粗い
+    // ズームへ降り、該当部分を切り出して拡大する。
+    for (NSInteger sourceZoom = startZoom; sourceZoom >= lowestZoom; sourceZoom--) {
+        NSInteger shift = (NSInteger)zoom - sourceZoom;
+        NSUInteger sx = x >> shift;
+        NSUInteger sy = y >> shift;
+
+        // 中央タイルが取れなければ、さらに粗いズームを試す
+        NSInteger size = 0;
+        NSData *center = [self elevationForX:sx y:sy zoom:(NSUInteger)sourceZoom size:&size];
+        if (!center || size <= 0) {
+            continue;
+        }
+
+        BOOL isGebco = self.reliefMode && self.reliefGebcoStyle;
+        UIImage *image;
+        if (isGebco) {
+            image = [self gebcoImageForX:sx y:sy zoom:(NSUInteger)sourceZoom size:size];
+            if (image && shift > 0) {
+                image = [self cropImage:image
+                            scaleFactor:(1 << shift)
+                                offsetX:(x - (sx << shift))
+                                offsetY:(y - (sy << shift))];
+            }
+        } else {
+            image = [self shadingImageForX:sx y:sy zoom:(NSUInteger)sourceZoom size:size
+                               scaleFactor:(1 << shift)
+                                   offsetX:(x - (sx << shift))
+                                   offsetY:(y - (sy << shift))];
+            // 区画が256pxと違えば（オーバーズーム・z0）256pxへ拡大・縮小する
+            if (image && image.CGImage && CGImageGetWidth(image.CGImage) != 256) {
+                image = [self resizeImage:image toSize:256];
+            }
+        }
+        if (image && isGebco && size > 256 && image.CGImage) {
+            // GMSのタイルは256pt前提。512pxソース（elev2）はscale=2のretinaタイルとして返し詳細を保つ
+            image = [UIImage imageWithCGImage:image.CGImage
+                                        scale:((CGFloat)size / 256.0)
+                                  orientation:UIImageOrientationUp];
+        }
+        if (!image) {
+            return kGMSTileLayerNoTile;
+        }
+
+        [_shadingCache setObject:image forKey:cacheKey cost:(NSUInteger)(size * size * 4)];
+        return image;
+    }
+    return kGMSTileLayerNoTile;
+}
+
+- (void)clearTileCache {
+    [_shadingCache removeAllObjects];
+    [_elevationCache removeAllObjects];
+    [super clearTileCache];
+}
+
+@end
+
+#endif
