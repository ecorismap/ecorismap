+      //System.out.println("##!style updated" + x + "/" + y + "/" + zoom);
+      return true;
+    }
+    if ((now - lastModified) / 1000 > this.tileCacheMaxAge) {
+      //System.out.println("##cache expired");
+      return true;
+    }
+    //System.out.println("##!not update " + x + "/" + y + "/" + zoom);
+    return false;
+  }
