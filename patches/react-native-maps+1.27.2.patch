+      e.printStackTrace();
+      return false;
+    } catch (OutOfMemoryError e) {
+      e.printStackTrace();
+      return false;
+    } finally {
+      if (out != null) try {
+        out.close();
+      } catch (Exception ignored) {}
+    }
+  }
