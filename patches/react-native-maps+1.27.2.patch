+//
+//  StyleExpression.h
+//
+//  MapLibre スタイル仕様の式（expression）をネイティブで評価する。
+//  Web（maplibre-gl）がリファレンスで、意味論は @maplibre/maplibre-gl-style-spec に合わせる。
+//  対応する演算子・既知の差分は docs/VECTOR_STYLE_SUPPORT.md を参照。
+//
+//  - Foundation だけに依存する（macOS 上の CLI ランナーでそのままテストできる）
+//  - 評価エラーは例外ではなく errorValue（シングルトン）で返す。型付きヘルパー（evalNumber 等）は
+//    エラー・型不一致・未指定をすべて「そのプロパティの既定値」に落とす。レイヤやスタイル全体を落とさない
+//  - 値の表現: NSNull=null, NSNumber(CFBoolean)=boolean, NSNumber=number, NSString=string,
+//    NSArray=array, NSDictionary=object, CssColor=color
+//
+//  Android 版（VectorStyle/StyleExpression.java）と演算子ごとに 1:1 で対応させている。
+//  演算子を足すときは両方と共通フィクスチャ（scripts/gen-style-fixtures.mjs）を同時に更新すること。
+//
+
+#import <Foundation/Foundation.h>
+#import "CssColor.h"
+#import "EvalContext.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface StyleExpression : NSObject
+
+#pragma mark - 生の評価
+
+/// 式を評価する。戻り値は NSNull / NSNumber / NSString / NSArray / NSDictionary / CssColor / errorValue
++ (id)evaluate:(id)expr context:(EvalContext *)ctx;
+/// 評価エラーを表すシングルトン
++ (id)errorValue;
++ (BOOL)isError:(id)value;
+
+#pragma mark - 型付きヘルパー（失敗したら defaultValue）
+
+/// nil / NSNull / エラー / 数値でない → defaultValue。数値に変換できる文字列は救う。NaN/inf → defaultValue
++ (double)evalNumber:(nullable id)expr context:(EvalContext *)ctx defaultValue:(double)def key:(nullable NSString *)key;
+/// 文字列は CssColor で解釈。色でない → defaultValue
++ (nullable CssColor *)evalColor:(nullable id)expr context:(EvalContext *)ctx defaultValue:(nullable CssColor *)def key:(nullable NSString *)key;
+/// 文字列はそのまま、数値は JS 書式で文字列化。null / 他 → defaultValue
++ (nullable NSString *)evalString:(nullable id)expr context:(EvalContext *)ctx defaultValue:(nullable NSString *)def key:(nullable NSString *)key;
+/// boolean のみ。他 → defaultValue
++ (BOOL)evalBool:(nullable id)expr context:(EvalContext *)ctx defaultValue:(BOOL)def key:(nullable NSString *)key;
+
+#pragma mark - filter
+
+/// 正規化済みフィルタを評価。nil → YES。boolean 以外・エラー → NO（maplibre と同じく、評価できない地物は描かない）
++ (BOOL)evalFilter:(nullable id)normalizedFilter context:(EvalContext *)ctx;
+/// legacy filter（["==","k",v] / ["in","k",a,b] / ["has","k"] / "$type" など）を式に変換する。式ならそのまま返す。
+/// スタイル読込時に 1 回だけ呼ぶ
++ (nullable id)normalizeFilter:(nullable id)filter;
+
+#pragma mark - text-field
+
+/// 文字列（"{name}" トークン置換）/ ["get"] / ["concat"] / ["format"] / ["to-string"] / その他の式 → 表示文字列。
+/// null・エラー → @""（呼び出し側は空なら描画しない）
++ (NSString *)evalTextField:(nullable id)expr context:(EvalContext *)ctx;
+
+#pragma mark - ユーティリティ
+
+/// JS の Number → String と同じ書式（1.0 → "1", 1e21 → "1e+21", 1e-7 → "1e-7"）
++ (NSString *)jsNumberToString:(double)value;
+/// JS の Number(string) と同じ解釈。数値にならなければ NAN
++ (double)jsStringToNumber:(NSString *)string;
+/// MapLibre の valueToString（to-string / concat が使う）
++ (NSString *)valueToString:(nullable id)value;
+/// 同型かつ同値（["=="] の意味論）
++ (BOOL)strictEquals:(nullable id)a with:(nullable id)b;
+/// "null" | "boolean" | "number" | "string" | "array" | "object" | "color"
++ (NSString *)typeName:(nullable id)value;
+
