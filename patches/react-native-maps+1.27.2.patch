+          CssColor color = StyleExpression.evalColor(paint.get("line-color"), ctx, black, layerId + "/line-color");
+          float width = (float) StyleExpression.evalNumber(paint.get("line-width"), ctx, 1, layerId + "/line-width");
+          double opacity = clamp01(StyleExpression.evalNumber(paint.get("line-opacity"), ctx, 1, layerId + "/line-opacity"));
+          if (width <= 0 || opacity <= 0) continue;
+
+          linePaint.setColor(argbWithOpacity(color, opacity));
+          linePaint.setStyle(Paint.Style.STROKE);
+          linePaint.setStrokeWidth(width);
+          canvas.drawPath(path, linePaint);
+        }
+      } else if ("fill".equals(type)) {
+        Paint fillPaint = new Paint();
+        Paint strokePaint = new Paint();
