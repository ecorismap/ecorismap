+  private static double clamp01(double v) {
+    return Math.min(Math.max(v, 0), 1);
+  }
+
+  /** CssColor（alpha 0〜1）に opacity を掛けて ARGB int にする */
+  private static int argbWithOpacity(CssColor color, double opacity) {
+    double a = clamp01(color.a * opacity);
+    return ((int) Math.round(a * 255) << 24) | ((int) Math.round(color.r) << 16) | ((int) Math.round(color.g) << 8)
+        | (int) Math.round(color.b);
+  }
+
+  /**
+   * スタイルレイヤの描画。paint/layout の各プロパティは地物ごとに式として評価する（データ連動）。
+   * 評価できない値はそのプロパティの既定値（MapLibre Style Spec v8）に退避し、レイヤは落とさない。
+   * iOS の applyStyleToContext:withStyleLayer:andSource:zoom: と同じ順序・同じ既定値。
+   */
+  public void applyStyle(Canvas canvas, LayerStyle styleLayer, VectorSource source, int zoom) {
+    try {
+      if (canvas == null || styleLayer == null || source == null) {
+        Log.w("MapPMTileProvider", "Invalid parameters for applyStyle");
+        return;
+      }
+      String type = styleLayer.type;
+      if (type == null || type.isEmpty()) {
+        Log.w("MapPMTileProvider", "Invalid or missing layer type");
+        return;
+      }
+      final Map<String, Object> paint = styleLayer.paint != null ? styleLayer.paint : new HashMap<String, Object>();
+      final Map<String, Object> layout = styleLayer.layout != null ? styleLayer.layout : new HashMap<String, Object>();
+      final Object filter = styleLayer.filter; // VectorTileStyleManager が読込時に式へ正規化済み
+      final String layerId = styleLayer.id != null ? styleLayer.id : "?";
+      final CssColor black = new CssColor(0, 0, 0, 1);
+
+      if ("circle".equals(type)) {
+        Paint circlePaint = new Paint();
+        Paint circleOutlinePaint = new Paint();
+        for (FeatureData feature : source.features) {
+          if (!(feature.geometry instanceof List<?>)) continue;
+          EvalContext ctx = makeEvalContext(feature, zoom);
+          if (!StyleExpression.evalFilter(filter, ctx)) continue;
+
+          CssColor color = StyleExpression.evalColor(paint.get("circle-color"), ctx, black, layerId + "/circle-color");
+          // 従来互換で Android は半径と線幅を 2 倍で描く（docs/VECTOR_STYLE_SUPPORT.md の既知差分）
+          float radius = (float) StyleExpression.evalNumber(paint.get("circle-radius"), ctx, 5, layerId + "/circle-radius") * 2;
+          double opacity = clamp01(StyleExpression.evalNumber(paint.get("circle-opacity"), ctx, 1, layerId + "/circle-opacity"));
+          CssColor strokeColor = StyleExpression.evalColor(paint.get("circle-stroke-color"), ctx, black, layerId + "/circle-stroke-color");
+          float strokeWidth = (float) StyleExpression.evalNumber(paint.get("circle-stroke-width"), ctx, 0, layerId + "/circle-stroke-width") * 2;
+          double strokeOpacity = clamp01(StyleExpression.evalNumber(paint.get("circle-stroke-opacity"), ctx, 1, layerId + "/circle-stroke-opacity"));
+          if (radius <= 0) continue;
+
+          circlePaint.setColor(argbWithOpacity(color, opacity));
+          circlePaint.setStyle(Paint.Style.FILL);
+          circleOutlinePaint.setColor(argbWithOpacity(strokeColor, strokeOpacity));
+          circleOutlinePaint.setStyle(Paint.Style.STROKE);
+          circleOutlinePaint.setStrokeWidth(strokeWidth);
