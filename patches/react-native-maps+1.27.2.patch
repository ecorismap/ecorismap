+//
+//  AIRGoogleMapPMTileRasterizer.m
+//
+//  3D地形ビュー用: PMTiles（ベクタ/ラスタ）をPNGファイルへラスタライズするJSモジュール。
+//
+//  AIRGoogleMapPMTileOverlayはPMTilesヘッダーを非同期で取得する（メインスレッドでの
+//  同期フェッチはFabricのprops適用中にタイムアウトしtileType=-1に固定される既知バグの
+//  対策）ため、tileTypeが確定するまで待ってからタイルを描画する。
+//  オーバーレイのインスタンスは設定キーごとにキャッシュし、直列キューで実行する。
+//
+
+#ifdef HAVE_GOOGLE_MAPS
+
+#import "AIRGoogleMapPMTileRasterizer.h"
+#import "AIRGoogleMapPMTileOverlay.h"
+
+// AIRGoogleMapPMTileOverlay.mの非公開メソッドを呼ぶためのカテゴリ宣言。
+// overlay側のシグネチャと必ず一致させる（違うとコンパイルは通り、実行時にunrecognized selectorで落ちる）
+@interface AIRGoogleMapPMTileOverlay (Rasterizer)
+- (NSData *)getTile:(NSUInteger)zoom x:(NSUInteger)x y:(NSUInteger)y failed:(BOOL *)failed;
+- (NSData *)drawOverZoomTile:(NSUInteger)tryZ
+                           x:(NSUInteger)x
+                           y:(NSUInteger)y
+                        minZ:(NSInteger)minZ
+                      failed:(BOOL *)failed;
+@end
+
+@implementation AIRGoogleMapPMTileRasterizer {
+  NSMutableDictionary<NSString *, AIRGoogleMapPMTileOverlay *> *_overlays;
+  dispatch_queue_t _queue;
+}
+
+RCT_EXPORT_MODULE(PMTileRasterizer)
+
+- (instancetype)init {
+  if (self = [super init]) {
+    _overlays = [NSMutableDictionary new];
+    _queue = dispatch_queue_create("jp.co.ecoris.pmtilerasterizer", DISPATCH_QUEUE_SERIAL);
+  }
+  return self;
+}
+
++ (BOOL)requiresMainQueueSetup {
+  return NO;
+}
+
+// 全処理を専用直列キューで実行する（オーバーレイ内部状態はスレッドセーフでないため）
+- (dispatch_queue_t)methodQueue {
+  return _queue;
+}
+
+/** file://スキームを外して実パスにする */
+static NSString *stripFileScheme(NSString *path) {
+  if ([path hasPrefix:@"file://"]) {
+    return [[NSURL URLWithString:path] path];
+  }
+  return path;
+}
+
+RCT_EXPORT_METHOD(renderTile:(NSDictionary *)options
+                  resolve:(RCTPromiseResolveBlock)resolve
+                  reject:(RCTPromiseRejectBlock)reject) {
+  NSString *urlTemplate = options[@"urlTemplate"];
+  NSString *outputPath = options[@"outputPath"];
+  if (urlTemplate == nil || outputPath == nil) {
+    reject(@"E_ARGS", @"urlTemplate and outputPath are required", nil);
+    return;
+  }
+  NSString *styleURL = options[@"styleURL"] ?: @"";
+  NSString *tileCachePath = options[@"tileCachePath"];
+  NSInteger z = [options[@"z"] integerValue];
+  NSInteger x = [options[@"x"] integerValue];
+  NSInteger y = [options[@"y"] integerValue];
+  NSInteger minimumZ = options[@"minimumZ"] ? [options[@"minimumZ"] integerValue] : 0;
+  NSInteger maximumZ = options[@"maximumZ"] ? [options[@"maximumZ"] integerValue] : 22;
+  NSInteger maximumNativeZ = options[@"maximumNativeZ"] ? [options[@"maximumNativeZ"] integerValue] : 18;
+  BOOL flipY = [options[@"flipY"] boolValue];
+  BOOL offlineMode = [options[@"offlineMode"] boolValue];
+  BOOL isVector = [options[@"isVector"] boolValue];
+
+  NSString *key = [NSString stringWithFormat:@"%@|%@|%@|%ld|%d|%d", urlTemplate, styleURL,
+                                             tileCachePath ?: @"", (long)maximumNativeZ,
+                                             offlineMode, isVector];
+  AIRGoogleMapPMTileOverlay *overlay = _overlays[key];
+  if (overlay == nil) {
+    overlay = [AIRGoogleMapPMTileOverlay new];
+    overlay.tileTemplate = urlTemplate;
+    overlay.styleURL = styleURL;
+    // NSStringのまま渡す。NSURLを入れるとベクタPMTilesで落ちる:
+    // StyleManagerのinitが stringByTrimmingCharactersInSet: を呼ぶため
+    // （NSURLには無いセレクタ = unrecognized selectorでSIGABRT）。
+    // overlay内部の他の箇所も [NSURL URLWithString:self.tileCachePath] のように
+    // NSStringとして扱っており、プロパティ宣言もNSStringになっている
+    overlay.tileCachePath = tileCachePath;
+    overlay.minimumZ = minimumZ;
+    overlay.maximumZ = maximumZ;
+    overlay.maximumNativeZ = maximumNativeZ;
+    overlay.doubleTileSize = 0;
+    overlay.tileCacheMaxAge = 0;
+    overlay.flipY = flipY;
+    overlay.offlineMode = offlineMode;
+    overlay.isVector = isVector;
+    [overlay updateTileLayer];
+    _overlays[key] = overlay;
+  }
+
+  // ヘッダー取得完了（tileType確定）を待つ。SharedCacheのタイムアウトは10秒
+  int waitedMs = 0;
+  while (overlay.tileType == -2 && waitedMs < 12000) {
+    usleep(100 * 1000);
+    waitedMs += 100;
+  }
+  if (overlay.tileType == -2 || (overlay.tileType == -1 && !overlay.offlineMode)) {
+    reject(@"E_HEADER", @"PMTiles header not available", nil);
+    return;
+  }
+
+  NSData *data = nil;
+  BOOL failed = NO;
+  if (z > maximumNativeZ) {
+    data = [overlay drawOverZoomTile:z x:x y:y minZ:maximumNativeZ failed:&failed];
+  } else {
+    data = [overlay getTile:z x:x y:y failed:&failed];
+  }
+  // 通信失敗・判定中はタイル無しと区別し、呼び出し側で再試行させる
+  if (data == nil && failed) {
+    reject(@"E_FETCH", @"PMTiles tile fetch failed", nil);
+    return;
+  }
+  if (data == nil || data.length == 0) {
+    resolve(@(0));
+    return;
+  }
+  NSString *outPath = stripFileScheme(outputPath);
+  [[NSFileManager defaultManager]
+      createDirectoryAtPath:[outPath stringByDeletingLastPathComponent]
+      withIntermediateDirectories:YES
+                 attributes:nil
+                      error:nil];
+  NSError *writeError = nil;
+  if (![data writeToFile:outPath options:NSDataWritingAtomic error:&writeError]) {
+    reject(@"E_WRITE", writeError.localizedDescription ?: @"write failed", writeError);
+    return;
+  }
+  // ベクタは512px、ラスタは256pxで描画される
+  NSInteger tileSize = (overlay.tileType == 0 || overlay.tileType == 1) ? 512 : 256;
+  resolve(@(tileSize));
+}
+
+RCT_EXPORT_METHOD(clearProviders:(RCTPromiseResolveBlock)resolve
+                  reject:(RCTPromiseRejectBlock)reject) {
+  [_overlays removeAllObjects];
+  resolve(nil);
+}
+
+@end
+
+#endif
