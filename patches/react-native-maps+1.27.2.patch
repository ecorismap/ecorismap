+  private static boolean isNumberV(Object v) { return v instanceof Number; }
+  private static boolean isStringV(Object v) { return v instanceof String; }
+  private static boolean isArrayV(Object v) { return v instanceof List; }
+  private static boolean isObjectV(Object v) { return v instanceof Map; }
+  private static boolean isColorV(Object v) { return v instanceof CssColor; }
+  private static boolean isErrorV(Object v) { return v == ERROR; }
+  private static double numV(Object v) { return ((Number) v).doubleValue(); }
+  private static boolean boolV(Object v) { return (Boolean) v; }
