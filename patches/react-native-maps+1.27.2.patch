+@implementation StyleExpression
+
++ (void)initialize {
+  if (self == [StyleExpression class]) {
+    kErrorValue = [[NSObject alloc] init];
+  }
+}
+
++ (id)errorValue {
+  return kErrorValue;
+}
+
++ (BOOL)isError:(id)value {
+  return isErrorV(value);
+}
+
+#pragma mark - 評価本体
+
++ (id)evaluate:(id)expr context:(EvalContext *)ctx {
+  if (isNullV(expr)) return [NSNull null];
+  if (isStringV(expr) || isNumberV(expr) || isBoolV(expr) || isColorV(expr)) return expr;
+  if (isObjectV(expr)) return kErrorValue; // 素のオブジェクトは ["literal", {...}] を使う必要がある
+  if (!isArrayV(expr)) return kErrorValue;
+  NSArray *arr = expr;
+  if (arr.count == 0 || !isStringV(arr[0])) return kErrorValue;
+  return [self evaluateArray:arr context:ctx];
+}
+
+/// 引数を全部評価して数値配列にする。1つでも数値でなければ nil
++ (nullable NSArray<NSNumber *> *)evaluateNumbers:(NSArray *)arr from:(NSUInteger)start context:(EvalContext *)ctx {
+  NSMutableArray *out = [NSMutableArray arrayWithCapacity:arr.count];
+  for (NSUInteger i = start; i < arr.count; i++) {
+    id v = [self evaluate:arr[i] context:ctx];
+    if (!isNumberV(v)) return nil;
+    [out addObject:v];
+  }
+  return out;
+}
+
++ (id)evaluateArray:(NSArray *)arr context:(EvalContext *)ctx {
+  NSString *opName = arr[0];
+  StyleOp op = (StyleOp)[opTable()[opName] integerValue];
+  NSUInteger argc = arr.count - 1;
+
+  switch (op) {
+    case OpUnknown:
+      return kErrorValue;
+
+    case OpLiteral:
+      if (argc != 1) return kErrorValue;
+      return arr[1] ?: [NSNull null];
+
+    case OpGet:
+    case OpHas: {
+      if (argc < 1 || argc > 2) return kErrorValue;
+      id key = [self evaluate:arr[1] context:ctx];
+      if (!isStringV(key)) return kErrorValue;
+      NSDictionary *obj = ctx.properties;
+      if (argc == 2) {
+        id o = [self evaluate:arr[2] context:ctx];
+        if (!isObjectV(o)) return kErrorValue;
+        obj = o;
+      }
+      id v = obj[key];
+      if (op == OpHas) return boxBool(v != nil);
+      return v ?: [NSNull null];
+    }
+
+    case OpProperties:
+      return ctx.properties ?: @{};
+
+    case OpGeometryType:
+      return ctx.geometryType ?: @"";
+
+    case OpId:
+      return ctx.featureId ?: [NSNull null];
+
+    case OpZoom:
+      return boxNum(ctx.zoom);
+
+    case OpFeatureState:
+      return [NSNull null]; // feature-state はネイティブに無い。常に null
+
+    case OpMatch:
+      return [self opMatch:arr context:ctx];
+
+    case OpCase:
+      return [self opCase:arr context:ctx];
+
+    case OpCoalesce: {
+      if (argc < 1) return kErrorValue;
+      id result = [NSNull null];
+      for (NSUInteger i = 1; i < arr.count; i++) {
+        result = [self evaluate:arr[i] context:ctx];
+        if (isErrorV(result)) return kErrorValue;
+        if (!isNullV(result)) return result;
+      }
+      return result;
+    }
+
+    case OpLet: {
+      // ["let", name1, value1, ..., result]
+      if (argc < 3 || argc % 2 == 0) return kErrorValue;
+      NSMutableDictionary *bindings = [NSMutableDictionary dictionary];
+      for (NSUInteger i = 1; i + 1 < arr.count - 1; i += 2) {
+        if (!isStringV(arr[i])) return kErrorValue;
+        id v = [self evaluate:arr[i + 1] context:ctx];
+        if (isErrorV(v)) return kErrorValue;
+        bindings[arr[i]] = v;
+      }
+      return [self evaluate:arr.lastObject context:[ctx contextByAddingBindings:bindings]];
+    }
+
+    case OpVar: {
+      if (argc != 1 || !isStringV(arr[1])) return kErrorValue;
+      id v = ctx.bindings[arr[1]];
+      if (v == nil) return kErrorValue; // 未束縛
+      return v;
+    }
+
+    case OpEq:
+    case OpNeq: {
+      if (argc < 2 || argc > 3) return kErrorValue; // 第3引数（collator）は無視
+      id a = [self evaluate:arr[1] context:ctx];
+      if (isErrorV(a)) return kErrorValue;
+      id b = [self evaluate:arr[2] context:ctx];
+      if (isErrorV(b)) return kErrorValue;
+      BOOL eq = [self strictEquals:a with:b];
+      return boxBool(op == OpEq ? eq : !eq);
+    }
+
+    case OpLt:
+    case OpLte:
+    case OpGt:
+    case OpGte: {
+      if (argc < 2 || argc > 3) return kErrorValue;
+      id a = [self evaluate:arr[1] context:ctx];
+      if (isErrorV(a)) return kErrorValue;
+      id b = [self evaluate:arr[2] context:ctx];
+      if (isErrorV(b)) return kErrorValue;
