+package VectorTileStyle;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * スタイルレイヤ 1 つぶん。型付きの paint/layout モデルは廃止し、JSON を Map のまま持つ。
+ * paint/layout の値は描画時に地物ごとに StyleExpression で評価する（リテラルも式も同じ経路）。
+ * 読込時の正規化（legacy filter → 式、visibility:none の除外、不正レイヤの除外）は fromMap が行う。
+ * iOS の StyleManager.normalizeLayers と同じ規則。
+ */
+public class LayerStyle {
+
+  public String id;
+  public String type;
+  public String sourceLayer;
+  /** minzoom / maxzoom。未指定は null（描画側で 0 / 22 を既定にする） */
+  public Double minzoom;
+  public Double maxzoom;
+  public Map<String, Object> paint;
+  public Map<String, Object> layout;
+  /** 正規化済みの式。null なら全通過 */
+  public Object filter;
+
+  /**
+   * JSON（Map）からレイヤを作る。レイヤとして成立しないもの（type / source-layer が文字列でない、
+   * visibility が none）は null を返し、呼び出し側がスキップする。
+   */
+  @SuppressWarnings("unchecked")
+  public static LayerStyle fromMap(Object raw) {
+    if (!(raw instanceof Map)) return null;
+    Map<?, ?> m = (Map<?, ?>) raw;
+    Object type = m.get("type");
+    Object sourceLayer = m.get("source-layer");
+    if (!(type instanceof String) || !(sourceLayer instanceof String)) return null;
+
+    LayerStyle layer = new LayerStyle();
+    layer.id = m.get("id") instanceof String ? (String) m.get("id") : "?";
+    layer.type = (String) type;
+    layer.sourceLayer = (String) sourceLayer;
+    layer.minzoom = m.get("minzoom") instanceof Number ? ((Number) m.get("minzoom")).doubleValue() : null;
+    layer.maxzoom = m.get("maxzoom") instanceof Number ? ((Number) m.get("maxzoom")).doubleValue() : null;
+    layer.paint = m.get("paint") instanceof Map ? (Map<String, Object>) m.get("paint") : new HashMap<String, Object>();
+    layer.layout = m.get("layout") instanceof Map ? (Map<String, Object>) m.get("layout") : new HashMap<String, Object>();
+    Object visibility = layer.layout.get("visibility");
+    if ("none".equals(visibility)) return null;
+    layer.filter = StyleExpression.normalizeFilter(m.get("filter"));
+    return layer;
+  }
+
+  /** layers 配列（Map のリスト）をまとめて変換する。壊れたレイヤだけを除外する */
+  public static List<LayerStyle> fromList(Object rawLayers) {
+    List<LayerStyle> out = new java.util.ArrayList<>();
+    if (!(rawLayers instanceof List)) return out;
+    for (Object raw : (List<?>) rawLayers) {
+      LayerStyle layer = fromMap(raw);
+      if (layer != null) out.add(layer);
+    }
+    return out;
+  }
+
+  @Override
+  public String toString() {
+    return "LayerStyle{id=" + id + ", type=" + type + ", source-layer=" + sourceLayer + "}";
+  }
+}
