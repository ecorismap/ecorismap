+/// 文字列をコードポイント（UTF-32）の配列に分解する（JS の [...str] と同じ単位）
+static NSArray<NSString *> *codePoints(NSString *s) {
+  NSMutableArray *out = [NSMutableArray array];
+  [s enumerateSubstringsInRange:NSMakeRange(0, s.length)
+                        options:NSStringEnumerationByComposedCharacterSequences
+                     usingBlock:^(NSString *substring, NSRange substringRange, NSRange enclosingRange, BOOL *stop) {
+                       // 合成文字列は JS の [...str] より粗いので、サロゲートペア単位に分解し直す
+                       NSString *sub = substring;
+                       NSUInteger i = 0;
+                       while (i < sub.length) {
+                         unichar c = [sub characterAtIndex:i];
+                         NSUInteger len = (CFStringIsSurrogateHighCharacter(c) && i + 1 < sub.length) ? 2 : 1;
+                         [out addObject:[sub substringWithRange:NSMakeRange(i, len)]];
+                         i += len;
+                       }
+                     }];
+  return out;
+}
+
+static NSArray *jsSliceArray(NSArray *arr, double begin, BOOL hasEnd, double end) {
+  double len = (double)arr.count;
+  double b = begin < 0 ? MAX(len + begin, 0) : MIN(begin, len);
+  double e = !hasEnd ? len : (end < 0 ? MAX(len + end, 0) : MIN(end, len));
+  if (isnan(b)) b = 0;
+  if (isnan(e)) e = 0;
+  NSUInteger bi = (NSUInteger)floor(b), ei = (NSUInteger)floor(e);
+  if (ei <= bi) return @[];
+  return [arr subarrayWithRange:NSMakeRange(bi, ei - bi)];
+}
