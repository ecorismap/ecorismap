+      String itemType = null;
+      for (Object item : arr) {
+        String t = typeName(item);
+        if (itemType == null) {
+          itemType = t;
+        } else if (!itemType.equals(t)) {
+          itemType = "value";
+          break;
+        }
+      }
+      return "array<" + (itemType != null ? itemType : "value") + ", " + arr.size() + ">";
+    }
+    if (isObjectV(value)) return "object";
+    return "null";
+  }
+
+  private static final Set<String> WARNED = new HashSet<>();
+
+  /** 同じキーの警告は 1 回だけ出す（タイルごとに出ると洪水になる） */
+  public static void warnOnce(String key, String message) {
