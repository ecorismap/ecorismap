+- (NSData *)readTileImage:(NSURL *)url {
+  NSError *error = nil;
+  NSData *data = [NSData dataWithContentsOfURL:url
+                                       options:NSDataReadingUncached
+                                         error:&error];
+  if (error) {
+    // NSLog(@"!!!! %@", [error localizedDescription]);
+    return nil;
+  } else {
+    return data;
+  }
+}
