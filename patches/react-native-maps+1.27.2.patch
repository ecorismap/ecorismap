@@ -0,0 +1,26 @@
+// UIColor+Hex.m
+#import "UIColor+Hex.h"
+
+@implementation UIColor (Hex)
+
++ (UIColor *)colorWithHexString:(NSString *)hexString {
+  return [self colorWithCssColor:[CssColor parse:hexString]];
+}
+
++ (UIColor *)colorWithHexString:(NSString *)hexString alpha:(CGFloat)alpha {
+  CssColor *c = [CssColor parse:hexString];
+  if (!c) return nil;
+  return [UIColor colorWithRed:c.r / 255.0 green:c.g / 255.0 blue:c.b / 255.0 alpha:alpha];
+}
+
++ (UIColor *)colorWithCssColor:(CssColor *)color {
+  return [self colorWithCssColor:color opacity:1.0];
+}
+
++ (UIColor *)colorWithCssColor:(CssColor *)color opacity:(CGFloat)opacity {
+  if (!color) return nil;
+  CGFloat a = MIN(MAX(color.a * opacity, 0), 1);
+  return [UIColor colorWithRed:color.r / 255.0 green:color.g / 255.0 blue:color.b / 255.0 alpha:a];
+}
+
+@end
