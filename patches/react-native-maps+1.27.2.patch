+      NSMutableArray *withAlpha = [nums mutableCopy];
+      if (op == OpRgb) [withAlpha addObject:boxNum(1)];
+      return [self colorFromNumberArray:withAlpha] ?: kErrorValue;
+    }
+
+    case OpTypeof: {
+      if (argc != 1) return kErrorValue;
+      id v = [self evaluate:arr[1] context:ctx];
+      if (isErrorV(v)) return kErrorValue;
+      return [self typeName:v];
+    }
+
+    case OpAssertString:
+    case OpAssertNumber:
+    case OpAssertBoolean:
+    case OpAssertObject: {
+      if (argc < 1) return kErrorValue;
+      for (NSUInteger i = 1; i < arr.count; i++) {
+        id v = [self evaluate:arr[i] context:ctx];
+        if (isErrorV(v)) return kErrorValue;
+        if ((op == OpAssertString && isStringV(v)) || (op == OpAssertNumber && isNumberV(v)) ||
+            (op == OpAssertBoolean && isBoolV(v)) || (op == OpAssertObject && isObjectV(v))) {
+          return v;
+        }
+      }
+      return kErrorValue;
+    }
+
+    case OpAssertArray: {
+      // ["array", value] / ["array", type, value] / ["array", type, N, value]
+      if (argc < 1) return kErrorValue;
+      id v = [self evaluate:arr.lastObject context:ctx];
+      if (!isArrayV(v)) return kErrorValue;
+      return v;
+    }
+
+    case OpAdd:
+    case OpMul: {
+      NSArray<NSNumber *> *nums = [self evaluateNumbers:arr from:1 context:ctx];
+      if (!nums) return kErrorValue;
+      double result = op == OpAdd ? 0 : 1;
+      for (NSNumber *n in nums) result = op == OpAdd ? result + n.doubleValue : result * n.doubleValue;
+      return boxNum(result);
+    }
+
+    case OpSub: {
+      if (argc < 1 || argc > 2) return kErrorValue;
+      NSArray<NSNumber *> *nums = [self evaluateNumbers:arr from:1 context:ctx];
+      if (!nums) return kErrorValue;
+      if (argc == 1) return boxNum(-nums[0].doubleValue);
+      return boxNum(nums[0].doubleValue - nums[1].doubleValue);
+    }
+
+    case OpDiv:
+    case OpMod:
+    case OpPow: {
+      if (argc != 2) return kErrorValue;
+      NSArray<NSNumber *> *nums = [self evaluateNumbers:arr from:1 context:ctx];
+      if (!nums) return kErrorValue;
+      double a = nums[0].doubleValue, b = nums[1].doubleValue;
+      if (op == OpDiv) return boxNum(a / b);
+      if (op == OpMod) return boxNum(fmod(a, b)); // JS の % と同じく被除数の符号
+      return boxNum(pow(a, b));
+    }
+
+    case OpAbs:
+    case OpRound:
+    case OpFloor:
+    case OpCeil:
+    case OpSqrt:
+    case OpLn:
+    case OpLog10:
+    case OpLog2:
+    case OpSin:
+    case OpCos:
+    case OpTan:
+    case OpAsin:
+    case OpAcos:
+    case OpAtan: {
+      if (argc != 1) return kErrorValue;
+      NSArray<NSNumber *> *nums = [self evaluateNumbers:arr from:1 context:ctx];
+      if (!nums) return kErrorValue;
+      double v = nums[0].doubleValue;
+      switch (op) {
+        case OpAbs: return boxNum(fabs(v));
+        case OpRound: return boxNum(v < 0 ? -floor(-v + 0.5) : floor(v + 0.5)); // JS Math.round を maplibre が対称化したもの
+        case OpFloor: return boxNum(floor(v));
+        case OpCeil: return boxNum(ceil(v));
+        case OpSqrt: return boxNum(sqrt(v));
+        case OpLn: return boxNum(log(v));
+        case OpLog10: return boxNum(log(v) / M_LN10);
+        case OpLog2: return boxNum(log(v) / M_LN2);
+        case OpSin: return boxNum(sin(v));
+        case OpCos: return boxNum(cos(v));
+        case OpTan: return boxNum(tan(v));
+        case OpAsin: return boxNum(asin(v));
+        case OpAcos: return boxNum(acos(v));
+        default: return boxNum(atan(v));
+      }
+    }
+
+    case OpMin:
+    case OpMax: {
+      NSArray<NSNumber *> *nums = [self evaluateNumbers:arr from:1 context:ctx];
+      if (!nums) return kErrorValue;
+      double result = op == OpMin ? INFINITY : -INFINITY;
+      for (NSNumber *n in nums) result = op == OpMin ? MIN(result, n.doubleValue) : MAX(result, n.doubleValue);
+      return boxNum(result);
+    }
+
+    case OpPi: return boxNum(M_PI);
+    case OpE: return boxNum(M_E);
+    case OpLn2: return boxNum(M_LN2);
+
+    case OpStep:
+      return [self opStep:arr context:ctx];
+
+    case OpInterpolate:
+      return [self opInterpolate:arr context:ctx];
+
+    // --- legacy filter の内部演算子（maplibre の feature_filter と同じ意味論） ---
+    case OpFilterEq:
+    case OpFilterLt:
+    case OpFilterGt:
+    case OpFilterLte:
+    case OpFilterGte: {
+      if (argc != 2 || !isStringV(arr[1])) return kErrorValue;
+      id a = ctx.properties[arr[1]]; // 無ければ nil（JS の undefined）
+      id b = arr[2];
+      if (a == nil) return boxBool(NO);
+      return boxBool([self legacyCompare:a with:b op:op]);
+    }
+
+    case OpFilterIdEq:
+    case OpFilterIdLt:
+    case OpFilterIdGt:
+    case OpFilterIdLte:
+    case OpFilterIdGte: {
+      if (argc != 1) return kErrorValue;
+      id a = ctx.featureId;
+      if (a == nil) return boxBool(NO);
+      StyleOp base = op == OpFilterIdEq ? OpFilterEq : op == OpFilterIdLt ? OpFilterLt : op == OpFilterIdGt ? OpFilterGt
+                   : op == OpFilterIdLte ? OpFilterLte : OpFilterGte;
+      return boxBool([self legacyCompare:a with:arr[1] op:base]);
+    }
+
+    case OpFilterTypeEq: {
+      if (argc != 1) return kErrorValue;
+      return boxBool(isStringV(arr[1]) && [ctx.geometryType isEqualToString:arr[1]]);
+    }
+
+    case OpFilterHas: {
+      if (argc != 1 || !isStringV(arr[1])) return kErrorValue;
+      return boxBool(ctx.properties[arr[1]] != nil);
+    }
+
+    case OpFilterHasId:
+      return boxBool(!isNullV(ctx.featureId));
+
+    case OpFilterTypeIn:
+    case OpFilterIdIn: {
+      if (argc != 1) return kErrorValue;
+      id values = [self evaluate:arr[1] context:ctx];
+      if (!isArrayV(values)) return kErrorValue;
+      id target = op == OpFilterTypeIn ? ctx.geometryType : ctx.featureId;
+      if (target == nil) return boxBool(NO);
+      for (id v in (NSArray *)values) {
+        if ([self strictEquals:v with:target]) return boxBool(YES);
+      }
+      return boxBool(NO);
+    }
+
+    case OpFilterInSmall: {
+      if (argc != 2 || !isStringV(arr[1])) return kErrorValue;
+      id values = [self evaluate:arr[2] context:ctx];
+      if (!isArrayV(values)) return kErrorValue;
+      id a = ctx.properties[arr[1]];
+      if (a == nil) return boxBool(NO);
+      for (id v in (NSArray *)values) {
+        if ([self strictEquals:v with:a]) return boxBool(YES);
+      }
+      return boxBool(NO);
+    }
+  }
+  return kErrorValue;
+}
+
+/// legacy filter の比較: typeof が同じときだけ比較する（JS の `typeof a === typeof b && a < b`）
++ (BOOL)legacyCompare:(id)a with:(id)b op:(StyleOp)op {
+  if (op == OpFilterEq) return [self strictEquals:a with:b];
+  NSComparisonResult cmp;
+  if (isNumberV(a) && isNumberV(b)) {
+    double x = numV(a), y = numV(b);
+    if (isnan(x) || isnan(y)) return NO;
+    cmp = x < y ? NSOrderedAscending : (x > y ? NSOrderedDescending : NSOrderedSame);
+  } else if (isStringV(a) && isStringV(b)) {
+    cmp = [self compareStrings:a with:b];
+  } else {
+    return NO;
+  }
+  switch (op) {
+    case OpFilterLt: return cmp == NSOrderedAscending;
+    case OpFilterLte: return cmp != NSOrderedDescending;
+    case OpFilterGt: return cmp == NSOrderedDescending;
+    default: return cmp != NSOrderedAscending;
+  }
+}
+
+/// JS の文字列比較（UTF-16 コード単位の辞書順）
++ (NSComparisonResult)compareStrings:(NSString *)a with:(NSString *)b {
+  NSUInteger n = MIN(a.length, b.length);
+  for (NSUInteger i = 0; i < n; i++) {
+    unichar ca = [a characterAtIndex:i], cb = [b characterAtIndex:i];
+    if (ca != cb) return ca < cb ? NSOrderedAscending : NSOrderedDescending;
+  }
+  if (a.length == b.length) return NSOrderedSame;
+  return a.length < b.length ? NSOrderedAscending : NSOrderedDescending;
+}
+
++ (id)opMatch:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["match", input, label1, output1, ..., fallback]
+  NSUInteger argc = arr.count - 1;
+  if (argc < 4 || argc % 2 != 0) return kErrorValue;
+  // ラベルは文字列か整数（またはその配列）で、全部同じ型
+  BOOL labelsAreString = NO, labelsAreNumber = NO;
+  for (NSUInteger i = 2; i + 1 < arr.count; i += 2) {
+    NSArray *labels = isArrayV(arr[i]) ? arr[i] : @[ arr[i] ];
+    if (labels.count == 0) return kErrorValue;
+    for (id label in labels) {
+      if (isStringV(label)) {
+        labelsAreString = YES;
+      } else if (isNumberV(label)) {
+        double d = numV(label);
+        if (d != floor(d) || isinf(d)) return kErrorValue; // 数値ラベルは整数のみ
+        labelsAreNumber = YES;
+      } else {
+        return kErrorValue;
+      }
+    }
+  }
+  if (labelsAreString && labelsAreNumber) return kErrorValue;
+  id input = [self evaluate:arr[1] context:ctx];
+  if (isErrorV(input)) return kErrorValue;
+  BOOL inputMatchesType = (labelsAreString && isStringV(input)) || (labelsAreNumber && isNumberV(input));
+  if (inputMatchesType) {
+    for (NSUInteger i = 2; i + 1 < arr.count; i += 2) {
+      NSArray *labels = isArrayV(arr[i]) ? arr[i] : @[ arr[i] ];
+      for (id label in labels) {
+        if ([self strictEquals:label with:input]) return [self evaluate:arr[i + 1] context:ctx];
+      }
+    }
+  }
+  return [self evaluate:arr.lastObject context:ctx];
+}
+
++ (id)opCase:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["case", cond1, out1, ..., fallback]
+  NSUInteger argc = arr.count - 1;
+  if (argc < 3 || argc % 2 != 1) return kErrorValue;
+  for (NSUInteger i = 1; i + 1 < arr.count - 1; i += 2) {
+    id cond = [self evaluate:arr[i] context:ctx];
+    if (!isBoolV(cond)) return kErrorValue;
+    if (boolV(cond)) return [self evaluate:arr[i + 1] context:ctx];
+  }
+  return [self evaluate:arr.lastObject context:ctx];
+}
+
++ (id)opFormat:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["format", content1, {options}?, content2, ...] → 文字列部分だけを連結する（書式オプションは無視）
+  if (arr.count < 2) return kErrorValue;
+  if (isObjectV(arr[1])) return kErrorValue; // 先頭はテキストでなければならない
+  NSMutableString *out = [NSMutableString string];
+  BOOL nextMayBeOptions = NO;
+  for (NSUInteger i = 1; i < arr.count; i++) {
+    id arg = arr[i];
+    if (nextMayBeOptions && isObjectV(arg)) {
+      nextMayBeOptions = NO;
+      continue;
+    }
+    id v = [self evaluate:arg context:ctx];
+    if (isErrorV(v)) return kErrorValue;
+    if (!(isStringV(v) || isNullV(v) || isNumberV(v) || isBoolV(v) || isColorV(v) || isArrayV(v) || isObjectV(v))) {
+      return kErrorValue;
+    }
+    [out appendString:[self valueToString:v]];
+    nextMayBeOptions = YES;
+  }
+  return out;
+}
+
++ (id)opNumberFormat:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["number-format", number, {locale?, currency?, unit?, min-fraction-digits?, max-fraction-digits?}]
+  // en-US の decimal 書式だけ対応する（currency / unit / 他ロケールは未対応 → エラー）
+  if (arr.count != 3 || !isObjectV(arr[2])) return kErrorValue;
+  id n = [self evaluate:arr[1] context:ctx];
+  if (!isNumberV(n)) return kErrorValue;
+  NSDictionary *options = arr[2];
+  if (options[@"currency"] || options[@"unit"]) return kErrorValue;
+  if (options[@"locale"]) {
+    id locale = [self evaluate:options[@"locale"] context:ctx];
+    if (!isStringV(locale)) return kErrorValue;
+    NSString *l = [(NSString *)locale lowercaseString];
+    if (!([l isEqualToString:@"en"] || [l isEqualToString:@"en-us"])) return kErrorValue;
+  }
+  NSInteger minFD = 0, maxFD = 3;
+  // JS 側は `if (options["min-fraction-digits"])` なので 0 は未指定と同じ
+  id minOpt = options[@"min-fraction-digits"];
+  if (minOpt && jsTruthy(minOpt)) {
+    id v = [self evaluate:minOpt context:ctx];
+    if (!isNumberV(v)) return kErrorValue;
+    minFD = (NSInteger)numV(v);
+  }
+  id maxOpt = options[@"max-fraction-digits"];
+  if (maxOpt && jsTruthy(maxOpt)) {
+    id v = [self evaluate:maxOpt context:ctx];
+    if (!isNumberV(v)) return kErrorValue;
+    maxFD = (NSInteger)numV(v);
+  }
+  if (maxFD < minFD) maxFD = minFD; // Intl は max < min を RangeError にするが、ここでは広い方に揃える
+  NSNumberFormatter *fmt = [[NSNumberFormatter alloc] init];
+  fmt.locale = [NSLocale localeWithLocaleIdentifier:@"en_US_POSIX"];
+  fmt.numberStyle = NSNumberFormatterDecimalStyle;
+  fmt.usesGroupingSeparator = YES;
+  fmt.groupingSeparator = @",";
+  fmt.groupingSize = 3;
+  fmt.decimalSeparator = @".";
+  fmt.minimumFractionDigits = minFD;
+  fmt.maximumFractionDigits = maxFD;
+  fmt.roundingMode = NSNumberFormatterRoundHalfUp; // Intl の既定（halfExpand）と同じ
+  NSString *s = [fmt stringFromNumber:n];
+  return s ?: kErrorValue;
+}
+
++ (id)opStep:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["step", input, out0, stop1, out1, stop2, out2, ...]
+  NSUInteger argc = arr.count - 1;
+  if (argc < 4 || argc % 2 != 0) return kErrorValue;
+  // ストップは数値リテラルで昇順
+  double prev = -INFINITY;
+  for (NSUInteger i = 3; i < arr.count; i += 2) {
+    if (!isNumberV(arr[i])) return kErrorValue;
+    double label = numV(arr[i]);
+    if (label <= prev) return kErrorValue;
+    prev = label;
+  }
+  id input = [self evaluate:arr[1] context:ctx];
+  if (!isNumberV(input)) return kErrorValue;
+  double value = numV(input);
+  // labels[0] = -inf, outputs[0] = arr[2]; labels[k] = arr[1+2k], outputs[k] = arr[2+2k]
+  NSUInteger outputIndex = 2;
+  for (NSUInteger i = 3; i < arr.count; i += 2) {
+    if (value >= numV(arr[i])) outputIndex = i + 1;
+    else break;
+  }
+  return [self evaluate:arr[outputIndex] context:ctx];
+}
+
+static double exponentialInterpolation(double input, double base, double lower, double upper) {
+  double difference = upper - lower;
+  double progress = input - lower;
+  if (difference == 0) return 0;
+  if (base == 1) return progress / difference;
+  return (pow(base, progress) - 1) / (pow(base, difference) - 1);
+}
+
+/// maplibre の unitbezier（WebKit 由来）
+static double unitBezierSolve(double p1x, double p1y, double p2x, double p2y, double x) {
+  double cx = 3.0 * p1x, bx = 3.0 * (p2x - p1x) - cx, ax = 1.0 - cx - bx;
+  double cy = 3.0 * p1y, by = 3.0 * (p2y - p1y) - cy, ay = 1.0 - cy - by;
+  const double epsilon = 1e-6;
+  if (x <= 0) return 0;
+  if (x >= 1) return 1;
+  double t = x;
+  for (int i = 0; i < 8; i++) {
+    double x2 = ((ax * t + bx) * t + cx) * t - x;
+    if (fabs(x2) < epsilon) return ((ay * t + by) * t + cy) * t;
+    double d2 = (3 * ax * t + 2 * bx) * t + cx;
+    if (fabs(d2) < 1e-6) break;
+    t -= x2 / d2;
+  }
+  double t0 = 0, t1 = 1;
+  t = x;
+  for (int i = 0; i < 20; i++) {
+    double x2 = ((ax * t + bx) * t + cx) * t;
+    if (fabs(x2 - x) < epsilon) break;
+    if (x > x2) t0 = t;
+    else t1 = t;
+    t = (t0 + t1) * 0.5;
+  }
+  return ((ay * t + by) * t + cy) * t;
+}
+
++ (id)opInterpolate:(NSArray *)arr context:(EvalContext *)ctx {
+  // ["interpolate", ["linear"] | ["exponential", base] | ["cubic-bezier", x1,y1,x2,y2], input, stop1, out1, ...]
+  // 出力は数値と色（rgba の線形補間。interpolate-hcl / -lab は未対応）
+  if (arr.count < 5 || (arr.count - 3) % 2 != 0) return kErrorValue;
+  if (!isArrayV(arr[1]) || [(NSArray *)arr[1] count] == 0 || !isStringV(arr[1][0])) return kErrorValue;
+  NSArray *interp = arr[1];
+  NSString *kind = interp[0];
+  double base = 1;
+  double bez[4] = {0, 0, 1, 1};
+  if ([kind isEqualToString:@"linear"]) {
+    base = 1;
+  } else if ([kind isEqualToString:@"exponential"]) {
+    if (interp.count != 2 || !isNumberV(interp[1])) return kErrorValue;
+    base = numV(interp[1]);
+  } else if ([kind isEqualToString:@"cubic-bezier"]) {
+    if (interp.count != 5) return kErrorValue;
+    for (int i = 0; i < 4; i++) {
+      if (!isNumberV(interp[i + 1])) return kErrorValue;
+      bez[i] = numV(interp[i + 1]);
+    }
+    if (bez[0] < 0 || bez[0] > 1 || bez[2] < 0 || bez[2] > 1) return kErrorValue;
+  } else {
+    return kErrorValue;
+  }
+  NSUInteger stopCount = (arr.count - 3) / 2;
+  double prev = -INFINITY;
+  for (NSUInteger k = 0; k < stopCount; k++) {
+    id label = arr[3 + 2 * k];
+    if (!isNumberV(label)) return kErrorValue;
+    if (numV(label) <= prev) return kErrorValue;
+    prev = numV(label);
+  }
+  id input = [self evaluate:arr[2] context:ctx];
+  if (!isNumberV(input)) return kErrorValue;
+  double value = numV(input);
+  double (^labelAt)(NSUInteger) = ^double(NSUInteger k) { return numV(arr[3 + 2 * k]); };
+  id (^outputAt)(NSUInteger) = ^id(NSUInteger k) { return [self evaluate:arr[4 + 2 * k] context:ctx]; };
+
+  if (stopCount == 1 || value <= labelAt(0)) {
+    id out = outputAt(0);
+    return (isNumberV(out) || isColorV(out)) ? out : kErrorValue;
+  }
+  if (value >= labelAt(stopCount - 1)) {
+    id out = outputAt(stopCount - 1);
+    return (isNumberV(out) || isColorV(out)) ? out : kErrorValue;
+  }
+  NSUInteger index = 0;
+  for (NSUInteger k = 0; k + 1 < stopCount; k++) {
+    if (labelAt(k) <= value && value < labelAt(k + 1)) {
+      index = k;
+      break;
+    }
+  }
+  double lower = labelAt(index), upper = labelAt(index + 1);
+  double t;
+  if ([kind isEqualToString:@"cubic-bezier"]) {
+    t = unitBezierSolve(bez[0], bez[1], bez[2], bez[3], exponentialInterpolation(value, 1, lower, upper));
+  } else {
+    t = exponentialInterpolation(value, base, lower, upper);
+  }
+  id outLower = outputAt(index), outUpper = outputAt(index + 1);
+  if (isColorV(outLower) && isColorV(outUpper)) {
+    CssColor *c0 = outLower, *c1 = outUpper;
+    return [CssColor colorWithR:c0.r * (1 - t) + c1.r * t
+                              g:c0.g * (1 - t) + c1.g * t
+                              b:c0.b * (1 - t) + c1.b * t
+                              a:c0.a * (1 - t) + c1.a * t];
+  }
+  if (!isNumberV(outLower) || !isNumberV(outUpper)) return kErrorValue;
+  double a = numV(outLower), b = numV(outUpper);
+  return boxNum(a * (1 - t) + b * t);
+}
+
+/// [r, g, b(, a)] の数値配列を色にする（maplibre の validateRGBA と同じ範囲検査）
++ (nullable CssColor *)colorFromNumberArray:(NSArray *)input {
+  if (input.count < 3 || input.count > 4) return nil;
+  for (id v in input) {
+    if (!isNumberV(v)) return nil;
+  }
+  double r = numV(input[0]), g = numV(input[1]), b = numV(input[2]);
+  double a = input.count == 4 ? numV(input[3]) : 1;
+  if (!(r >= 0 && r <= 255 && g >= 0 && g <= 255 && b >= 0 && b <= 255)) return nil;
+  if (!(a >= 0 && a <= 1)) return nil;
+  return [CssColor colorWithR:r g:g b:b a:a];
+}
+
+#pragma mark - 型付きヘルパー
+
++ (double)evalNumber:(id)expr context:(EvalContext *)ctx defaultValue:(double)def key:(NSString *)key {
+  if (isNullV(expr)) return def;
+  id v = [self evaluate:expr context:ctx];
+  if (isNumberV(v)) {
+    double d = numV(v);
+    return (isnan(d) || isinf(d)) ? def : d;
+  }
+  if (isStringV(v)) {
+    // maplibre は型エラーにするが、Web で動かないスタイルを救う方向に倒す
+    double d = [self jsStringToNumber:v];
+    if (!isnan(d) && !isinf(d)) return d;
+  }
+  [self warnOnce:key message:[NSString stringWithFormat:@"number expected, using default %g", def]];
+  return def;
+}
+
++ (CssColor *)evalColor:(id)expr context:(EvalContext *)ctx defaultValue:(CssColor *)def key:(NSString *)key {
+  if (isNullV(expr)) return def;
+  id v = [self evaluate:expr context:ctx];
+  if (isColorV(v)) return v;
+  if (isStringV(v)) {
+    CssColor *c = [CssColor parse:v];
+    if (c) return c;
+  }
+  [self warnOnce:key message:@"color expected, using default"];
+  return def;
+}
+
++ (NSString *)evalString:(id)expr context:(EvalContext *)ctx defaultValue:(NSString *)def key:(NSString *)key {
+  if (isNullV(expr)) return def;
+  id v = [self evaluate:expr context:ctx];
+  if (isStringV(v)) return v;
+  if (isNumberV(v)) return [self jsNumberToString:numV(v)];
+  [self warnOnce:key message:@"string expected, using default"];
+  return def;
+}
+
++ (BOOL)evalBool:(id)expr context:(EvalContext *)ctx defaultValue:(BOOL)def key:(NSString *)key {
+  if (isNullV(expr)) return def;
+  id v = [self evaluate:expr context:ctx];
+  if (isBoolV(v)) return boolV(v);
+  [self warnOnce:key message:@"boolean expected, using default"];
+  return def;
+}
+
+#pragma mark - filter
+
++ (BOOL)evalFilter:(id)normalizedFilter context:(EvalContext *)ctx {
+  if (isNullV(normalizedFilter)) return YES;
+  id v = [self evaluate:normalizedFilter context:ctx];
+  if (isBoolV(v)) return boolV(v);
+  return NO;
+}
+
+/// maplibre の isExpressionFilter
++ (BOOL)isExpressionFilter:(id)filter {
+  if (isBoolV(filter)) return YES;
+  if (!isArrayV(filter) || [(NSArray *)filter count] == 0) return NO;
+  NSArray *f = filter;
+  if (!isStringV(f[0])) return YES; // default: 式扱い（評価時にエラーになる）
+  NSString *op = f[0];
+  if ([op isEqualToString:@"has"]) {
+    return f.count >= 2 && !(isStringV(f[1]) && ([f[1] isEqualToString:@"$id"] || [f[1] isEqualToString:@"$type"]));
+  }
+  if ([op isEqualToString:@"in"]) {
+    return f.count >= 3 && (!isStringV(f[1]) || isArrayV(f[2]));
+  }
+  if ([op isEqualToString:@"!in"] || [op isEqualToString:@"!has"] || [op isEqualToString:@"none"]) return NO;
+  if ([op isEqualToString:@"=="] || [op isEqualToString:@"!="] || [op isEqualToString:@">"] ||
+      [op isEqualToString:@">="] || [op isEqualToString:@"<"] || [op isEqualToString:@"<="]) {
+    return f.count != 3 || isArrayV(f[1]) || isArrayV(f[2]);
+  }
+  if ([op isEqualToString:@"any"] || [op isEqualToString:@"all"]) {
+    for (NSUInteger i = 1; i < f.count; i++) {
+      if (![self isExpressionFilter:f[i]] && !isBoolV(f[i])) return NO;
+    }
+    return YES;
+  }
+  return YES;
+}
+
++ (id)normalizeFilter:(id)filter {
+  if (isNullV(filter)) return nil;
+  if ([self isExpressionFilter:filter]) return filter;
+  return [self convertLegacyFilter:filter];
+}
+
+/// maplibre の convertFilter（feature_filter/index.ts 版。filter-* の内部演算子に変換する）
++ (id)convertLegacyFilter:(id)filter {
+  if (isNullV(filter)) return @YES;
+  if (!isArrayV(filter)) return @YES;
+  NSArray *f = filter;
+  if (f.count == 0 || !isStringV(f[0])) return @YES;
+  NSString *op = f[0];
+  if (f.count <= 1) return boxBool(![op isEqualToString:@"any"]);
+  if ([op isEqualToString:@"=="]) return [self convertComparisonOp:f[1] value:f[2] op:@"=="];
+  if ([op isEqualToString:@"!="]) return @[ @"!", [self convertComparisonOp:f[1] value:f[2] op:@"=="] ];
+  if ([op isEqualToString:@"<"] || [op isEqualToString:@">"] || [op isEqualToString:@"<="] || [op isEqualToString:@">="]) {
+    return [self convertComparisonOp:f[1] value:f[2] op:op];
+  }
+  if ([op isEqualToString:@"any"] || [op isEqualToString:@"all"]) {
+    NSMutableArray *out = [NSMutableArray arrayWithObject:op];
+    for (NSUInteger i = 1; i < f.count; i++) [out addObject:[self convertLegacyFilter:f[i]]];
+    return out;
+  }
+  if ([op isEqualToString:@"none"]) {
+    NSMutableArray *out = [NSMutableArray arrayWithObject:@"all"];
+    for (NSUInteger i = 1; i < f.count; i++) [out addObject:@[ @"!", [self convertLegacyFilter:f[i]] ]];
+    return out;
+  }
+  if ([op isEqualToString:@"in"]) return [self convertInOp:f[1] values:[f subarrayWithRange:NSMakeRange(2, f.count - 2)]];
+  if ([op isEqualToString:@"!in"]) {
+    return @[ @"!", [self convertInOp:f[1] values:[f subarrayWithRange:NSMakeRange(2, f.count - 2)]] ];
+  }
+  if ([op isEqualToString:@"has"]) return [self convertHasOp:f[1]];
+  if ([op isEqualToString:@"!has"]) return @[ @"!", [self convertHasOp:f[1]] ];
+  return @YES;
+}
+
++ (id)convertComparisonOp:(id)property value:(id)value op:(NSString *)op {
+  id v = value ?: [NSNull null];
+  if (isStringV(property) && [property isEqualToString:@"$type"]) return @[ [@"filter-type-" stringByAppendingString:op], v ];
+  if (isStringV(property) && [property isEqualToString:@"$id"]) return @[ [@"filter-id-" stringByAppendingString:op], v ];
+  return @[ [@"filter-" stringByAppendingString:op], property ?: [NSNull null], v ];
+}
+
++ (id)convertInOp:(id)property values:(NSArray *)values {
+  if (values.count == 0) return @NO;
+  if (isStringV(property) && [property isEqualToString:@"$type"]) return @[ @"filter-type-in", @[ @"literal", values ] ];
+  if (isStringV(property) && [property isEqualToString:@"$id"]) return @[ @"filter-id-in", @[ @"literal", values ] ];
+  return @[ @"filter-in-small", property ?: [NSNull null], @[ @"literal", values ] ];
+}
+
++ (id)convertHasOp:(id)property {
+  if (isStringV(property) && [property isEqualToString:@"$type"]) return @YES;
+  if (isStringV(property) && [property isEqualToString:@"$id"]) return @[ @"filter-has-id" ];
+  return @[ @"filter-has", property ?: [NSNull null] ];
+}
+
+#pragma mark - text-field
+
++ (NSString *)evalTextField:(id)expr context:(EvalContext *)ctx {
+  if (isNullV(expr)) return @"";
+  if (isStringV(expr)) {
+    NSString *s = expr;
+    if ([s rangeOfString:@"{"].location == NSNotFound) return s;
+    static NSRegularExpression *tokenRe;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+      tokenRe = [NSRegularExpression regularExpressionWithPattern:@"\\{([^{}]+)\\}" options:0 error:nil];
+    });
+    NSMutableString *out = [NSMutableString string];
+    __block NSUInteger last = 0;
+    [tokenRe enumerateMatchesInString:s
+                              options:0
+                                range:NSMakeRange(0, s.length)
+                           usingBlock:^(NSTextCheckingResult *m, NSMatchingFlags flags, BOOL *stop) {
+                             [out appendString:[s substringWithRange:NSMakeRange(last, m.range.location - last)]];
+                             NSString *key = [s substringWithRange:[m rangeAtIndex:1]];
+                             id v = ctx.properties[key];
+                             [out appendString:[self valueToString:v]];
+                             last = NSMaxRange(m.range);
+                           }];
+    [out appendString:[s substringFromIndex:last]];
+    return out;
+  }
+  id v = [self evaluate:expr context:ctx];
+  if (isErrorV(v) || isNullV(v)) return @"";
+  return [self valueToString:v];
+}
+
+#pragma mark - ユーティリティ
+
++ (NSString *)jsNumberToString:(double)value {
+  if (isnan(value)) return @"NaN";
+  if (isinf(value)) return value > 0 ? @"Infinity" : @"-Infinity";
+  if (value == 0) return @"0";
+  BOOL negative = value < 0;
+  double ax = fabs(value);
+  // 往復できる最短の桁数を探す（%.{p-1}e は Darwin では正しく丸められる）
+  NSString *sci = nil;
+  char buf[64];
+  for (int p = 1; p <= 17; p++) {
+    snprintf(buf, sizeof(buf), "%.*e", p - 1, ax); // libc の変換は正しく丸められる（NSString の %e は違うことがある）
+    if (strtod(buf, NULL) == ax) {
+      sci = [NSString stringWithUTF8String:buf];
+      break;
+    }
+  }
+  if (!sci) {
+    snprintf(buf, sizeof(buf), "%.16e", ax);
+    sci = [NSString stringWithUTF8String:buf];
+  }
+  NSArray *parts = [sci componentsSeparatedByString:@"e"];
+  NSString *digits = [parts[0] stringByReplacingOccurrencesOfString:@"." withString:@""];
+  NSInteger exponent = [parts[1] integerValue];
+  // 末尾の 0 を落とす（最小桁数なら付かないはずだが保険）
+  while (digits.length > 1 && [digits hasSuffix:@"0"]) digits = [digits substringToIndex:digits.length - 1];
+  NSInteger k = (NSInteger)digits.length;
+  NSInteger n = exponent + 1;
+  NSMutableString *out = [NSMutableString string];
+  if (negative) [out appendString:@"-"];
+  if (k <= n && n <= 21) {
+    [out appendString:digits];
+    for (NSInteger i = 0; i < n - k; i++) [out appendString:@"0"];
+  } else if (0 < n && n <= 21) {
+    [out appendString:[digits substringToIndex:n]];
+    [out appendString:@"."];
+    [out appendString:[digits substringFromIndex:n]];
+  } else if (-6 < n && n <= 0) {
+    [out appendString:@"0."];
+    for (NSInteger i = 0; i < -n; i++) [out appendString:@"0"];
+    [out appendString:digits];
+  } else {
+    NSInteger e = n - 1;
+    [out appendString:[digits substringToIndex:1]];
+    if (k > 1) {
+      [out appendString:@"."];
+      [out appendString:[digits substringFromIndex:1]];
+    }
+    [out appendFormat:@"e%@%ld", e < 0 ? @"-" : @"+", (long)labs(e)];
+  }
+  return out;
+}
+
++ (double)jsStringToNumber:(NSString *)string {
+  if (![string isKindOfClass:[NSString class]]) return NAN;
+  // JS の StringToNumber: 空白（改行・全角空白・BOM 含む）を除いて解釈する
+  NSMutableCharacterSet *ws = [[NSCharacterSet whitespaceAndNewlineCharacterSet] mutableCopy];
+  [ws addCharactersInString:@"\x0B\x0C      　﻿"];
+  [ws addCharactersInRange:NSMakeRange(0x2000, 11)];
+  NSString *s = [string stringByTrimmingCharactersInSet:ws];
+  if (s.length == 0) return 0;
+  if ([s isEqualToString:@"Infinity"] || [s isEqualToString:@"+Infinity"]) return INFINITY;
+  if ([s isEqualToString:@"-Infinity"]) return -INFINITY;
+  static NSRegularExpression *hexRe, *octRe, *binRe, *decRe;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    hexRe = [NSRegularExpression regularExpressionWithPattern:@"^0[xX][0-9a-fA-F]+$" options:0 error:nil];
+    octRe = [NSRegularExpression regularExpressionWithPattern:@"^0[oO][0-7]+$" options:0 error:nil];
+    binRe = [NSRegularExpression regularExpressionWithPattern:@"^0[bB][01]+$" options:0 error:nil];
+    decRe = [NSRegularExpression regularExpressionWithPattern:@"^[+-]?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
+                                                      options:0
+                                                        error:nil];
+  });
+  NSRange whole = NSMakeRange(0, s.length);
+  if ([hexRe firstMatchInString:s options:0 range:whole]) return (double)strtoull([s substringFromIndex:2].UTF8String, NULL, 16);
+  if ([octRe firstMatchInString:s options:0 range:whole]) return (double)strtoull([s substringFromIndex:2].UTF8String, NULL, 8);
+  if ([binRe firstMatchInString:s options:0 range:whole]) return (double)strtoull([s substringFromIndex:2].UTF8String, NULL, 2);
+  if ([decRe firstMatchInString:s options:0 range:whole]) return strtod(s.UTF8String, NULL);
+  return NAN;
+}
+
++ (NSString *)valueToString:(id)value {
+  if (isNullV(value)) return @"";
+  if (isStringV(value)) return value;
+  if (isBoolV(value)) return boolV(value) ? @"true" : @"false";
+  if (isNumberV(value)) return [self jsNumberToString:numV(value)];
+  if (isColorV(value)) return [(CssColor *)value cssString];
+  if (isArrayV(value) || isObjectV(value)) {
+    // JSON.stringify 相当。NSDictionary はキー順が保たれない（既知の差分）
+    id jsonSafe = [self jsonSafeValue:value];
+    NSData *data = [NSJSONSerialization dataWithJSONObject:jsonSafe
+                                                   options:NSJSONWritingWithoutEscapingSlashes
+                                                     error:nil];
+    if (!data) return @"";
+    return [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] ?: @"";
+  }
+  return @"";
+}
+
+/// NSJSONSerialization が扱えない値（CssColor 等）を文字列に落とす
++ (id)jsonSafeValue:(id)value {
+  if (isArrayV(value)) {
+    NSMutableArray *out = [NSMutableArray array];
+    for (id v in (NSArray *)value) [out addObject:[self jsonSafeValue:v]];
+    return out;
+  }
+  if (isObjectV(value)) {
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    [(NSDictionary *)value enumerateKeysAndObjectsUsingBlock:^(id key, id obj, BOOL *stop) {
+      out[[NSString stringWithFormat:@"%@", key]] = [self jsonSafeValue:obj];
+    }];
+    return out;
+  }
+  if (isColorV(value)) return [(CssColor *)value cssString];
+  if (isNullV(value) || isStringV(value) || isNumberV(value) || isBoolV(value)) return value ?: [NSNull null];
+  return [NSNull null];
+}
+
++ (BOOL)strictEquals:(id)a with:(id)b {
+  if (isNullV(a) && isNullV(b)) return YES;
+  if (isNullV(a) || isNullV(b)) return NO;
+  if (isBoolV(a) && isBoolV(b)) return boolV(a) == boolV(b);
+  if (isBoolV(a) || isBoolV(b)) return NO;
+  if (isNumberV(a) && isNumberV(b)) return numV(a) == numV(b);
+  if (isStringV(a) && isStringV(b)) return [(NSString *)a isEqualToString:b];
+  if (isColorV(a) && isColorV(b)) return [(CssColor *)a isEqualToColor:b];
+  return NO;
+}
+
++ (NSString *)typeName:(id)value {
+  if (isNullV(value)) return @"null";
+  if (isBoolV(value)) return @"boolean";
+  if (isNumberV(value)) return @"number";
+  if (isStringV(value)) return @"string";
+  if (isColorV(value)) return @"color";
+  if (isArrayV(value)) {
+    // maplibre の typeOf: 要素の型が全部同じなら array<型, 個数>、混在なら array<value, 個数>
+    NSArray *arr = value;
+    NSString *itemType = nil;
+    for (id item in arr) {
+      NSString *t = [self typeName:item];
+      if (itemType == nil) {
+        itemType = t;
+      } else if (![itemType isEqualToString:t]) {
+        itemType = @"value";
+        break;
+      }
+    }
+    return [NSString stringWithFormat:@"array<%@, %lu>", itemType ?: @"value", (unsigned long)arr.count];
+  }
+  if (isObjectV(value)) return @"object";
+  return @"null";
+}
+
++ (void)warnOnce:(NSString *)key message:(NSString *)message {
+  if (!key) return;
+  static NSMutableSet *warned;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    warned = [NSMutableSet set];
+  });
+  @synchronized(warned) {
+    if ([warned containsObject:key]) return;
+    [warned addObject:key];
+  }
+  NSLog(@"[VectorStyle] %@: %@", key, message);
+}
+
+@end
