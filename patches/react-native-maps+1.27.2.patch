+
+/// JS の Number(str) 相当（色のパーサが受け付ける "[\de.+-]+" の範囲）。数値にならなければ NAN
+static double parseCssNumber(NSString *s) {
+  if (s.length == 0) return NAN;
+  NSScanner *scanner = [NSScanner scannerWithString:s];
+  scanner.locale = [NSLocale localeWithLocaleIdentifier:@"en_US_POSIX"];
+  double value = 0;
+  if (![scanner scanDouble:&value]) return NAN;
+  if (!scanner.isAtEnd) return NAN;
+  return value;
+}
+
+static double parseAlpha(double a, BOOL asPercentage) {
+  return clampDouble(asPercentage ? a / 100.0 : a, 0, 1);
+}
+
+static NSString *groupOrNil(NSTextCheckingResult *m, NSString *input, NSUInteger idx) {
+  NSRange r = [m rangeAtIndex:idx];
+  if (r.location == NSNotFound) return nil;
+  return [input substringWithRange:r];
+}
+
+/// 区切り文字の組み合わせ（"  ", "  /", ",,", ",,,"）だけを許す
+static BOOL validArgFormat(NSString *f1, NSString *f2, NSString *f3) {
+  NSString *argFormat = [NSString stringWithFormat:@"%@%@%@", f1 ?: @" ", f2 ?: @" ", f3 ?: @""];
+  return [argFormat isEqualToString:@"  "] || [argFormat isEqualToString:@"  /"] ||
+         [argFormat isEqualToString:@",,"] || [argFormat isEqualToString:@",,,"];
+}
+
++ (nullable CssColor *)parse:(NSString *)rawInput {
+  if (![rawInput isKindOfClass:[NSString class]]) return nil;
+  NSString *input = [[rawInput lowercaseString]
+      stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+
+  if ([input isEqualToString:@"transparent"]) {
+    return [CssColor colorWithR:0 g:0 b:0 a:0];
+  }
+
+  NSArray<NSNumber *> *named = namedColors()[input];
+  if (named) {
+    return [CssColor colorWithR:named[0].doubleValue g:named[1].doubleValue b:named[2].doubleValue a:1];
+  }
+
+  if ([input hasPrefix:@"#"]) {
+    static NSRegularExpression *hexRe;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+      hexRe = [NSRegularExpression regularExpressionWithPattern:@"^#(?:[0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$"
+                                                        options:0
+                                                          error:nil];
+    });
+    if ([hexRe firstMatchInString:input options:0 range:NSMakeRange(0, input.length)] == nil) return nil;
+    NSUInteger step = input.length < 6 ? 1 : 2;
+    NSUInteger i = 1;
+    double comps[4] = {0, 0, 0, 255};
+    for (int k = 0; k < 4; k++) {
+      if (i + step > input.length) break; // alpha 省略 → 255
+      NSString *hex = [input substringWithRange:NSMakeRange(i, step)];
+      i += step;
+      if (step == 1) hex = [hex stringByAppendingString:hex]; // "f" → "ff"
+      unsigned int v = 0;
+      [[NSScanner scannerWithString:hex] scanHexInt:&v];
+      comps[k] = v;
+    }
+    return [CssColor colorWithR:comps[0] g:comps[1] b:comps[2] a:comps[3] / 255.0];
+  }
+
+  if ([input hasPrefix:@"rgb"]) {
+    static NSRegularExpression *rgbRe;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+      rgbRe = [NSRegularExpression
+          regularExpressionWithPattern:@"^rgba?\\(\\s*([\\de.+-]+)(%)?(?:\\s+|\\s*(,)\\s*)([\\de.+-]+)(%)?(?:\\s+|\\s*(,)\\s*)([\\de.+-]+)(%)?(?:\\s*([,/])\\s*([\\de.+-]+)(%)?)?\\s*\\)$"
+                               options:0
+                                 error:nil];
+    });
+    NSTextCheckingResult *m = [rgbRe firstMatchInString:input options:0 range:NSMakeRange(0, input.length)];
+    if (!m) return nil;
+    NSString *r = groupOrNil(m, input, 1), *rp = groupOrNil(m, input, 2), *f1 = groupOrNil(m, input, 3);
+    NSString *g = groupOrNil(m, input, 4), *gp = groupOrNil(m, input, 5), *f2 = groupOrNil(m, input, 6);
+    NSString *b = groupOrNil(m, input, 7), *bp = groupOrNil(m, input, 8), *f3 = groupOrNil(m, input, 9);
+    NSString *a = groupOrNil(m, input, 10), *ap = groupOrNil(m, input, 11);
+    if (!validArgFormat(f1, f2, f3)) return nil;
+    NSString *valFormat = [NSString stringWithFormat:@"%@%@%@", rp ?: @"", gp ?: @"", bp ?: @""];
+    double maxValue = [valFormat isEqualToString:@"%%%"] ? 100 : valFormat.length == 0 ? 255 : 0;
+    if (maxValue == 0) return nil;
+    double rv = parseCssNumber(r), gv = parseCssNumber(g), bv = parseCssNumber(b);
+    double av = a ? parseCssNumber(a) : 1;
+    if (isnan(rv) || isnan(gv) || isnan(bv) || isnan(av)) return nil;
+    return [CssColor colorWithR:clampDouble(rv / maxValue, 0, 1) * 255
+                              g:clampDouble(gv / maxValue, 0, 1) * 255
+                              b:clampDouble(bv / maxValue, 0, 1) * 255
+                              a:a ? parseAlpha(av, ap != nil) : 1];
+  }
+
+  {
+    static NSRegularExpression *hslRe;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+      hslRe = [NSRegularExpression
+          regularExpressionWithPattern:@"^hsla?\\(\\s*([\\de.+-]+)(?:deg)?(?:\\s+|\\s*(,)\\s*)([\\de.+-]+)%(?:\\s+|\\s*(,)\\s*)([\\de.+-]+)%(?:\\s*([,/])\\s*([\\de.+-]+)(%)?)?\\s*\\)$"
+                               options:0
+                                 error:nil];
+    });
+    NSTextCheckingResult *m = [hslRe firstMatchInString:input options:0 range:NSMakeRange(0, input.length)];
+    if (!m) return nil;
+    NSString *h = groupOrNil(m, input, 1), *f1 = groupOrNil(m, input, 2);
+    NSString *s = groupOrNil(m, input, 3), *f2 = groupOrNil(m, input, 4);
+    NSString *l = groupOrNil(m, input, 5), *f3 = groupOrNil(m, input, 6);
+    NSString *a = groupOrNil(m, input, 7), *ap = groupOrNil(m, input, 8);
+    if (!validArgFormat(f1, f2, f3)) return nil;
+    double hv = parseCssNumber(h), sv = parseCssNumber(s), lv = parseCssNumber(l);
+    double av = a ? parseCssNumber(a) : 1;
+    if (isnan(hv) || isnan(sv) || isnan(lv) || isnan(av)) return nil;
+    double hue = constrainAngle(hv);
+    double sat = clampDouble(sv, 0, 100) / 100.0;
+    double light = clampDouble(lv, 0, 100) / 100.0;
+    double (^f)(double) = ^double(double n) {
+      double k = fmod(n + hue / 30.0, 12.0);
+      double amp = sat * MIN(light, 1 - light);
+      return light - amp * MAX(-1.0, MIN(MIN(k - 3, 9 - k), 1.0));
+    };
+    return [CssColor colorWithR:f(0) * 255 g:f(8) * 255 b:f(4) * 255 a:a ? parseAlpha(av, ap != nil) : 1];
+  }
+}
+
+- (NSString *)cssString {
+  return [NSString stringWithFormat:@"rgba(%ld,%ld,%ld,%@)", (long)llround(self.r), (long)llround(self.g),
+                                    (long)llround(self.b), [StyleExpression jsNumberToString:self.a]];
+}
+
+- (BOOL)isEqualToColor:(CssColor *)other {
+  if (![other isKindOfClass:[CssColor class]]) return NO;
+  return self.r == other.r && self.g == other.g && self.b == other.b && self.a == other.a;
+}
+
+- (BOOL)isEqual:(id)object {
+  return [self isEqualToColor:object];
+}
+
+- (NSUInteger)hash {
+  return [[self cssString] hash];
+}
+
+- (NSString *)description {
+  return [self cssString];
+}
+
+@end
