+/// 1 地物ぶんの評価コンテキスト
+static EvalContext *makeEvalContext(FeatureData *feature, double zoom) {
+  return [[EvalContext alloc] initWithProperties:feature.attributes ?: @{}
+                                    geometryType:feature.geometryType ?: @""
+                                       featureId:feature.featureId
+                                            zoom:zoom];
