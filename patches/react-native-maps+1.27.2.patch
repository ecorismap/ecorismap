+static inline BOOL isNullV(id v) { return v == nil || v == [NSNull null]; }
+static inline BOOL isBoolV(id v) {
+  return [v isKindOfClass:[NSNumber class]] && CFGetTypeID((__bridge CFTypeRef)v) == CFBooleanGetTypeID();
+}
+static inline BOOL isNumberV(id v) { return [v isKindOfClass:[NSNumber class]] && !isBoolV(v); }
+static inline BOOL isStringV(id v) { return [v isKindOfClass:[NSString class]]; }
+static inline BOOL isArrayV(id v) { return [v isKindOfClass:[NSArray class]]; }
+static inline BOOL isObjectV(id v) { return [v isKindOfClass:[NSDictionary class]]; }
+static inline BOOL isColorV(id v) { return [v isKindOfClass:[CssColor class]]; }
+static inline BOOL isErrorV(id v) { return v == kErrorValue; }
+static inline double numV(id v) { return [(NSNumber *)v doubleValue]; }
+static inline BOOL boolV(id v) { return [(NSNumber *)v boolValue]; }
