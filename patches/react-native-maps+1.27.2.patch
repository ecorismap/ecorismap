+package VectorTileStyle;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * スタイル式を1つの地物に対して評価するときの文脈。
+ * 地物ごとに1つ作り、そのレイヤの全プロパティ評価で使い回す。
+ * iOS 版（VectorTile/EvalContext.h）と 1:1 で対応する。
+ */
+public final class EvalContext {
+  /** 地物の属性（MVT のタグ。値は String / Number / Boolean / null） */
+  public final Map<String, Object> properties;
+  /** "Point" | "LineString" | "Polygon"（Multi* は区別しない） */
+  public final String geometryType;
+  /** MVT の id。無ければ null（["id"] と legacy "$id" は null になる） */
+  public final Object featureId;
+  /** 描画しているタイルの z（["zoom"] に使う） */
+  public final double zoom;
+  /** ["let", ...] の束縛。通常は null */
+  Map<String, Object> bindings;
+
+  public EvalContext(Map<String, Object> properties, String geometryType, Object featureId, double zoom) {
+    this.properties = properties != null ? properties : Collections.<String, Object>emptyMap();
+    this.geometryType = geometryType != null ? geometryType : "";
+    this.featureId = featureId;
+    this.zoom = zoom;
+    this.bindings = null;
+  }
+
+  /** let 用: 束縛を足した子コンテキスト */
+  public EvalContext withBindings(Map<String, Object> newBindings) {
+    EvalContext child = new EvalContext(properties, geometryType, featureId, zoom);
+    Map<String, Object> merged = new HashMap<>();
+    if (bindings != null) merged.putAll(bindings);
+    merged.putAll(newBindings);
+    child.bindings = merged;
+    return child;
+  }
+}
