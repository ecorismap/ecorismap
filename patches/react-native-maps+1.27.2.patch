+/// JS の真偽値変換（to-boolean, coalesce 以外では使わない）
+static BOOL jsTruthy(id v) {
+  if (isNullV(v)) return NO;
+  if (isBoolV(v)) return boolV(v);
+  if (isNumberV(v)) {
+    double d = numV(v);
+    return d != 0 && !isnan(d);
+  }
+  if (isStringV(v)) return [(NSString *)v length] > 0;
+  return YES; // array / object / color
