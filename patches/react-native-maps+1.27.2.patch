diff --git a/node_modules/react-native-maps/ios/AirGoogleMaps/AIRGoogleMapUrlTileOverlay.m b/node_modules/react-native-maps/ios/AirGoogleMaps/AIRGoogleMapUrlTileOverlay.m
new file mode 100644
index 0000000..efe95d4
--- /dev/null
+++ b/node_modules/react-native-maps/ios/AirGoogleMaps/AIRGoogleMapUrlTileOverlay.m
@@ -0,0 +1,493 @@
+//
+//  AIRGoogleMapURLTile.m
+//  Created by Nick Italiano on 11/5/16.
+//
+
+#ifdef HAVE_GOOGLE_MAPS
+
+#import "AIRGoogleMapUrlTileOverlay.h"
+@implementation AIRGoogleMapUrlTileOverlay
+- (id)init {
+  self = [super init];
+  return self;
+}
+
+- (UIImage *)tileForX:(NSUInteger)x y:(NSUInteger)y zoom:(NSUInteger)zoom {
+
+  // NSLog(@"RNM: tileSize %ld", self.tileSize);
+
+  if (zoom > self.maximumZ) {
+    return kGMSTileLayerNoTile;
+  }
+  if (self.maximumNativeZ == 0) {
+    // このあとNSUIntegerの比較があるため-1をすると予期せぬ挙動をするので0の場合はここでreturnする
+    return kGMSTileLayerNoTile;
+  }
+
+  int drawType = 0; // 0:original 1:high-resolution 2:overzoom
+  // 一時的な失敗（タイムアウト・ネットワークエラー・5xx）かどうか。
+  // kGMSTileLayerNoTileを返すとSDKが「タイルなし」として確定キャッシュし
+  // 再リクエストされないため、一時的な失敗はnilを返して再試行させる。
+  BOOL transient = NO;
+  NSData *data;
+  if (zoom < self.minimumZ) {
+    // minimumZより小さいズームレベルは一つ上のズームレベルのタイルから生成する
+    // 現時点ではPDFの読み込み用。
+    drawType = 1;
+    data = [self drawFromHigherZoomTile:zoom x:x y:y transient:&transient];
+  } else if (zoom > self.maximumNativeZ && !self.doubleTileSize) {
+    drawType = 2;
+    data = [self drawOverZoomTile:zoom
+                                x:x
+                                y:y
+                             minZ:self.maximumNativeZ
+                        transient:&transient];
+  } else if (zoom > self.maximumNativeZ - 1 && self.doubleTileSize) {
+    drawType = 2;
+    data = [self drawOverZoomTile:zoom
+                                x:x
+                                y:y
+                             minZ:self.maximumNativeZ - 1
+                        transient:&transient];
+  } else if (zoom <= self.maximumZ && !self.doubleTileSize) {
+    drawType = 0;
+    data = [self getTile:zoom x:x y:y transient:&transient];
+  } else if (zoom <= self.maximumZ - 1 && self.doubleTileSize) {
+    // iOSの場合、doubleTileSizeがtrueの場合、tileSizeを小さくセットすることによって、
+    // 一つ上のズームレベルのタイルを取得するという仕様になっている。
+    // そのため、drawTypeは1でなく0でOK。
+    drawType = 0;
+    data = [self getTile:zoom x:x y:y transient:&transient];
+  }
+  // NSLog(@"drawType %d,%ld,%ld,%ld", drawType, zoom, self.maximumNativeZ,
+  //       self.minimumZ);
+
+  // オフライン時、またはネット取得が一時的に失敗（タイムアウト・接続エラー・5xx）した
+  // ときは、キャッシュ済みの低ズームタイルを拡大して代替表示する。
+  // 404等の確定失敗では発動させない（電波良好時の挙動を変えないため）。
+  // 探索はキャッシュ読みのみ（cacheOnly:YES）で行い、タイムアウト待ちの連鎖を防ぐ。
+  if (!data && self.tileCachePath && (self.offlineMode || transient) &&
+      (drawType == 0 || drawType == 2)) {
+    NSInteger zoomLevelToStart = ((NSInteger)zoom > self.maximumNativeZ)
+                                     ? self.maximumNativeZ - 1
+                                     : (NSInteger)zoom - 1;
+    NSInteger minimumZoomToSearch = MAX(self.minimumZ, zoomLevelToStart - 3);
+    for (NSInteger tryZoom = zoomLevelToStart; tryZoom >= minimumZoomToSearch;
+         tryZoom--) {
+      data = [self drawOverZoomTile:zoom
+                                  x:x
+                                  y:y
+                               minZ:tryZoom
+                          transient:NULL
+                          cacheOnly:YES];
+      if (data) {
+        break;
+      }
+    }
+  }
+
+  if (data) {
+    UIImage *img = [[UIImage alloc] initWithData:data];
+    if (img) {
+      return img;
+    }
+  }
+  // nilを返すとSDKがあとで再リクエストする。NoTileは確定（404・範囲外・オフライン未保存）のみ。
+  return transient ? nil : kGMSTileLayerNoTile;
+}
+
+// PNG/JPEG/GIF/WebPのマジックバイトで画像かどうかを簡易判定する。
+// HTTPステータスを確認しない旧実装が404のHTML本文などをキャッシュしている
+// 可能性があるため、キャッシュ読み込み時の検証にも使う。
+- (BOOL)isLikelyImageData:(NSData *)data {
+  if (data.length < 12) {
+    return NO;
+  }
+  const unsigned char *bytes = data.bytes;
+  if (bytes[0] == 0x89 && bytes[1] == 'P' && bytes[2] == 'N' && bytes[3] == 'G') {
+    return YES; // PNG
+  }
+  if (bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF) {
+    return YES; // JPEG
+  }
+  if (bytes[0] == 'G' && bytes[1] == 'I' && bytes[2] == 'F') {
+    return YES; // GIF
+  }
+  if (bytes[0] == 'R' && bytes[1] == 'I' && bytes[2] == 'F' && bytes[3] == 'F' &&
+      bytes[8] == 'W' && bytes[9] == 'E' && bytes[10] == 'B' && bytes[11] == 'P') {
+    return YES; // WebP
+  }
+  return NO;
+}
+
+- (void)deleteTileImage:(NSUInteger)zoom x:(NSUInteger)x y:(NSUInteger)y {
+  NSURL *tileCacheFilePath = [NSURL
+      URLWithString:[NSString stringWithFormat:@"%@/%ld/%ld/%ld",
+                                               self.tileCachePath, (long)zoom,
+                                               (long)x, (long)y]];
+  [[NSFileManager defaultManager] removeItemAtPath:[tileCacheFilePath path]
+                                             error:nil];
+}
+
+- (NSData *)getTile:(NSUInteger)zoom
+                  x:(NSUInteger)x
+                  y:(NSUInteger)y
+          transient:(BOOL *)transient {
+  return [self getTile:zoom x:x y:y transient:transient cacheOnly:NO];
+}
+
+// cacheOnly=YESのときはディスクキャッシュのみ参照しネット取得しない
+// （フォールバック探索で低ズームごとにタイムアウト待ちが連鎖するのを防ぐ）
+- (NSData *)getTile:(NSUInteger)zoom
+                  x:(NSUInteger)x
+                  y:(NSUInteger)y
+          transient:(BOOL *)transient
+          cacheOnly:(BOOL)cacheOnly {
+
+  if (self.flipY == YES) {
+    y = (1 << zoom) - y - 1;
+  }
+
+  NSData *data;
+  data = [self readTileImage:(NSUInteger)zoom x:(NSUInteger)x y:(NSUInteger)y];
+  if (data && ![self isLikelyImageData:data]) {
+    // 旧実装が書き込んだ画像でないキャッシュ（404本文など）は削除して取り直す
+    [self deleteTileImage:zoom x:x y:y];
+    data = nil;
+  }
+  if (data == nil && !cacheOnly && !self.offlineMode && self.tileCachePath) {
+    data = [self fetchTile:(NSUInteger)zoom
+                         x:(NSUInteger)x
+                         y:(NSUInteger)y
+                 transient:transient];
+    if (data && ![self isLikelyImageData:data]) {
+      // 画像でないレスポンスはキャッシュせず破棄
+      data = nil;
+    }
+    if (data) {
+      [self writeTileImage:(NSUInteger)zoom
+                         x:(NSUInteger)x
+                         y:(NSUInteger)y
+              withTileData:data];
+    }
+  }
+  return data;
+}
+
+- (NSData *)readTileImage:(NSUInteger)zoom x:(NSUInteger)x y:(NSUInteger)y {
+  NSError *error = nil;
+
+  NSURL *tileCacheFilePath = [NSURL
+      URLWithString:[NSString stringWithFormat:@"%@/%ld/%ld/%ld",
+                                               self.tileCachePath, (long)zoom,
+                                               (long)x, (long)y]];
+
+  // NSLog(@"read tile %@", tileCacheFilePath);
+  NSData *data = [NSData dataWithContentsOfURL:tileCacheFilePath
+                                       options:NSDataReadingUncached
+                                         error:&error];
+  if (error) {
+    // NSLog(@"%@", [error localizedDescription]);
+    return nil;
+  } else {
+    return data;
+  }
+}
+
+- (NSURL *)generateURLwithTemplate:(NSString *)template
+                                 x:(NSUInteger)x
+                                 y:(NSUInteger)y
+                                 z:(NSUInteger)z {
+  NSString *url = template;
+  //{x} {y} {z}が含まれていない場合はnilを返す
+  if (![url containsString:@"{x}"] || ![url containsString:@"{y}"] ||
+      ![url containsString:@"{z}"]) {
+    return nil;
+  }
+  url = [url
+      stringByReplacingOccurrencesOfString:@"{x}"
+                                withString:[NSString stringWithFormat:@"%ld",
+                                                                      (long)x]];
+  url = [url
+      stringByReplacingOccurrencesOfString:@"{y}"
+                                withString:[NSString stringWithFormat:@"%ld",
+                                                                      (long)y]];
+  url = [url
+      stringByReplacingOccurrencesOfString:@"{z}"
+                                withString:[NSString stringWithFormat:@"%ld",
+                                                                      (long)z]];
+  return [NSURL URLWithString:url];
+}
+
+- (NSData *)fetchTile:(NSUInteger)zoom
+                    x:(NSUInteger)x
+                    y:(NSUInteger)y
+            transient:(BOOL *)transient {
+  __block NSData *data = nil;
+  __block NSError *error = nil;
+  __block NSInteger statusCode = 0;
+
+  NSURL *url = [self generateURLwithTemplate:self.tileTemplate x:x y:y z:zoom];
+  if (!url) {
+    return nil;
+  }
+
+  static const NSTimeInterval kFetchTimeout = 5;
+
+  // セッションは毎回生成すると接続リソースを浪費するため共有する
+  static NSURLSession *session = nil;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    NSURLSessionConfiguration *config =
+        [NSURLSessionConfiguration defaultSessionConfiguration];
+    config.timeoutIntervalForRequest = kFetchTimeout;
+    session = [NSURLSession sessionWithConfiguration:config];
+  });
+
+  // セマフォを作成して非同期処理を待機
+  dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+
+  NSURLSessionDataTask *task =
+      [session dataTaskWithURL:url
+             completionHandler:^(NSData *_Nullable receivedData,
+                                 NSURLResponse *_Nullable response,
+                                 NSError *_Nullable receivedError) {
+               data = receivedData;
+               error = receivedError;
+               if ([response isKindOfClass:[NSHTTPURLResponse class]]) {
+                 statusCode = ((NSHTTPURLResponse *)response).statusCode;
+               }
+               // 非同期処理が完了したことをセマフォに通知
+               dispatch_semaphore_signal(semaphore);
+             }];
+
+  [task resume];
+
+  // リクエストのタイムアウトより少し長く待つ（URLSession側のタイムアウトを先に効かせる）
+  dispatch_time_t timeout = dispatch_time(
+      DISPATCH_TIME_NOW, (int64_t)((kFetchTimeout + 1) * NSEC_PER_SEC));
+  long waitResult = dispatch_semaphore_wait(semaphore, timeout);
+
+  if (waitResult != 0) {
+    // タイムアウトが発生した場合は一時的な失敗として再試行させる
+    [task cancel];
+    if (transient) {
+      *transient = YES;
+    }
+    return nil;
+  }
+
+  if (error) {
+    // ネットワークエラーは一時的な失敗として再試行させる
+    if (transient) {
+      *transient = YES;
+    }
+    return nil;
+  }
+  if (statusCode >= 200 && statusCode < 300 && data.length > 0) {
+    return data;
+  }
+  if (statusCode >= 400 && statusCode < 500) {
+    // タイルが存在しない（404など）は確定失敗
+    return nil;
+  }
+  // 5xxや想定外のレスポンスは一時的な失敗として再試行させる
+  if (transient) {
+    *transient = YES;
+  }
+  return nil;
+}
+
+- (void)writeTileImage:(NSUInteger)zoom
+                     x:(NSUInteger)x
+                     y:(NSUInteger)y
+          withTileData:(NSData *)data {
+  NSError *error;
+
+  NSURL *tileCacheFileDirectory =
+      [NSURL URLWithString:[NSString stringWithFormat:@"%@/%ld/%ld/",
+                                                      self.tileCachePath,
+                                                      (long)zoom, (long)x]];
+
+  NSURL *tileCacheFilePath = [NSURL
+      URLWithString:[NSString stringWithFormat:@"%@/%ld/%ld/%ld",
+                                               self.tileCachePath, (long)zoom,
+                                               (long)x, (long)y]];
+
+  if (![[NSFileManager defaultManager]
+          fileExistsAtPath:[tileCacheFileDirectory path]]) {
+    [[NSFileManager defaultManager]
+              createDirectoryAtPath:[tileCacheFileDirectory path]
+        withIntermediateDirectories:YES
+                         attributes:nil
+                              error:&error];
+    if (error) {
+      // NSLog(@"Error: %@", error);
+      return;
+    }
+  }
+
+  [[NSFileManager defaultManager] createFileAtPath:[tileCacheFilePath path]
+                                          contents:data
+                                        attributes:nil];
+  // NSLog(@"write tile %@", [tileCacheFilePath path]);
+}
+
+- (NSData *)drawOverZoomTile:(NSUInteger)tryZ
+                           x:(NSUInteger)x
+                           y:(NSUInteger)y
+                        minZ:(NSInteger)minZ
+                   transient:(BOOL *)transient {
+  return [self drawOverZoomTile:tryZ x:x y:y minZ:minZ transient:transient cacheOnly:NO];
+}
+
+- (NSData *)drawOverZoomTile:(NSUInteger)tryZ
+                           x:(NSUInteger)x
+                           y:(NSUInteger)y
+                        minZ:(NSInteger)minZ
+                   transient:(BOOL *)transient
+                   cacheOnly:(BOOL)cacheOnly {
+
+  int overZoomLevel = tryZ - minZ;
+  int zoomFactor = 1 << overZoomLevel;
+  int xParent = x >> overZoomLevel;
+  int yParent = y >> overZoomLevel;
+  int zoomParent = tryZ - overZoomLevel;
+  int xOffset = x % zoomFactor;
+  int yOffset = y % zoomFactor;
+  // NSLog(@"RNM:overZoom %ld,%ld", tryZ, minZ);
+  // if (overZoomLevel > 5) {
+  //   return nil;
+  // }
+  NSData *data = [self getTile:zoomParent
+                             x:xParent
+                             y:yParent
+                     transient:transient
+                     cacheOnly:cacheOnly];
+  if (!data) {
+    return nil;
+  }
+  UIImage *image = [UIImage imageWithData:data];
+  if (!image) {
+    NSLog(@"Error: Failed to create the image from the data.");
+    return nil;
+  }
+  CGRect originalRect = CGRectMake(0, 0, image.size.width, image.size.height);
+
+  int subTileSizeX = image.size.width / zoomFactor;
+  int subTileSizeY = image.size.height / zoomFactor;
+  UIGraphicsBeginImageContextWithOptions(originalRect.size, NO, 0.0);
+  {
+    CGRect drawRect = CGRectApplyAffineTransform(
+        originalRect, CGAffineTransformMakeScale(zoomFactor, zoomFactor));
+    drawRect = CGRectApplyAffineTransform(
+        drawRect,
+        CGAffineTransformMakeTranslation(-image.size.width * xOffset,
+                                         -image.size.height * yOffset));
+
+    [image drawInRect:drawRect];
+    image = UIGraphicsGetImageFromCurrentImageContext();
+    if (!image) {
+      NSLog(@"Error: Failed to draw the image in the context.");
+      UIGraphicsEndImageContext();
+      return nil;
+    }
+  }
+  UIGraphicsEndImageContext();
+
+  NSData *imageData = UIImagePNGRepresentation(image);
+  if (!imageData) {
+    NSLog(@"Error: Could not convert the image to PNG format.");
+    return nil;
+  }
+
+  return imageData;
+}
+
+- (NSData *)drawFromHigherZoomTile:(NSUInteger)zoom
+                                 x:(NSUInteger)x
+                                 y:(NSUInteger)y
+                         transient:(BOOL *)transient {
+  // NSLog(@"RNM:fromHigher %ld,%ld,%ld", zoom, x, y);
+  NSUInteger X = x * 2;
+  NSUInteger Y = y * 2;
+  BOOL anyTransient = NO;
+  NSData *leftTop = [self getTile:zoom + 1 x:X y:Y transient:&anyTransient];
+  NSData *leftBottom = [self getTile:zoom + 1 x:X y:Y + 1 transient:&anyTransient];
+  NSData *rightTop = [self getTile:zoom + 1 x:X + 1 y:Y transient:&anyTransient];
+  NSData *rightBottom = [self getTile:zoom + 1
+                                    x:X + 1
+                                    y:Y + 1
+                            transient:&anyTransient];
+  if (anyTransient && transient) {
+    *transient = YES;
+  }
+
+  // 画像があるものからsizeを取得
+  NSInteger width;
+  NSInteger height;
+  if (leftTop) {
+    width = [UIImage imageWithData:leftTop].size.width;
+    height = [UIImage imageWithData:leftTop].size.height;
+  } else if (leftBottom) {
+    width = [UIImage imageWithData:leftBottom].size.width;
+    height = [UIImage imageWithData:leftBottom].size.height;
+  } else if (rightTop) {
+    width = [UIImage imageWithData:rightTop].size.width;
+    height = [UIImage imageWithData:rightTop].size.height;
+  } else if (rightBottom) {
+    width = [UIImage imageWithData:rightBottom].size.width;
+    height = [UIImage imageWithData:rightBottom].size.height;
+  } else {
+    // NSLog(@"RNM:No image");
+    return nil;
+  }
+  CGSize tileSize = CGSizeMake(width / 2, height / 2);
+  // NSLog(@"RNM: width %ld", width);
+  UIGraphicsBeginImageContextWithOptions(CGSizeMake(width, height), NO, 1);
+  CGContextRef context = UIGraphicsGetCurrentContext();
+
+  if (leftTop) {
+    UIImage *image = [UIImage imageWithData:leftTop];
+    if (image) {
+      [image drawInRect:CGRectMake(0, 0, tileSize.width, tileSize.height)];
+    }
+  }
+  if (leftBottom) {
+    UIImage *image = [UIImage imageWithData:leftBottom];
+    if (image) {
+      [image drawInRect:CGRectMake(0, tileSize.height, tileSize.width,
+                                   tileSize.height)];
+    }
+  }
+  if (rightTop) {
+    UIImage *image = [UIImage imageWithData:rightTop];
+    if (image) {
+      [image drawInRect:CGRectMake(tileSize.width, 0, tileSize.width,
+                                   tileSize.height)];
+    }
+  }
+  if (rightBottom) {
+    UIImage *image = [UIImage imageWithData:rightBottom];
+    if (image) {
+      [image drawInRect:CGRectMake(tileSize.width, tileSize.height,
+                                   tileSize.width, tileSize.height)];
+    }
+  }
+  UIImage *combinedImage = UIGraphicsGetImageFromCurrentImageContext();
+  UIGraphicsEndImageContext();
+
+  NSData *data = UIImagePNGRepresentation(combinedImage);
+  // キャッシュに保存（一時的な取得失敗で欠けたタイルを含む場合は保存しない）
+  if (self.tileCachePath && !anyTransient) {
+    [self writeTileImage:(NSUInteger)zoom
+                       x:(NSUInteger)x
+                       y:(NSUInteger)y
+            withTileData:data];
+  }
+  return data;
+}
+
+@end
+
+#endif
