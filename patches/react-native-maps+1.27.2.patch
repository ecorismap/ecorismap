+//
+//  EvalContext.h
+//
+//  スタイル式を1つの地物に対して評価するときの文脈。
+//  地物ごとに1つ作り、そのレイヤの全プロパティ評価で使い回す。
+//
+
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface EvalContext : NSObject
+
+/// 地物の属性（MVT のタグ。値は NSString / NSNumber（数値または真偽） / NSNull）
+@property(nonatomic, strong) NSDictionary<NSString *, id> *properties;
+/// "Point" | "LineString" | "Polygon"（Multi* は区別しない）
+@property(nonatomic, copy) NSString *geometryType;
+/// MVT の id。無ければ nil（["id"] と legacy "$id" は null になる）
+@property(nonatomic, strong, nullable) id featureId;
+/// 描画しているタイルの z（["zoom"] に使う）
+@property(nonatomic, assign) double zoom;
+/// ["let", ...] の束縛。通常は空
+@property(nonatomic, strong, nullable) NSDictionary<NSString *, id> *bindings;
+
+- (instancetype)initWithProperties:(NSDictionary<NSString *, id> *)properties
+                      geometryType:(NSString *)geometryType
+                         featureId:(nullable id)featureId
+                              zoom:(double)zoom;
+
+/// let 用: 束縛を足した子コンテキスト
+- (EvalContext *)contextByAddingBindings:(NSDictionary<NSString *, id> *)bindings;
+
+@end
+
+NS_ASSUME_NONNULL_END
