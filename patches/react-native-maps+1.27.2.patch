+//
+//  EvalContext.m
+//
+
+#import "EvalContext.h"
+
+@implementation EvalContext
+
+- (instancetype)initWithProperties:(NSDictionary<NSString *, id> *)properties
+                      geometryType:(NSString *)geometryType
+                         featureId:(id)featureId
+                              zoom:(double)zoom {
+  self = [super init];
+  if (self) {
+    _properties = properties ?: @{};
+    _geometryType = geometryType ?: @"";
+    _featureId = featureId;
+    _zoom = zoom;
+    _bindings = nil;
+  }
+  return self;
+}
+
+- (EvalContext *)contextByAddingBindings:(NSDictionary<NSString *, id> *)bindings {
+  EvalContext *child = [[EvalContext alloc] initWithProperties:self.properties
+                                                  geometryType:self.geometryType
+                                                     featureId:self.featureId
+                                                          zoom:self.zoom];
+  NSMutableDictionary *merged = [NSMutableDictionary dictionaryWithDictionary:self.bindings ?: @{}];
+  [merged addEntriesFromDictionary:bindings];
+  child.bindings = merged;
+  return child;
+}
+
+@end
