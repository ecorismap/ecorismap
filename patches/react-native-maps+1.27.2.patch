+/** 段彩色を区分線形補間で求める（0-255のdouble、丸めは呼び出し側で一度だけ行う） */
+static void ReliefColor(double elev, const double (*ramp)[4], NSInteger rampCount, double *out) {
+    if (elev <= ramp[0][0]) {
+        out[0] = ramp[0][1]; out[1] = ramp[0][2]; out[2] = ramp[0][3];
+        return;
+    }
+    const double *last = ramp[rampCount - 1];
+    if (elev >= last[0]) {
+        out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+        return;
+    }
+    for (NSInteger i = 1; i < rampCount; i++) {
+        if (elev <= ramp[i][0]) {
+            const double *lo = ramp[i - 1];
+            const double *hi = ramp[i];
+            double t = (elev - lo[0]) / (hi[0] - lo[0]);
+            out[0] = lo[1] + (hi[1] - lo[1]) * t;
+            out[1] = lo[2] + (hi[2] - lo[2]) * t;
+            out[2] = lo[3] + (hi[3] - lo[3]) * t;
+            return;
+        }
+    }
+    out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
