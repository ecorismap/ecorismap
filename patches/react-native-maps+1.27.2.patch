+        NSInteger tx = targets[i][0];
+        NSInteger ty = targets[i][1];
+        NSInteger tileSize = 0;
+        NSData *tile = [self elevationForX:(NSUInteger)targets[i][2] y:(NSUInteger)targets[i][3] zoom:zoom size:&tileSize];
