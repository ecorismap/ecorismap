+  private enum StyleOp {
+    Unknown,
+    Literal, Get, Has, Properties, GeometryType, Id, Zoom, FeatureState,
+    Match, Case, Coalesce, Let, Var,
+    Eq, Neq, Lt, Lte, Gt, Gte, Not, All, Any,
+    In, IndexOf, Slice, Length, At,
+    Upcase, Downcase, Concat, Format, NumberFormat,
+    ToString, ToNumber, ToBoolean, ToColor, ToRgba, Rgb, Rgba, Typeof,
+    AssertString, AssertNumber, AssertBoolean, AssertArray, AssertObject,
+    Add, Sub, Mul, Div, Mod, Pow, Abs, Round, Floor, Ceil, Min, Max,
+    Sqrt, Ln, Log10, Log2, Sin, Cos, Tan, Asin, Acos, Atan, Pi, E, Ln2,
+    Step, Interpolate,
+    // legacy filter の内部演算子（normalizeFilter が生成する）
+    FilterEq, FilterIdEq, FilterTypeEq, FilterLt, FilterIdLt, FilterGt, FilterIdGt,
+    FilterLte, FilterIdLte, FilterGte, FilterIdGte, FilterHas, FilterHasId,
+    FilterTypeIn, FilterIdIn, FilterInSmall,
+  }
+
+  private static final Map<String, StyleOp> OP_TABLE = new HashMap<>();
+
+  static {
+    Object[][] table = {
+      {"literal", StyleOp.Literal}, {"get", StyleOp.Get}, {"has", StyleOp.Has}, {"properties", StyleOp.Properties},
+      {"geometry-type", StyleOp.GeometryType}, {"id", StyleOp.Id}, {"zoom", StyleOp.Zoom}, {"feature-state", StyleOp.FeatureState},
+      {"match", StyleOp.Match}, {"case", StyleOp.Case}, {"coalesce", StyleOp.Coalesce}, {"let", StyleOp.Let}, {"var", StyleOp.Var},
+      {"==", StyleOp.Eq}, {"!=", StyleOp.Neq}, {"<", StyleOp.Lt}, {"<=", StyleOp.Lte}, {">", StyleOp.Gt}, {">=", StyleOp.Gte},
+      {"!", StyleOp.Not}, {"all", StyleOp.All}, {"any", StyleOp.Any},
+      {"in", StyleOp.In}, {"index-of", StyleOp.IndexOf}, {"slice", StyleOp.Slice}, {"length", StyleOp.Length}, {"at", StyleOp.At},
+      {"upcase", StyleOp.Upcase}, {"downcase", StyleOp.Downcase}, {"concat", StyleOp.Concat}, {"format", StyleOp.Format},
+      {"number-format", StyleOp.NumberFormat},
+      {"to-string", StyleOp.ToString}, {"to-number", StyleOp.ToNumber}, {"to-boolean", StyleOp.ToBoolean},
+      {"to-color", StyleOp.ToColor}, {"to-rgba", StyleOp.ToRgba}, {"rgb", StyleOp.Rgb}, {"rgba", StyleOp.Rgba}, {"typeof", StyleOp.Typeof},
+      {"string", StyleOp.AssertString}, {"number", StyleOp.AssertNumber}, {"boolean", StyleOp.AssertBoolean},
+      {"array", StyleOp.AssertArray}, {"object", StyleOp.AssertObject},
+      {"+", StyleOp.Add}, {"-", StyleOp.Sub}, {"*", StyleOp.Mul}, {"/", StyleOp.Div}, {"%", StyleOp.Mod}, {"^", StyleOp.Pow},
+      {"abs", StyleOp.Abs}, {"round", StyleOp.Round}, {"floor", StyleOp.Floor}, {"ceil", StyleOp.Ceil}, {"min", StyleOp.Min}, {"max", StyleOp.Max},
+      {"sqrt", StyleOp.Sqrt}, {"ln", StyleOp.Ln}, {"log10", StyleOp.Log10}, {"log2", StyleOp.Log2}, {"sin", StyleOp.Sin}, {"cos", StyleOp.Cos},
+      {"tan", StyleOp.Tan}, {"asin", StyleOp.Asin}, {"acos", StyleOp.Acos}, {"atan", StyleOp.Atan}, {"pi", StyleOp.Pi}, {"e", StyleOp.E}, {"ln2", StyleOp.Ln2},
+      {"step", StyleOp.Step}, {"interpolate", StyleOp.Interpolate},
+      {"filter-==", StyleOp.FilterEq}, {"filter-id-==", StyleOp.FilterIdEq}, {"filter-type-==", StyleOp.FilterTypeEq},
+      {"filter-<", StyleOp.FilterLt}, {"filter-id-<", StyleOp.FilterIdLt}, {"filter->", StyleOp.FilterGt}, {"filter-id->", StyleOp.FilterIdGt},
+      {"filter-<=", StyleOp.FilterLte}, {"filter-id-<=", StyleOp.FilterIdLte}, {"filter->=", StyleOp.FilterGte}, {"filter-id->=", StyleOp.FilterIdGte},
+      {"filter-has", StyleOp.FilterHas}, {"filter-has-id", StyleOp.FilterHasId}, {"filter-type-in", StyleOp.FilterTypeIn},
+      {"filter-id-in", StyleOp.FilterIdIn}, {"filter-in-small", StyleOp.FilterInSmall},
+    };
+    for (Object[] row : table) OP_TABLE.put((String) row[0], (StyleOp) row[1]);
+  }
+
+  public static boolean isError(Object value) {
+    return isErrorV(value);
+  }
+
+  // ---- 評価本体 ----
+
+  /** 式を評価する。戻り値は null / Boolean / Number / String / List / Map / CssColor / ERROR */
+  public static Object evaluate(Object expr, EvalContext ctx) {
+    if (isNullV(expr)) return null;
+    if (isStringV(expr) || isNumberV(expr) || isBoolV(expr) || isColorV(expr)) return expr;
+    if (isObjectV(expr)) return ERROR; // 素のオブジェクトは ["literal", {...}] を使う必要がある
+    if (!isArrayV(expr)) return ERROR;
+    List<?> arr = (List<?>) expr;
+    if (arr.isEmpty() || !isStringV(arr.get(0))) return ERROR;
+    return evaluateArray(arr, ctx);
+  }
+
+  /** 引数を全部評価して数値配列にする。1つでも数値でなければ null */
+  private static double[] evaluateNumbers(List<?> arr, int start, EvalContext ctx) {
+    double[] out = new double[arr.size() - start];
+    for (int i = start; i < arr.size(); i++) {
+      Object v = evaluate(arr.get(i), ctx);
+      if (!isNumberV(v)) return null;
+      out[i - start] = numV(v);
+    }
+    return out;
+  }
+
+  private static Object evaluateArray(List<?> arr, EvalContext ctx) {
+    String opName = (String) arr.get(0);
+    StyleOp op = OP_TABLE.get(opName);
+    if (op == null) op = StyleOp.Unknown;
+    int argc = arr.size() - 1;
+
+    switch (op) {
+      case Unknown:
+        return ERROR;
+
+      case Literal:
+        if (argc != 1) return ERROR;
+        return arr.get(1);
+
+      case Get:
+      case Has: {
+        if (argc < 1 || argc > 2) return ERROR;
+        Object key = evaluate(arr.get(1), ctx);
+        if (!isStringV(key)) return ERROR;
+        Map<?, ?> obj = ctx.properties;
+        if (argc == 2) {
+          Object o = evaluate(arr.get(2), ctx);
+          if (!isObjectV(o)) return ERROR;
+          obj = (Map<?, ?>) o;
+        }
+        if (op == StyleOp.Has) return boxBool(obj.containsKey(key));
+        return obj.get(key);
+      }
+
+      case Properties:
+        return ctx.properties;
+
+      case GeometryType:
+        return ctx.geometryType;
+
+      case Id:
+        return ctx.featureId;
+
+      case Zoom:
+        return boxNum(ctx.zoom);
+
+      case FeatureState:
+        return null; // feature-state はネイティブに無い。常に null
+
+      case Match:
+        return opMatch(arr, ctx);
+
+      case Case:
+        return opCase(arr, ctx);
+
+      case Coalesce: {
+        if (argc < 1) return ERROR;
+        Object result = null;
+        for (int i = 1; i < arr.size(); i++) {
+          result = evaluate(arr.get(i), ctx);
+          if (isErrorV(result)) return ERROR;
+          if (!isNullV(result)) return result;
+        }
+        return result;
+      }
+
+      case Let: {
+        // ["let", name1, value1, ..., result]
+        if (argc < 3 || argc % 2 == 0) return ERROR;
+        Map<String, Object> bindings = new HashMap<>();
+        for (int i = 1; i + 1 < arr.size() - 1; i += 2) {
+          if (!isStringV(arr.get(i))) return ERROR;
+          Object v = evaluate(arr.get(i + 1), ctx);
+          if (isErrorV(v)) return ERROR;
+          bindings.put((String) arr.get(i), v);
+        }
+        return evaluate(arr.get(arr.size() - 1), ctx.withBindings(bindings));
+      }
+
+      case Var: {
+        if (argc != 1 || !isStringV(arr.get(1))) return ERROR;
+        if (ctx.bindings == null || !ctx.bindings.containsKey((String) arr.get(1))) return ERROR; // 未束縛
+        return ctx.bindings.get((String) arr.get(1));
+      }
+
+      case Eq:
+      case Neq: {
+        if (argc < 2 || argc > 3) return ERROR; // 第3引数（collator）は無視
+        Object a = evaluate(arr.get(1), ctx);
+        if (isErrorV(a)) return ERROR;
+        Object b = evaluate(arr.get(2), ctx);
+        if (isErrorV(b)) return ERROR;
+        boolean eq = strictEquals(a, b);
+        return boxBool(op == StyleOp.Eq ? eq : !eq);
+      }
+
+      case Lt:
+      case Lte:
+      case Gt:
+      case Gte: {
+        if (argc < 2 || argc > 3) return ERROR;
+        Object a = evaluate(arr.get(1), ctx);
+        if (isErrorV(a)) return ERROR;
+        Object b = evaluate(arr.get(2), ctx);
+        if (isErrorV(b)) return ERROR;
+        int cmp;
+        if (isNumberV(a) && isNumberV(b)) {
+          double x = numV(a), y = numV(b);
+          if (Double.isNaN(x) || Double.isNaN(y)) return boxBool(false);
+          cmp = x < y ? -1 : (x > y ? 1 : 0);
+        } else if (isStringV(a) && isStringV(b)) {
+          cmp = compareStrings((String) a, (String) b);
+        } else {
+          return ERROR; // 型混在・null・boolean は比較できない
+        }
+        switch (op) {
+          case Lt: return boxBool(cmp < 0);
+          case Lte: return boxBool(cmp <= 0);
+          case Gt: return boxBool(cmp > 0);
+          default: return boxBool(cmp >= 0);
+        }
+      }
+
+      case Not: {
+        if (argc != 1) return ERROR;
+        Object v = evaluate(arr.get(1), ctx);
+        if (!isBoolV(v)) return ERROR;
+        return boxBool(!boolV(v));
+      }
+
+      case All:
+      case Any: {
+        for (int i = 1; i < arr.size(); i++) {
+          Object v = evaluate(arr.get(i), ctx);
+          if (!isBoolV(v)) return ERROR;
+          if (op == StyleOp.All && !boolV(v)) return boxBool(false);
+          if (op == StyleOp.Any && boolV(v)) return boxBool(true);
+        }
+        return boxBool(op == StyleOp.All);
+      }
+
+      case In: {
+        if (argc != 2) return ERROR;
+        Object needle = evaluate(arr.get(1), ctx);
+        if (isErrorV(needle)) return ERROR;
+        Object haystack = evaluate(arr.get(2), ctx);
+        if (isErrorV(haystack)) return ERROR;
+        if (!jsTruthy(haystack)) return boxBool(false);
+        if (!(isBoolV(needle) || isStringV(needle) || isNumberV(needle) || isNullV(needle))) return ERROR;
+        if (isStringV(haystack)) {
+          String n = valueToString(needle);
+          if (isNullV(needle)) n = "null"; // JS: "abc".indexOf(null) は "null" を探す
+          if (n.isEmpty()) return boxBool(true);
+          return boxBool(((String) haystack).contains(n));
+        }
+        if (isArrayV(haystack)) {
+          for (Object item : (List<?>) haystack) {
+            if (strictEquals(item, needle)) return boxBool(true);
+          }
+          return boxBool(false);
+        }
+        return ERROR;
+      }
+
+      case IndexOf: {
+        if (argc < 2 || argc > 3) return ERROR;
+        Object needle = evaluate(arr.get(1), ctx);
+        if (isErrorV(needle)) return ERROR;
+        Object haystack = evaluate(arr.get(2), ctx);
+        if (isErrorV(haystack)) return ERROR;
+        if (!(isBoolV(needle) || isStringV(needle) || isNumberV(needle) || isNullV(needle))) return ERROR;
+        double fromIndex = 0;
+        boolean hasFrom = false;
+        if (argc == 3) {
+          Object f = evaluate(arr.get(3), ctx);
+          if (!isNumberV(f)) return ERROR;
+          fromIndex = numV(f);
+          hasFrom = true;
+        }
+        if (isStringV(haystack)) {
+          String h = (String) haystack;
+          String n = isNullV(needle) ? "null" : valueToString(needle);
+          // JS の indexOf は UTF-16 単位で探し、結果はコードポイント数に直す
+          int start = 0;
+          if (hasFrom) {
+            double f = Math.max(0, fromIndex);
+            start = (int) Math.min(f, (double) h.length());
+          }
+          int idx = n.isEmpty() ? start : h.indexOf(n, start);
+          if (idx < 0) return boxNum(-1);
+          return boxNum((double) h.codePointCount(0, idx));
+        }
+        if (isArrayV(haystack)) {
+          List<?> h = (List<?>) haystack;
+          int start = 0;
+          if (hasFrom) {
+            double f = fromIndex < 0 ? Math.max((double) h.size() + fromIndex, 0) : fromIndex;
+            start = (int) Math.min(f, (double) h.size());
+          }
+          for (int i = start; i < h.size(); i++) {
+            if (strictEquals(h.get(i), needle)) return boxNum((double) i);
+          }
+          return boxNum(-1);
+        }
+        return ERROR;
+      }
+
+      case Slice: {
+        if (argc < 2 || argc > 3) return ERROR;
+        Object input = evaluate(arr.get(1), ctx);
+        if (isErrorV(input)) return ERROR;
+        Object b = evaluate(arr.get(2), ctx);
+        if (!isNumberV(b)) return ERROR;
+        double begin = numV(b);
+        boolean hasEnd = false;
+        double end = 0;
+        if (argc == 3) {
+          Object e = evaluate(arr.get(3), ctx);
+          if (!isNumberV(e)) return ERROR;
+          end = numV(e);
+          hasEnd = true;
+        }
+        if (isStringV(input)) {
+          int[] cps = codePoints((String) input);
+          int[] range = jsSliceRange(cps.length, begin, hasEnd, end);
+          return new String(cps, range[0], range[1] - range[0]);
+        }
+        if (isArrayV(input)) return jsSliceArray((List<?>) input, begin, hasEnd, end);
+        return ERROR;
+      }
+
+      case Length: {
+        if (argc != 1) return ERROR;
+        Object input = evaluate(arr.get(1), ctx);
+        if (isStringV(input)) {
+          String s = (String) input;
+          return boxNum((double) s.codePointCount(0, s.length()));
+        }
+        if (isArrayV(input)) return boxNum((double) ((List<?>) input).size());
+        return ERROR;
+      }
+
+      case At: {
+        if (argc != 2) return ERROR;
+        Object idx = evaluate(arr.get(1), ctx);
+        if (!isNumberV(idx)) return ERROR;
+        Object array = evaluate(arr.get(2), ctx);
+        if (!isArrayV(array)) return ERROR;
+        double i = numV(idx);
+        List<?> a = (List<?>) array;
+        if (i < 0 || i >= (double) a.size() || i != Math.floor(i)) return ERROR;
+        return a.get((int) i);
+      }
+
+      case Upcase:
+      case Downcase: {
+        if (argc != 1) return ERROR;
+        Object s = evaluate(arr.get(1), ctx);
+        if (!isStringV(s)) return ERROR;
+        return op == StyleOp.Upcase ? ((String) s).toUpperCase(Locale.ROOT) : ((String) s).toLowerCase(Locale.ROOT);
+      }
+
+      case Concat: {
+        StringBuilder out = new StringBuilder();
+        for (int i = 1; i < arr.size(); i++) {
+          Object v = evaluate(arr.get(i), ctx);
+          if (isErrorV(v)) return ERROR;
+          out.append(valueToString(v));
+        }
+        return out.toString();
+      }
+
+      case Format:
+        return opFormat(arr, ctx);
+
+      case NumberFormat:
+        return opNumberFormat(arr, ctx);
+
+      case ToString: {
+        if (argc != 1) return ERROR;
+        Object v = evaluate(arr.get(1), ctx);
+        if (isErrorV(v)) return ERROR;
+        return valueToString(v);
+      }
+
+      case ToNumber: {
+        if (argc < 1) return ERROR;
+        for (int i = 1; i < arr.size(); i++) {
+          Object v = evaluate(arr.get(i), ctx);
+          if (isErrorV(v)) return ERROR;
+          if (isNullV(v)) return boxNum(0);
+          if (isNumberV(v)) return v;
+          if (isBoolV(v)) return boxNum(boolV(v) ? 1 : 0);
+          if (isStringV(v)) {
+            double d = jsStringToNumber((String) v);
+            if (!Double.isNaN(d)) return boxNum(d);
+            continue;
+          }
+          // array / object / color は NaN 扱い → 次へ
+        }
+        return ERROR;
+      }
+
+      case ToBoolean: {
+        if (argc != 1) return ERROR;
+        Object v = evaluate(arr.get(1), ctx);
+        if (isErrorV(v)) return ERROR;
+        return boxBool(jsTruthy(v));
+      }
+
+      case ToColor: {
+        if (argc < 1) return ERROR;
+        for (int i = 1; i < arr.size(); i++) {
+          Object v = evaluate(arr.get(i), ctx);
+          if (isErrorV(v)) return ERROR;
+          if (isColorV(v)) return v;
+          if (isStringV(v)) {
+            CssColor c = CssColor.parse((String) v);
+            if (c != null) return c;
+          } else if (isArrayV(v)) {
+            // maplibre は new Color(r/255, g/255, b/255, a)（premultiplied=true）で作るので、
+            // 取り出すときに r,g,b が a で割られる。Web と同じ見た目にするため同じ癖を再現する
+            CssColor c = colorFromNumberArray((List<?>) v);
+            if (c != null && c.a > 0 && c.a < 1) c = new CssColor(c.r / c.a, c.g / c.a, c.b / c.a, c.a);
+            if (c != null) return c;
+          }
+        }
+        return ERROR;
+      }
+
+      case ToRgba: {
+        if (argc != 1) return ERROR;
+        Object v = evaluate(arr.get(1), ctx);
+        if (!isColorV(v)) return ERROR;
+        CssColor c = (CssColor) v;
+        List<Object> out = new ArrayList<>(4);
+        out.add(boxNum(c.r));
+        out.add(boxNum(c.g));
+        out.add(boxNum(c.b));
+        out.add(boxNum(c.a));
+        return out;
+      }
+
+      case Rgb:
+      case Rgba: {
+        if ((op == StyleOp.Rgb && argc != 3) || (op == StyleOp.Rgba && argc != 4)) return ERROR;
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        List<Object> withAlpha = new ArrayList<>(4);
+        for (double n : nums) withAlpha.add(boxNum(n));
+        if (op == StyleOp.Rgb) withAlpha.add(boxNum(1));
+        CssColor c = colorFromNumberArray(withAlpha);
+        return c != null ? c : ERROR;
+      }
+
+      case Typeof: {
+        if (argc != 1) return ERROR;
+        Object v = evaluate(arr.get(1), ctx);
+        if (isErrorV(v)) return ERROR;
+        return typeName(v);
+      }
+
+      case AssertString:
+      case AssertNumber:
+      case AssertBoolean:
+      case AssertObject: {
+        if (argc < 1) return ERROR;
+        for (int i = 1; i < arr.size(); i++) {
+          Object v = evaluate(arr.get(i), ctx);
+          if (isErrorV(v)) return ERROR;
+          if ((op == StyleOp.AssertString && isStringV(v)) || (op == StyleOp.AssertNumber && isNumberV(v))
+              || (op == StyleOp.AssertBoolean && isBoolV(v)) || (op == StyleOp.AssertObject && isObjectV(v))) {
+            return v;
+          }
+        }
+        return ERROR;
+      }
+
+      case AssertArray: {
+        // ["array", value] / ["array", type, value] / ["array", type, N, value]
+        if (argc < 1) return ERROR;
+        Object v = evaluate(arr.get(arr.size() - 1), ctx);
+        if (!isArrayV(v)) return ERROR;
+        return v;
+      }
+
+      case Add:
+      case Mul: {
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        double result = op == StyleOp.Add ? 0 : 1;
+        for (double n : nums) result = op == StyleOp.Add ? result + n : result * n;
+        return boxNum(result);
+      }
+
+      case Sub: {
+        if (argc < 1 || argc > 2) return ERROR;
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        if (argc == 1) return boxNum(-nums[0]);
+        return boxNum(nums[0] - nums[1]);
+      }
+
+      case Div:
+      case Mod:
+      case Pow: {
+        if (argc != 2) return ERROR;
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        double a = nums[0], b = nums[1];
+        if (op == StyleOp.Div) return boxNum(a / b);
+        if (op == StyleOp.Mod) return boxNum(a % b); // JS の % と同じく被除数の符号
+        return boxNum(Math.pow(a, b));
+      }
+
+      case Abs:
+      case Round:
+      case Floor:
+      case Ceil:
+      case Sqrt:
+      case Ln:
+      case Log10:
+      case Log2:
+      case Sin:
+      case Cos:
+      case Tan:
+      case Asin:
+      case Acos:
+      case Atan: {
+        if (argc != 1) return ERROR;
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        double v = nums[0];
+        switch (op) {
+          case Abs: return boxNum(Math.abs(v));
+          case Round: return boxNum(v < 0 ? -Math.floor(-v + 0.5) : Math.floor(v + 0.5)); // JS Math.round を maplibre が対称化したもの
+          case Floor: return boxNum(Math.floor(v));
+          case Ceil: return boxNum(Math.ceil(v));
+          case Sqrt: return boxNum(Math.sqrt(v));
+          case Ln: return boxNum(Math.log(v));
+          case Log10: return boxNum(Math.log(v) / Math.log(10));
+          case Log2: return boxNum(Math.log(v) / Math.log(2));
+          case Sin: return boxNum(Math.sin(v));
+          case Cos: return boxNum(Math.cos(v));
+          case Tan: return boxNum(Math.tan(v));
+          case Asin: return boxNum(Math.asin(v));
+          case Acos: return boxNum(Math.acos(v));
+          default: return boxNum(Math.atan(v));
+        }
+      }
+
+      case Min:
+      case Max: {
+        double[] nums = evaluateNumbers(arr, 1, ctx);
+        if (nums == null) return ERROR;
+        double result = op == StyleOp.Min ? Double.POSITIVE_INFINITY : Double.NEGATIVE_INFINITY;
+        for (double n : nums) result = op == StyleOp.Min ? Math.min(result, n) : Math.max(result, n);
+        return boxNum(result);
+      }
+
+      case Pi: return boxNum(Math.PI);
+      case E: return boxNum(Math.E);
+      case Ln2: return boxNum(Math.log(2));
+
+      case Step:
+        return opStep(arr, ctx);
+
+      case Interpolate:
+        return opInterpolate(arr, ctx);
+
+      // --- legacy filter の内部演算子（maplibre の feature_filter と同じ意味論） ---
+      case FilterEq:
+      case FilterLt:
+      case FilterGt:
+      case FilterLte:
+      case FilterGte: {
+        if (argc != 2 || !isStringV(arr.get(1))) return ERROR;
+        String key = (String) arr.get(1);
+        if (!ctx.properties.containsKey(key)) return boxBool(false); // 無ければ JS の undefined
+        Object a = ctx.properties.get(key);
+        Object b = arr.get(2);
+        return boxBool(legacyCompare(a, b, op));
+      }
+
+      case FilterIdEq:
+      case FilterIdLt:
+      case FilterIdGt:
+      case FilterIdLte:
+      case FilterIdGte: {
+        if (argc != 1) return ERROR;
+        Object a = ctx.featureId;
+        if (a == null) return boxBool(false);
+        StyleOp base = op == StyleOp.FilterIdEq ? StyleOp.FilterEq : op == StyleOp.FilterIdLt ? StyleOp.FilterLt
+            : op == StyleOp.FilterIdGt ? StyleOp.FilterGt : op == StyleOp.FilterIdLte ? StyleOp.FilterLte : StyleOp.FilterGte;
+        return boxBool(legacyCompare(a, arr.get(1), base));
+      }
+
+      case FilterTypeEq: {
+        if (argc != 1) return ERROR;
+        return boxBool(isStringV(arr.get(1)) && ctx.geometryType.equals(arr.get(1)));
+      }
+
+      case FilterHas: {
+        if (argc != 1 || !isStringV(arr.get(1))) return ERROR;
+        return boxBool(ctx.properties.containsKey((String) arr.get(1)));
+      }
+
+      case FilterHasId:
+        return boxBool(!isNullV(ctx.featureId));
+
+      case FilterTypeIn:
+      case FilterIdIn: {
+        if (argc != 1) return ERROR;
+        Object values = evaluate(arr.get(1), ctx);
+        if (!isArrayV(values)) return ERROR;
+        Object target = op == StyleOp.FilterTypeIn ? ctx.geometryType : ctx.featureId;
+        if (target == null) return boxBool(false);
+        for (Object v : (List<?>) values) {
+          if (strictEquals(v, target)) return boxBool(true);
+        }
+        return boxBool(false);
+      }
+
+      case FilterInSmall: {
+        if (argc != 2 || !isStringV(arr.get(1))) return ERROR;
+        Object values = evaluate(arr.get(2), ctx);
+        if (!isArrayV(values)) return ERROR;
+        String key = (String) arr.get(1);
+        if (!ctx.properties.containsKey(key)) return boxBool(false);
+        Object a = ctx.properties.get(key);
+        for (Object v : (List<?>) values) {
+          if (strictEquals(v, a)) return boxBool(true);
+        }
+        return boxBool(false);
+      }
+
+      default:
+        return ERROR;
+    }
+  }
+
+  /** legacy filter の比較: typeof が同じときだけ比較する（JS の `typeof a === typeof b && a < b`） */
+  private static boolean legacyCompare(Object a, Object b, StyleOp op) {
+    if (op == StyleOp.FilterEq) return strictEquals(a, b);
+    int cmp;
+    if (isNumberV(a) && isNumberV(b)) {
+      double x = numV(a), y = numV(b);
+      if (Double.isNaN(x) || Double.isNaN(y)) return false;
+      cmp = x < y ? -1 : (x > y ? 1 : 0);
+    } else if (isStringV(a) && isStringV(b)) {
+      cmp = compareStrings((String) a, (String) b);
+    } else {
+      return false;
+    }
+    switch (op) {
+      case FilterLt: return cmp < 0;
+      case FilterLte: return cmp <= 0;
+      case FilterGt: return cmp > 0;
+      default: return cmp >= 0;
+    }
+  }
+
+  /** JS の文字列比較（UTF-16 コード単位の辞書順）。String.compareTo がそのまま同じ順序 */
+  private static int compareStrings(String a, String b) {
+    return a.compareTo(b);
+  }
+
+  private static Object opMatch(List<?> arr, EvalContext ctx) {
+    // ["match", input, label1, output1, ..., fallback]
+    int argc = arr.size() - 1;
+    if (argc < 4 || argc % 2 != 0) return ERROR;
+    // ラベルは文字列か整数（またはその配列）で、全部同じ型
+    boolean labelsAreString = false, labelsAreNumber = false;
+    for (int i = 2; i + 1 < arr.size(); i += 2) {
+      List<?> labels = isArrayV(arr.get(i)) ? (List<?>) arr.get(i) : Collections.singletonList(arr.get(i));
+      if (labels.isEmpty()) return ERROR;
+      for (Object label : labels) {
+        if (isStringV(label)) {
+          labelsAreString = true;
+        } else if (isNumberV(label)) {
+          double d = numV(label);
+          if (d != Math.floor(d) || Double.isInfinite(d)) return ERROR; // 数値ラベルは整数のみ
+          labelsAreNumber = true;
+        } else {
+          return ERROR;
+        }
+      }
+    }
+    if (labelsAreString && labelsAreNumber) return ERROR;
+    Object input = evaluate(arr.get(1), ctx);
+    if (isErrorV(input)) return ERROR;
+    boolean inputMatchesType = (labelsAreString && isStringV(input)) || (labelsAreNumber && isNumberV(input));
+    if (inputMatchesType) {
+      for (int i = 2; i + 1 < arr.size(); i += 2) {
+        List<?> labels = isArrayV(arr.get(i)) ? (List<?>) arr.get(i) : Collections.singletonList(arr.get(i));
+        for (Object label : labels) {
+          if (strictEquals(label, input)) return evaluate(arr.get(i + 1), ctx);
+        }
+      }
+    }
+    return evaluate(arr.get(arr.size() - 1), ctx);
+  }
+
+  private static Object opCase(List<?> arr, EvalContext ctx) {
+    // ["case", cond1, out1, ..., fallback]
+    int argc = arr.size() - 1;
+    if (argc < 3 || argc % 2 != 1) return ERROR;
+    for (int i = 1; i + 1 < arr.size() - 1; i += 2) {
+      Object cond = evaluate(arr.get(i), ctx);
+      if (!isBoolV(cond)) return ERROR;
+      if (boolV(cond)) return evaluate(arr.get(i + 1), ctx);
+    }
+    return evaluate(arr.get(arr.size() - 1), ctx);
+  }
+
+  private static Object opFormat(List<?> arr, EvalContext ctx) {
+    // ["format", content1, {options}?, content2, ...] → 文字列部分だけを連結する（書式オプションは無視）
+    if (arr.size() < 2) return ERROR;
+    if (isObjectV(arr.get(1))) return ERROR; // 先頭はテキストでなければならない
+    StringBuilder out = new StringBuilder();
+    boolean nextMayBeOptions = false;
+    for (int i = 1; i < arr.size(); i++) {
+      Object arg = arr.get(i);
+      if (nextMayBeOptions && isObjectV(arg)) {
+        nextMayBeOptions = false;
+        continue;
+      }
+      Object v = evaluate(arg, ctx);
+      if (isErrorV(v)) return ERROR;
+      if (!(isStringV(v) || isNullV(v) || isNumberV(v) || isBoolV(v) || isColorV(v) || isArrayV(v) || isObjectV(v))) {
+        return ERROR;
+      }
+      out.append(valueToString(v));
+      nextMayBeOptions = true;
+    }
+    return out.toString();
+  }
+
+  private static Object opNumberFormat(List<?> arr, EvalContext ctx) {
+    // ["number-format", number, {locale?, currency?, unit?, min-fraction-digits?, max-fraction-digits?}]
+    // en-US の decimal 書式だけ対応する（currency / unit / 他ロケールは未対応 → エラー）
+    if (arr.size() != 3 || !isObjectV(arr.get(2))) return ERROR;
+    Object n = evaluate(arr.get(1), ctx);
+    if (!isNumberV(n)) return ERROR;
+    Map<?, ?> options = (Map<?, ?>) arr.get(2);
+    if (options.containsKey("currency") || options.containsKey("unit")) return ERROR;
+    if (options.containsKey("locale")) {
+      Object locale = evaluate(options.get("locale"), ctx);
+      if (!isStringV(locale)) return ERROR;
+      String l = ((String) locale).toLowerCase(Locale.ROOT);
+      if (!(l.equals("en") || l.equals("en-us"))) return ERROR;
+    }
+    int minFD = 0, maxFD = 3;
+    // JS 側は `if (options["min-fraction-digits"])` なので 0 は未指定と同じ
+    Object minOpt = options.get("min-fraction-digits");
+    if (minOpt != null && jsTruthy(minOpt)) {
+      Object v = evaluate(minOpt, ctx);
+      if (!isNumberV(v)) return ERROR;
+      minFD = (int) numV(v);
+    }
+    Object maxOpt = options.get("max-fraction-digits");
+    if (maxOpt != null && jsTruthy(maxOpt)) {
+      Object v = evaluate(maxOpt, ctx);
+      if (!isNumberV(v)) return ERROR;
+      maxFD = (int) numV(v);
+    }
+    if (maxFD < minFD) maxFD = minFD; // Intl は max < min を RangeError にするが、ここでは広い方に揃える
+    double d = numV(n);
+    if (Double.isNaN(d)) return "NaN";
+    if (Double.isInfinite(d)) return d > 0 ? "∞" : "-∞";
+    DecimalFormat fmt = new DecimalFormat("#,##0.###", DecimalFormatSymbols.getInstance(Locale.US));
+    fmt.setGroupingUsed(true);
+    fmt.setGroupingSize(3);
+    fmt.setMinimumFractionDigits(minFD);
+    fmt.setMaximumFractionDigits(maxFD);
+    fmt.setRoundingMode(RoundingMode.HALF_UP); // Intl の既定（halfExpand）と同じ
+    // ICU（Intl / NSNumberFormatter）は double を最短の十進表現にしてから丸めるので、JS の書式を経由する
+    return fmt.format(new BigDecimal(jsNumberToString(d)));
+  }
+
+  private static Object opStep(List<?> arr, EvalContext ctx) {
+    // ["step", input, out0, stop1, out1, stop2, out2, ...]
+    int argc = arr.size() - 1;
+    if (argc < 4 || argc % 2 != 0) return ERROR;
+    // ストップは数値リテラルで昇順
+    double prev = Double.NEGATIVE_INFINITY;
+    for (int i = 3; i < arr.size(); i += 2) {
+      if (!isNumberV(arr.get(i))) return ERROR;
+      double label = numV(arr.get(i));
+      if (label <= prev) return ERROR;
+      prev = label;
+    }
+    Object input = evaluate(arr.get(1), ctx);
+    if (!isNumberV(input)) return ERROR;
+    double value = numV(input);
+    // labels[0] = -inf, outputs[0] = arr[2]; labels[k] = arr[1+2k], outputs[k] = arr[2+2k]
+    int outputIndex = 2;
+    for (int i = 3; i < arr.size(); i += 2) {
+      if (value >= numV(arr.get(i))) outputIndex = i + 1;
+      else break;
+    }
+    return evaluate(arr.get(outputIndex), ctx);
+  }
+
+  private static double exponentialInterpolation(double input, double base, double lower, double upper) {
+    double difference = upper - lower;
+    double progress = input - lower;
+    if (difference == 0) return 0;
+    if (base == 1) return progress / difference;
+    return (Math.pow(base, progress) - 1) / (Math.pow(base, difference) - 1);
+  }
+
+  /** maplibre の unitbezier（WebKit 由来） */
+  private static double unitBezierSolve(double p1x, double p1y, double p2x, double p2y, double x) {
+    double cx = 3.0 * p1x, bx = 3.0 * (p2x - p1x) - cx, ax = 1.0 - cx - bx;
+    double cy = 3.0 * p1y, by = 3.0 * (p2y - p1y) - cy, ay = 1.0 - cy - by;
+    final double epsilon = 1e-6;
+    if (x <= 0) return 0;
+    if (x >= 1) return 1;
+    double t = x;
+    for (int i = 0; i < 8; i++) {
+      double x2 = ((ax * t + bx) * t + cx) * t - x;
+      if (Math.abs(x2) < epsilon) return ((ay * t + by) * t + cy) * t;
+      double d2 = (3 * ax * t + 2 * bx) * t + cx;
+      if (Math.abs(d2) < 1e-6) break;
+      t -= x2 / d2;
+    }
+    double t0 = 0, t1 = 1;
+    t = x;
+    for (int i = 0; i < 20; i++) {
+      double x2 = ((ax * t + bx) * t + cx) * t;
+      if (Math.abs(x2 - x) < epsilon) break;
+      if (x > x2) t0 = t;
+      else t1 = t;
+      t = (t0 + t1) * 0.5;
+    }
+    return ((ay * t + by) * t + cy) * t;
+  }
+
+  private static Object opInterpolate(List<?> arr, EvalContext ctx) {
+    // ["interpolate", ["linear"] | ["exponential", base] | ["cubic-bezier", x1,y1,x2,y2], input, stop1, out1, ...]
+    // 出力は数値と色（rgba の線形補間。interpolate-hcl / -lab は未対応）
+    if (arr.size() < 5 || (arr.size() - 3) % 2 != 0) return ERROR;
+    if (!isArrayV(arr.get(1)) || ((List<?>) arr.get(1)).isEmpty() || !isStringV(((List<?>) arr.get(1)).get(0))) return ERROR;
+    List<?> interp = (List<?>) arr.get(1);
+    String kind = (String) interp.get(0);
+    double base = 1;
+    double[] bez = {0, 0, 1, 1};
+    if (kind.equals("linear")) {
+      base = 1;
+    } else if (kind.equals("exponential")) {
+      if (interp.size() != 2 || !isNumberV(interp.get(1))) return ERROR;
+      base = numV(interp.get(1));
+    } else if (kind.equals("cubic-bezier")) {
+      if (interp.size() != 5) return ERROR;
+      for (int i = 0; i < 4; i++) {
+        if (!isNumberV(interp.get(i + 1))) return ERROR;
+        bez[i] = numV(interp.get(i + 1));
+      }
+      if (bez[0] < 0 || bez[0] > 1 || bez[2] < 0 || bez[2] > 1) return ERROR;
+    } else {
+      return ERROR;
+    }
+    int stopCount = (arr.size() - 3) / 2;
+    double prev = Double.NEGATIVE_INFINITY;
+    for (int k = 0; k < stopCount; k++) {
+      Object label = arr.get(3 + 2 * k);
+      if (!isNumberV(label)) return ERROR;
+      if (numV(label) <= prev) return ERROR;
+      prev = numV(label);
+    }
+    Object input = evaluate(arr.get(2), ctx);
+    if (!isNumberV(input)) return ERROR;
+    double value = numV(input);
+
+    if (stopCount == 1 || value <= labelAt(arr, 0)) {
+      Object out = outputAt(arr, 0, ctx);
+      return (isNumberV(out) || isColorV(out)) ? out : ERROR;
+    }
+    if (value >= labelAt(arr, stopCount - 1)) {
+      Object out = outputAt(arr, stopCount - 1, ctx);
+      return (isNumberV(out) || isColorV(out)) ? out : ERROR;
+    }
+    int index = 0;
+    for (int k = 0; k + 1 < stopCount; k++) {
+      if (labelAt(arr, k) <= value && value < labelAt(arr, k + 1)) {
+        index = k;
+        break;
+      }
+    }
+    double lower = labelAt(arr, index), upper = labelAt(arr, index + 1);
+    double t;
+    if (kind.equals("cubic-bezier")) {
+      t = unitBezierSolve(bez[0], bez[1], bez[2], bez[3], exponentialInterpolation(value, 1, lower, upper));
+    } else {
+      t = exponentialInterpolation(value, base, lower, upper);
+    }
+    Object outLower = outputAt(arr, index, ctx), outUpper = outputAt(arr, index + 1, ctx);
+    if (isColorV(outLower) && isColorV(outUpper)) {
+      CssColor c0 = (CssColor) outLower, c1 = (CssColor) outUpper;
+      return new CssColor(
+          c0.r * (1 - t) + c1.r * t,
+          c0.g * (1 - t) + c1.g * t,
+          c0.b * (1 - t) + c1.b * t,
+          c0.a * (1 - t) + c1.a * t);
+    }
+    if (!isNumberV(outLower) || !isNumberV(outUpper)) return ERROR;
+    double a = numV(outLower), b = numV(outUpper);
+    return boxNum(a * (1 - t) + b * t);
+  }
+
+  private static double labelAt(List<?> arr, int k) {
+    return numV(arr.get(3 + 2 * k));
+  }
+
+  private static Object outputAt(List<?> arr, int k, EvalContext ctx) {
+    return evaluate(arr.get(4 + 2 * k), ctx);
+  }
+
+  /** [r, g, b(, a)] の数値配列を色にする（maplibre の validateRGBA と同じ範囲検査） */
+  private static CssColor colorFromNumberArray(List<?> input) {
+    if (input.size() < 3 || input.size() > 4) return null;
+    for (Object v : input) {
+      if (!isNumberV(v)) return null;
+    }
+    double r = numV(input.get(0)), g = numV(input.get(1)), b = numV(input.get(2));
+    double a = input.size() == 4 ? numV(input.get(3)) : 1;
+    if (!(r >= 0 && r <= 255 && g >= 0 && g <= 255 && b >= 0 && b <= 255)) return null;
+    if (!(a >= 0 && a <= 1)) return null;
+    return new CssColor(r, g, b, a);
+  }
+
+  // ---- 型付きヘルパー（失敗したら def） ----
+
+  /** null / エラー / 数値でない → def。数値に変換できる文字列は救う。NaN/inf → def */
+  public static double evalNumber(Object expr, EvalContext ctx, double def, String key) {
+    if (isNullV(expr)) return def;
+    Object v = evaluate(expr, ctx);
+    if (isNumberV(v)) {
+      double d = numV(v);
+      return (Double.isNaN(d) || Double.isInfinite(d)) ? def : d;
+    }
+    if (isStringV(v)) {
+      // maplibre は型エラーにするが、Web で動かないスタイルを救う方向に倒す
+      double d = jsStringToNumber((String) v);
+      if (!Double.isNaN(d) && !Double.isInfinite(d)) return d;
+    }
+    warnOnce(key, "number expected, using default " + jsNumberToString(def));
+    return def;
+  }
+
+  /** 文字列は CssColor で解釈。色でない → def */
+  public static CssColor evalColor(Object expr, EvalContext ctx, CssColor def, String key) {
+    if (isNullV(expr)) return def;
+    Object v = evaluate(expr, ctx);
+    if (isColorV(v)) return (CssColor) v;
+    if (isStringV(v)) {
+      CssColor c = CssColor.parse((String) v);
+      if (c != null) return c;
+    }
+    warnOnce(key, "color expected, using default");
+    return def;
+  }
+
+  /** 文字列はそのまま、数値は JS 書式で文字列化。null / 他 → def */
+  public static String evalString(Object expr, EvalContext ctx, String def, String key) {
+    if (isNullV(expr)) return def;
+    Object v = evaluate(expr, ctx);
+    if (isStringV(v)) return (String) v;
+    if (isNumberV(v)) return jsNumberToString(numV(v));
+    warnOnce(key, "string expected, using default");
+    return def;
+  }
+
+  /** boolean のみ。他 → def */
+  public static boolean evalBool(Object expr, EvalContext ctx, boolean def, String key) {
+    if (isNullV(expr)) return def;
+    Object v = evaluate(expr, ctx);
+    if (isBoolV(v)) return boolV(v);
+    warnOnce(key, "boolean expected, using default");
+    return def;
+  }
+
+  // ---- filter ----
+
+  /** 正規化済みフィルタを評価。null → true。boolean 以外・エラー → false（maplibre と同じく、評価できない地物は描かない） */
+  public static boolean evalFilter(Object normalizedFilter, EvalContext ctx) {
+    if (isNullV(normalizedFilter)) return true;
+    Object v = evaluate(normalizedFilter, ctx);
+    if (isBoolV(v)) return boolV(v);
+    return false;
+  }
+
+  /** maplibre の isExpressionFilter */
+  private static boolean isExpressionFilter(Object filter) {
+    if (isBoolV(filter)) return true;
+    if (!isArrayV(filter) || ((List<?>) filter).isEmpty()) return false;
+    List<?> f = (List<?>) filter;
+    if (!isStringV(f.get(0))) return true; // default: 式扱い（評価時にエラーになる）
+    String op = (String) f.get(0);
+    if (op.equals("has")) {
+      return f.size() >= 2 && !(isStringV(f.get(1)) && (f.get(1).equals("$id") || f.get(1).equals("$type")));
+    }
+    if (op.equals("in")) {
+      return f.size() >= 3 && (!isStringV(f.get(1)) || isArrayV(f.get(2)));
+    }
+    if (op.equals("!in") || op.equals("!has") || op.equals("none")) return false;
+    if (op.equals("==") || op.equals("!=") || op.equals(">") || op.equals(">=") || op.equals("<") || op.equals("<=")) {
+      return f.size() != 3 || isArrayV(f.get(1)) || isArrayV(f.get(2));
+    }
+    if (op.equals("any") || op.equals("all")) {
+      for (int i = 1; i < f.size(); i++) {
+        if (!isExpressionFilter(f.get(i)) && !isBoolV(f.get(i))) return false;
+      }
+      return true;
+    }
+    return true;
+  }
+
+  /** legacy filter（["==","k",v] / ["in","k",a,b] / ["has","k"] / "$type" など）を式に変換する。式ならそのまま返す。スタイル読込時に 1 回だけ呼ぶ */
+  public static Object normalizeFilter(Object filter) {
+    if (isNullV(filter)) return null;
+    if (isExpressionFilter(filter)) return filter;
+    return convertLegacyFilter(filter);
+  }
+
+  /** maplibre の convertFilter（feature_filter/index.ts 版。filter-* の内部演算子に変換する） */
+  private static Object convertLegacyFilter(Object filter) {
+    if (isNullV(filter)) return Boolean.TRUE;
+    if (!isArrayV(filter)) return Boolean.TRUE;
+    List<?> f = (List<?>) filter;
+    if (f.isEmpty() || !isStringV(f.get(0))) return Boolean.TRUE;
+    String op = (String) f.get(0);
+    if (f.size() <= 1) return boxBool(!op.equals("any"));
+    if (op.equals("==")) return convertComparisonOp(f.get(1), f.get(2), "==");
+    if (op.equals("!=")) return listOf("!", convertComparisonOp(f.get(1), f.get(2), "=="));
+    if (op.equals("<") || op.equals(">") || op.equals("<=") || op.equals(">=")) {
+      return convertComparisonOp(f.get(1), f.get(2), op);
+    }
+    if (op.equals("any") || op.equals("all")) {
+      List<Object> out = new ArrayList<>();
+      out.add(op);
+      for (int i = 1; i < f.size(); i++) out.add(convertLegacyFilter(f.get(i)));
+      return out;
+    }
+    if (op.equals("none")) {
+      List<Object> out = new ArrayList<>();
+      out.add("all");
+      for (int i = 1; i < f.size(); i++) out.add(listOf("!", convertLegacyFilter(f.get(i))));
+      return out;
+    }
+    if (op.equals("in")) return convertInOp(f.get(1), new ArrayList<Object>(f.subList(2, f.size())));
+    if (op.equals("!in")) {
+      return listOf("!", convertInOp(f.get(1), new ArrayList<Object>(f.subList(2, f.size()))));
+    }
+    if (op.equals("has")) return convertHasOp(f.get(1));
+    if (op.equals("!has")) return listOf("!", convertHasOp(f.get(1)));
+    return Boolean.TRUE;
+  }
+
+  private static List<Object> listOf(Object... items) {
+    List<Object> out = new ArrayList<>(items.length);
+    Collections.addAll(out, items);
+    return out;
+  }
+
+  private static Object convertComparisonOp(Object property, Object value, String op) {
+    if (isStringV(property) && property.equals("$type")) return listOf("filter-type-" + op, value);
+    if (isStringV(property) && property.equals("$id")) return listOf("filter-id-" + op, value);
+    return listOf("filter-" + op, property, value);
+  }
+
+  private static Object convertInOp(Object property, List<Object> values) {
+    if (values.isEmpty()) return Boolean.FALSE;
+    if (isStringV(property) && property.equals("$type")) return listOf("filter-type-in", listOf("literal", values));
+    if (isStringV(property) && property.equals("$id")) return listOf("filter-id-in", listOf("literal", values));
+    return listOf("filter-in-small", property, listOf("literal", values));
+  }
