+    {200, 200, 200, 90},
+    {500, 210, 185, 80},
+    {1000, 205, 165, 70},
+    {2000, 190, 145, 65},
+    {3000, 170, 125, 60},
+    {4000, 155, 110, 55}
+  };
+
+  /** 出力PNGのキャッシュ（キー: "x,y,zoom"） */
+  private final LruCache<String, byte[]> shadingCache;
+  /** デコード済み標高のキャッシュ（キー: "x,y,zoom"）。袖のために隣接タイルを何度も引くため */
+  private final LruCache<String, float[]> elevationCache;
+  /**
+   * 同じ標高タイルの同時取得をまとめるためのキー別ロック。
+   * 地図SDKは複数スレッドから並行にgetTileを呼ぶため、隣り合う地図タイルが同じ標高タイルを
+   * 同時に取りに行き、同じダウンロードが重複していた
+   */
+  private final ConcurrentHashMap<String, Object> loadLocks = new ConcurrentHashMap<>();
+  /** 袖に要る隣接タイルを並列に取得するためのスレッド（順番に取ると通信の往復が積み重なる） */
+  private static final ExecutorService NEIGHBOR_EXECUTOR = Executors.newFixedThreadPool(4);
+  /** 標高配列の一辺。全タイル同じ前提で最初に見たタイルから決まる */
+  private volatile int demTileSize = 0;
+  /** relief://（陰影段彩＋等深線）モード。URLプレフィックスから自己判定する */
+  private volatile boolean reliefMode = false;
+  /** GEBCO配色（URLフラグメントの #style=gebco から自己判定する） */
+  private volatile boolean gebcoStyle = false;
+  /**
+   * 標高タイルがterrarium形式（Mapterhorn 512px）か。GEBCO段彩だけはGSI形式（産総研）を読み、
+   * それ以外（陰影起伏・汎用段彩）はterrarium専用（Web版 terrainShading.isTerrariumDemUrl と同じ規則）
+   */
+  private volatile boolean terrarium = true;
+
+  public MapDEMTileProvider(
+    int tileSizet,
+    boolean doubleTileSize,
+    String urlTemplate,
+    int maximumZ,
+    int maximumNativeZ,
+    int minimumZ,
+    boolean flipY,
+    String tileCachePath,
+    int tileCacheMaxAge,
+    boolean offlineMode,
+    Context context,
+    boolean customMode
+  ) {
+    // superの呼び出しは最初に行う必要がある
+    super(tileSizet, doubleTileSize,
+          cleanUrlTemplate(urlTemplate),
+          maximumZ, maximumNativeZ, minimumZ, flipY, tileCachePath, tileCacheMaxAge, offlineMode, context, customMode);
+
+    this.reliefMode = urlTemplate != null && urlTemplate.startsWith("relief://");
+    this.gebcoStyle = urlTemplate != null && urlTemplate.contains("#style=gebco");
+    this.terrarium = !(this.reliefMode && this.gebcoStyle);
+
+    final int maxMemoryKb = (int) (Runtime.getRuntime().maxMemory() / 1024);
+    final int shadingCacheKb = Math.min(maxMemoryKb / 8, 50 * 1024);
+    // 標高1枚は 256px=256KB、512px（terrarium）=1MB。袖のために周囲8枚を参照するので少し多めに持つ
+    final int elevationCacheKb = Math.min(maxMemoryKb / 8, 32 * 1024);
+
+    this.shadingCache = new LruCache<String, byte[]>(shadingCacheKb) {
+      @Override
+      protected int sizeOf(String key, byte[] value) {
+        return Math.max(1, value.length / 1024);
+      }
+    };
+    this.elevationCache = new LruCache<String, float[]>(elevationCacheKb) {
+      @Override
+      protected int sizeOf(String key, float[] value) {
+        return Math.max(1, value.length * 4 / 1024);
+      }
+    };
+  }
+
+  /** URLテンプレートからプレフィックスと方式指定フラグメント（#style=...等）を除去する */
+  private static String cleanUrlTemplate(String urlTemplate) {
+    if (urlTemplate == null) return null;
+    String cleaned = urlTemplate;
+    if (cleaned.startsWith("hillshade://")) {
+      cleaned = cleaned.substring("hillshade://".length());
+    } else if (cleaned.startsWith("relief://")) {
+      cleaned = cleaned.substring("relief://".length());
+    }
+    int hash = cleaned.indexOf('#');
+    return hash < 0 ? cleaned : cleaned.substring(0, hash);
+  }
+
+  /** 出力タイルの一辺。gebcoは512pxソース（elev2）の詳細を保つため実寸で返す */
+  private int outTileSize() {
+    if (reliefMode && gebcoStyle && demTileSize > 0) return demTileSize;
+    return (int) this.tileSize;
+  }
+
+  @Override
+  public Tile getTile(int x, int y, int zoom) {
+    String cacheKey = x + "," + y + "," + zoom;
+    byte[] cached = shadingCache.get(cacheKey);
+    if (cached != null) {
+      return new Tile(outTileSize(), outTileSize(), cached);
+    }
+
+    // まずオーバーズーム分を落とす。terrariumは1段粗いズームの512pxタイルから切り出す
+    int startZoom = zoom > maximumNativeZ ? (int) maximumNativeZ : zoom;
+    if (terrarium) startZoom = Math.max(0, startZoom - TERRARIUM_DEM_ZOOM_OFFSET);
+
+    // 標高タイルの提供範囲はズームによって地域差がある（例えば産総研の陸域統合DEMは
+    // z14は全国にあるがz15は佐渡島・知床・屋久島などで欠ける）。取れなければ粗い
+    // ズームへ降り、該当部分を切り出して拡大する。
+    for (int sourceZoom = startZoom; sourceZoom >= Math.max(0, startZoom - MAX_ZOOM_FALLBACK); sourceZoom--) {
+      int shift = zoom - sourceZoom;
+      int sx = x >> shift;
+      int sy = y >> shift;
+
+      // 中央タイルが取れなければ、さらに粗いズームを試す
+      if (loadElevation(sx, sy, sourceZoom) == null) {
+        continue;
+      }
+
+      int scaleFactor = 1 << shift;
+      byte[] processed = (reliefMode && gebcoStyle)
+        ? createGebcoShading(sx, sy, sourceZoom, scaleFactor, x - (sx << shift), y - (sy << shift))
+        : createShading(sx, sy, sourceZoom, scaleFactor, x - (sx << shift), y - (sy << shift));
+      if (processed == null) {
+        return null;
+      }
+      shadingCache.put(cacheKey, processed);
+      return new Tile(outTileSize(), outTileSize(), processed);
+    }
+    return null;
+  }
+
+  /**
+   * 標高タイル1枚を取得してデコードする。取得できなければ null。
+   * 隣接タイルは周囲のタイルを描くときにも使うのでキャッシュする。
+   * 同じタイルを複数スレッドが同時に要求したら、1つが取得して残りはその結果を使う。
+   */
+  private float[] loadElevation(int x, int y, int zoom) {
+    String key = x + "," + y + "," + zoom;
+    float[] cached = elevationCache.get(key);
+    if (cached != null) {
+      return cached;
+    }
+    Object lock = loadLocks.computeIfAbsent(key, k -> new Object());
+    synchronized (lock) {
+      cached = elevationCache.get(key);
+      if (cached != null) {
+        return cached;
+      }
+      try {
+        return loadElevationUncached(key, x, y, zoom);
+      } finally {
+        loadLocks.remove(key);
+      }
+    }
+  }
+
+  private float[] loadElevationUncached(String key, int x, int y, int zoom) {
+
+    Tile demTile = super.getTile(x, y, zoom);
+    if (demTile == null || demTile.data == null) {
+      return null;
+    }
+
+    // 標高をRGBに詰めた画像なので、アルファ乗算・色空間変換で値が変わらないようにする
+    BitmapFactory.Options options = new BitmapFactory.Options();
+    options.inPremultiplied = false;
+    options.inScaled = false;
+    options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) {
+      options.inPreferredColorSpace = android.graphics.ColorSpace.get(android.graphics.ColorSpace.Named.SRGB);
+    }
+    Bitmap bitmap = BitmapFactory.decodeByteArray(demTile.data, 0, demTile.data.length, options);
+    if (bitmap == null) {
+      Log.e(TAG, "Failed to decode DEM tile: " + key);
+      return null;
+    }
+
+    int width = bitmap.getWidth();
+    int height = bitmap.getHeight();
+    int[] pixels = new int[width * height];
+    bitmap.getPixels(pixels, 0, width, 0, 0, width, height);
+    bitmap.recycle();
+
+    float[] elevation = new float[width * height];
+    final boolean isTerrarium = terrarium;
+    for (int i = 0; i < pixels.length; i++) {
+      int p = pixels[i];
+      int r = (p >> 16) & 0xff;
+      int g = (p >> 8) & 0xff;
+      int b = p & 0xff;
+      elevation[i] = isTerrarium ? decodeTerrarium(r, g, b) : decodeElevation(r, g, b);
+    }
+
+    if (demTileSize == 0) {
+      demTileSize = width;
+    }
+    elevationCache.put(key, elevation);
+    return elevation;
+  }
+
+  /**
+   * 国土地理院・産総研方式の標高デコード。
+   * x = 2^16*R + 2^8*G + B、NoDataは2^23、単位は0.01m。
+   */
+  private static float decodeElevation(int r, int g, int b) {
+    float x = r * 65536.0f + g * 256.0f + b;
+    if (x == 8388608.0f) {
+      return Float.NaN; // NoData
+    }
+    return x < 8388608.0f ? x / 100.0f : (x - 16777216.0f) / 100.0f;
+  }
+
+  /** terrarium形式の標高デコード（Mapterhorn）。標高 = R*256 + G + B/256 - 32768 */
+  private static float decodeTerrarium(int r, int g, int b) {
+    return r * 256.0f + g + b / 256.0f - 32768.0f;
+  }
+
+  /** タイル中心緯度における1画素あたりのメートル数 */
+  private static double metersPerPixel(int zoom, int tileY, int tileSize) {
+    double normalizedTileY = (tileY + 0.5) / Math.pow(2, zoom);
+    double lat = 85.05112878 - 2.0 * 85.05112878 * normalizedTileY;
+    return 40075017.0 * Math.cos(Math.toRadians(lat)) / (tileSize * Math.pow(2, zoom));
+  }
+
+  /**
+   * 中央タイルと周囲のタイルから袖付きの標高バッファを組み立てる。
+   * 袖はHALO画素分だけあればよいので、隣接タイルは必要な帯だけ写す。
+   * 計算する区画（regionX0/regionY0/region、タイル内の画素位置）の袖が届く隣接タイルだけを、
+   * 並列に取得する（512pxタイルの1/4の区画なら隣接は最大3枚。残りはNaNのまま使われない）。
+   */
+  private float[] assembleWithHalo(int x, int y, int zoom, int size, int regionX0, int regionY0, int region) {
+    int bufferSize = size + 2 * HALO;
+    float[] buffer = new float[bufferSize * bufferSize];
+    java.util.Arrays.fill(buffer, Float.NaN);
+
+    boolean needLeft = regionX0 < HALO;
+    boolean needRight = regionX0 + region > size - HALO;
+    boolean needTop = regionY0 < HALO;
+    boolean needBottom = regionY0 + region > size - HALO;
+
+    int max = 1 << zoom;
+    List<int[]> targets = new ArrayList<>();
+    for (int ty = -1; ty <= 1; ty++) {
+      if ((ty == -1 && !needTop) || (ty == 1 && !needBottom)) continue;
+      int ny = y + ty;
+      if (ny < 0 || ny >= max) continue;
+      for (int tx = -1; tx <= 1; tx++) {
+        if ((tx == -1 && !needLeft) || (tx == 1 && !needRight)) continue;
+        targets.add(new int[] {tx, ty, ((x + tx) % max + max) % max, ny}); // 経度方向は巻き戻す
+      }
+    }
+
+    // 中央以外はまとめて並列に取得する（中央は呼び出し側で取得済みでキャッシュに載っている）
+    List<Future<float[]>> futures = new ArrayList<>();
+    for (int[] t : targets) {
+      final int nx = t[2];
+      final int ny = t[3];
+      if (t[0] == 0 && t[1] == 0) {
+        futures.add(null);
+      } else {
+        futures.add(NEIGHBOR_EXECUTOR.submit(() -> loadElevation(nx, ny, zoom)));
+      }
+    }
+
+    for (int i = 0; i < targets.size(); i++) {
+      int[] t = targets.get(i);
+      int tx = t[0];
+      int ty = t[1];
+      float[] tile;
+      try {
+        Future<float[]> future = futures.get(i);
+        tile = future == null ? loadElevation(t[2], t[3], zoom) : future.get();
+      } catch (Exception e) {
+        tile = null;
+      }
+      if (tile == null || tile.length != size * size) continue;
+
+      // このタイルのうちバッファに入る範囲をタイル内座標で求める
+      int srcX0 = tx == -1 ? size - HALO : 0;
+      int srcX1 = tx == 1 ? HALO : size;
+      int srcY0 = ty == -1 ? size - HALO : 0;
+      int srcY1 = ty == 1 ? HALO : size;
+      int dstX = HALO + tx * size + srcX0;
+      int dstY = HALO + ty * size + srcY0;
+      int runLength = srcX1 - srcX0;
+
+      for (int row = srcY0; row < srcY1; row++) {
+        System.arraycopy(tile, row * size + srcX0,
+                         buffer, (dstY + (row - srcY0)) * bufferSize + dstX, runLength);
+      }
+    }
+    return buffer;
+  }
+
+  /**
+   * 陰影を計算してPNGを返す。地図タイルが占める区画（標高タイルの1/scaleFactor）だけを計算し、
+   * 地図タイルの寸法へ拡大・縮小する（terrariumの512pxタイルは常に1段粗いので区画は256px）。
+   */
+  private byte[] createShading(int x, int y, int zoom, int scaleFactor, int offsetX, int offsetY) {
+    try {
+      int size = demTileSize;
+      if (size <= 0) return null;
+
+      int bufferSize = size + 2 * HALO;
+      // 計算する区画（標高タイル内の画素位置）
+      final int region = Math.max(1, size / scaleFactor);
+      final int regionX0 = offsetX * region;
+      final int regionY0 = offsetY * region;
+      float[] buffer = assembleWithHalo(x, y, zoom, size, regionX0, regionY0, region);
+      double metersPerPx = metersPerPixel(zoom, y, size);
+
+      // レイキャストの標本位置は全画素で共通なので、添字差分と距離の逆数を先に作る
+      int samples = NUM_DIRECTIONS * SEARCH_RADIUS;
+      int[] offsets = new int[samples];
+      float[] invDistances = new float[samples];
+      for (int d = 0; d < NUM_DIRECTIONS; d++) {
+        double theta = 2.0 * Math.PI * d / NUM_DIRECTIONS;
+        double dx = Math.cos(theta);
+        double dy = Math.sin(theta);
+        for (int s = 1; s <= SEARCH_RADIUS; s++) {
+          int i = d * SEARCH_RADIUS + (s - 1);
+          offsets[i] = (int) Math.round(dy * s) * bufferSize + (int) Math.round(dx * s);
+          invDistances[i] = (float) (1.0 / (s * metersPerPx));
+        }
+      }
+
+      final float toDeg = (float) (180.0 / Math.PI);
+      final float slopeInv = (float) (1.0 / (2.0 * metersPerPx));
+      int[] pixels = new int[region * region];
+
+      // 陰影段彩用: 等深線の間隔（zoomは計算を実行したsourceZoom）と色の作業領域
+      int contourMinor = 0;
+      int contourMajor = 0;
+      if (reliefMode) {
+        // 等深線の間隔は画素密度で決まるので、terrarium（512px）は256px換算のズームで引く
+        int[] intervals = contourIntervalsForZoom(terrarium ? zoom + TERRARIUM_DEM_ZOOM_OFFSET : zoom);
+        if (intervals != null) {
+          contourMinor = intervals[0];
+          contourMajor = intervals[1];
+        }
+      }
+      double[] rgbScratch = new double[3];
+
+      for (int py = 0; py < region; py++) {
+        int rowBase = (HALO + regionY0 + py) * bufferSize + HALO + regionX0;
+        for (int px = 0; px < region; px++) {
+          int center = rowBase + px;
+          int out = py * region + px;
+          float z0 = buffer[center];
+          if (Float.isNaN(z0)) {
+            pixels[out] = 0; // 透明
+            continue;
+          }
+
+          // MPI: 各方位の最大仰角の平均
+          float sumUp = 0.0f;
+          for (int d = 0; d < NUM_DIRECTIONS; d++) {
+            int base = d * SEARCH_RADIUS;
+            float maxTan = Float.NEGATIVE_INFINITY;
+            for (int s = 0; s < SEARCH_RADIUS; s++) {
+              int k = base + s;
+              float zp = buffer[center + offsets[k]];
+              if (Float.isNaN(zp)) continue;
+              float t = (zp - z0) * invDistances[k];
+              if (t > maxTan) maxTan = t;
+            }
+            // 有効な標本がなければ水平とみなす。尾根では負になるので丸めない
+            sumUp += (maxTan == Float.NEGATIVE_INFINITY) ? 0.0f : (float) Math.atan(maxTan);
+          }
+          float mpi = (sumUp / NUM_DIRECTIONS) * toDeg;
+
+          // 傾斜: 中央差分
+          float gx = (buffer[center + 1] - buffer[center - 1]) * slopeInv;
+          float gy = (buffer[center + bufferSize] - buffer[center - bufferSize]) * slopeInv;
+          float slope = (float) Math.atan(Math.sqrt(gx * gx + gy * gy)) * toDeg;
+          if (Float.isNaN(slope)) {
+            pixels[out] = 0; // 透明
+            continue;
+          }
+
+          // 2つの暗さを乗算する
+          float sTerm = clamp01(slope / SLOPE_MAX_DEG);
+          float mTerm = (float) Math.pow(clamp01(mpi / MPI_MAX_DEG), MPI_GAMMA);
+
+          if (reliefMode) {
+            // 海岸優先: 海に接する陸画素は透明にして下のベース地図の海岸線を見せる。
+            // 海陸統合DEMは境界画素で陸のデータが優先され、近海を陸として塗ってしまうため
+            if (z0 >= 0.0f && hasSeaNeighbor(buffer, center, bufferSize)) {
+              pixels[out] = 0; // 透明
+              continue;
+            }
+            // 段彩色×陰影係数（下限付きで緩和）、海域には等深線を焼き込む
+            double shade = (1.0 - (double) sTerm) * (1.0 - (double) mTerm);
+            double factor = RELIEF_SHADE_MIN + (1.0 - RELIEF_SHADE_MIN) * shade;
+            if (contourMinor > 0 && z0 < 0.0f) {
+              float eRight = buffer[center + 1];
+              float eDown = buffer[center + bufferSize];
+              if (isContourPixel(z0, eRight, eDown, contourMajor)) {
+                factor *= CONTOUR_MAJOR_FACTOR;
+              } else if (isContourPixel(z0, eRight, eDown, contourMinor)) {
+                factor *= CONTOUR_MINOR_FACTOR;
+              }
+            }
+            reliefColor(z0, RELIEF_RAMP, rgbScratch);
+            int r = clamp255((int) Math.round(rgbScratch[0] * factor));
+            int g = clamp255((int) Math.round(rgbScratch[1] * factor));
+            int b = clamp255((int) Math.round(rgbScratch[2] * factor));
+            pixels[out] = 0xff000000 | (r << 16) | (g << 8) | b;
+            continue;
+          }
+
+          // 方向陰影: Horn法の勾配と光源方向の内積。バッファの行は南へ進む
+          int w = bufferSize;
+          double nw = buffer[center - w - 1], n = buffer[center - w], ne = buffer[center - w + 1];
+          double we = buffer[center - 1], ea = buffer[center + 1];
+          double sw = buffer[center + w - 1], so = buffer[center + w], se = buffer[center + w + 1];
+          double dzdx = (ne + 2 * ea + se - (nw + 2 * we + sw)) / (8.0 * metersPerPx);
+          double dzdy = (nw + 2 * n + ne - (sw + 2 * so + se)) / (8.0 * metersPerPx);
+          double dot = (-dzdx * LIGHT_EAST - dzdy * LIGHT_NORTH + LIGHT_UP) / Math.sqrt(dzdx * dzdx + dzdy * dzdy + 1.0);
+          if (Double.isNaN(dot)) {
+            pixels[out] = 0; // 透明
+            continue;
+          }
+          double h = dot < 0 ? 0 : dot;
+
+          // 下層（灰色h・不透明度a1）の上に上層（黒・不透明度a2＝MPIの乗算）を重ねたover合成
+          double g = (1.0 - (double) sTerm) * (1.0 - (double) mTerm);
+          double a1 = DIRECTIONAL_OPACITY;
+          double a2 = MPI_OPACITY * (1.0 - g);
+          double alpha = 1.0 - (1.0 - a1) * (1.0 - a2);
+          int gray = clamp255((int) Math.round(255.0 * (1.0 - a2) * a1 * h / alpha));
+          int a = clamp255((int) Math.round(255.0 * alpha));
+
+          pixels[out] = (a << 24) | (gray << 16) | (gray << 8) | gray;
+        }
+      }
+
+      Bitmap result = Bitmap.createBitmap(pixels, region, region, Bitmap.Config.ARGB_8888);
+
+      // 区画が地図タイルの寸法と違えば（オーバーズーム・z0）拡大・縮小する
+      int outSize = (int) this.tileSize;
+      if (region != outSize) {
+        Bitmap scaled = Bitmap.createScaledBitmap(result, outSize, outSize, true);
+        byte[] bytes = toPng(scaled);
+        result.recycle();
+        scaled.recycle();
+        return bytes;
+      }
+
+      byte[] bytes = toPng(result);
+      result.recycle();
+      return bytes;
+
+    } catch (Exception e) {
+      Log.e(TAG, "Error creating shading", e);
+      return null;
+    }
+  }
+
+  private static float clamp01(float v) {
+    return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v);
+  }
+
+  private static int clamp255(int v) {
+    return v < 0 ? 0 : (v > 255 ? 255 : v);
+  }
+
+  /** 段彩色を区分線形補間で求める（0-255のdouble、丸めは呼び出し側で一度だけ行う） */
+  private static void reliefColor(double elev, double[][] ramp, double[] out) {
+    double[] first = ramp[0];
+    if (elev <= first[0]) {
+      out[0] = first[1]; out[1] = first[2]; out[2] = first[3];
+      return;
+    }
+    double[] last = ramp[ramp.length - 1];
+    if (elev >= last[0]) {
+      out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+      return;
+    }
+    for (int i = 1; i < ramp.length; i++) {
+      if (elev <= ramp[i][0]) {
+        double[] lo = ramp[i - 1];
+        double[] hi = ramp[i];
+        double t = (elev - lo[0]) / (hi[0] - lo[0]);
+        out[0] = lo[1] + (hi[1] - lo[1]) * t;
+        out[1] = lo[2] + (hi[2] - lo[2]) * t;
+        out[2] = lo[3] + (hi[3] - lo[3]) * t;
+        return;
+      }
+    }
+    out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+  }
+
+  /** sourceZoomに応じた{細線, 太線}の間隔。z4未満は等深線なし(null)、z9超はz9の値 */
+  private static int[] contourIntervalsForZoom(int zoom) {
+    int[] first = CONTOUR_INTERVALS[0];
+    if (zoom < first[0]) return null;
+    int[] last = CONTOUR_INTERVALS[CONTOUR_INTERVALS.length - 1];
+    if (zoom >= last[0]) return new int[] {last[1], last[2]};
+    for (int[] row : CONTOUR_INTERVALS) {
+      if (row[0] == zoom) return new int[] {row[1], row[2]};
+    }
+    return new int[] {last[1], last[2]};
+  }
+
+  /**
+   * GEBCOスタイル（デモ再現の近似）の描画。src/utils/colorRelief.ts の computeGebcoRelief と
+   * 同じ計算（指数補間の段彩×白0.85混合＋maplibre hillshadeシェーダの移植＋海陸両方の等値線）に、
+   * 主要等値線の数値ラベルを焼き込む。
+   */
+  private byte[] createGebcoShading(int x, int y, int zoom, int scaleFactor, int offsetX, int offsetY) {
+    try {
+      int size = demTileSize;
+      if (size <= 0) return null;
+
+      int bufferSize = size + 2 * HALO;
+      float[] buffer = assembleWithHalo(x, y, zoom, size, 0, 0, size);
+
+      int contourMinor = 0;
+      int contourMajor = 0;
+      int[] intervals = contourIntervalsForZoom(zoom);
+      if (intervals != null) {
+        contourMinor = intervals[0];
+        contourMajor = intervals[1];
+      }
+
+      // maplibre hillshade prepareシェーダのズーム依存derivスケール
+      double zoomFactor = zoom < 2 ? 0.4 : zoom < 4.5 ? 0.35 : 0.3;
+      double exaggerationZ = zoom < 15 ? (zoom - 15) * zoomFactor : 0;
+      double derivScale = 256.0 / Math.pow(2.0, exaggerationZ + GEBCO_DERIV_EXP - zoom);
+
+      // standard_hillshadeの定数
+      double azimuth = GEBCO_ILLUMINATION_DEG * Math.PI / 180.0 + Math.PI;
+      double intensity = GEBCO_HILLSHADE_EXAGGERATION;
+      double hillshadeBase = 1.875 - intensity * 1.75;
+      double maxValue = 0.5 * Math.PI;
+      double intensityClamp = Math.min(1.0, Math.max(0.0, intensity * 2.0));
+
+      int[] pixels = new int[size * size];
+      double[] rgbScratch = new double[3];
+
+      for (int py = 0; py < size; py++) {
+        int rowBase = (HALO + py) * bufferSize + HALO;
+        for (int px = 0; px < size; px++) {
+          int center = rowBase + px;
+          float z0 = buffer[center];
+          if (Float.isNaN(z0)) {
+            pixels[py * size + px] = 0; // 透明
+            continue;
+          }
+
+          // 段彩（指数補間＋白との混合）
+          gebcoReliefColor(z0, rgbScratch);
+          double r = GEBCO_BASE_MIX * rgbScratch[0] + (1.0 - GEBCO_BASE_MIX) * 255.0;
+          double g = GEBCO_BASE_MIX * rgbScratch[1] + (1.0 - GEBCO_BASE_MIX) * 255.0;
+          double b = GEBCO_BASE_MIX * rgbScratch[2] + (1.0 - GEBCO_BASE_MIX) * 255.0;
+
+          // maplibre hillshade（standard法）の合成
+          float a9 = buffer[center - bufferSize - 1];
+          float b9 = buffer[center - bufferSize];
+          float c9 = buffer[center - bufferSize + 1];
+          float d9 = buffer[center - 1];
+          float f9 = buffer[center + 1];
+          float g9 = buffer[center + bufferSize - 1];
+          float h9 = buffer[center + bufferSize];
+          float i9 = buffer[center + bufferSize + 1];
+          float window9 = a9 + b9 + c9 + d9 + f9 + g9 + h9 + i9;
+          if (!Float.isNaN(window9)) {
+            double derivX = (c9 + f9 + f9 + i9 - (a9 + d9 + d9 + g9)) * derivScale;
+            double derivY = (g9 + h9 + h9 + i9 - (a9 + b9 + b9 + c9)) * derivScale;
+            double slope = Math.atan(0.625 * Math.sqrt(derivX * derivX + derivY * derivY));
+            double aspect = derivX != 0 ? Math.atan2(derivY, -derivX) : (Math.PI / 2.0) * (derivY > 0 ? 1 : -1);
+            double scaledSlope = intensity != 0.5
+              ? ((Math.pow(hillshadeBase, slope) - 1.0) / (Math.pow(hillshadeBase, maxValue) - 1.0)) * maxValue
+              : slope;
+            double accentA = GEBCO_ACCENT_ALPHA * (1.0 - Math.cos(scaledSlope)) * intensityClamp;
+            double shade = Math.abs(((aspect + azimuth) / Math.PI + 0.5) % 2.0 - 1.0);
+            double sinSlope = Math.sin(scaledSlope) * intensityClamp;
+            double shadeR = 255.0 * GEBCO_HIGHLIGHT_ALPHA * shade * sinSlope;
+            double shadeA = (GEBCO_SHADOW_ALPHA * (1.0 - shade) + GEBCO_HIGHLIGHT_ALPHA * shade) * sinSlope;
+            double fragA = accentA * (1.0 - shadeA) + shadeA;
+            r = shadeR + r * (1.0 - fragA);
+            g = shadeR + g * (1.0 - fragA);
+            b = shadeR + b * (1.0 - fragA);
+          }
+
+          // 等値線（海陸を問わず）。数値ラベルはアプリ側のMarkerで表示する（HomeSeaLabels.tsx）
+          if (contourMinor > 0) {
+            float eRight = buffer[center + 1];
+            float eDown = buffer[center + bufferSize];
+            if (crossesInterval(z0, eRight, eDown, contourMajor)) {
+              r *= GEBCO_CONTOUR_MAJOR_FACTOR;
+              g *= GEBCO_CONTOUR_MAJOR_FACTOR;
+              b *= GEBCO_CONTOUR_MAJOR_FACTOR;
+            } else if (crossesInterval(z0, eRight, eDown, contourMinor)) {
+              r *= GEBCO_CONTOUR_MINOR_FACTOR;
+              g *= GEBCO_CONTOUR_MINOR_FACTOR;
+              b *= GEBCO_CONTOUR_MINOR_FACTOR;
+            }
+          }
+
+          pixels[py * size + px] = 0xff000000
+            | (clamp255((int) Math.round(r)) << 16)
+            | (clamp255((int) Math.round(g)) << 8)
+            | clamp255((int) Math.round(b));
+        }
+      }
+
+      Bitmap result = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+      result.setPixels(pixels, 0, size, 0, 0, size, size);
+
+      // オーバーズーム時は該当部分を切り出してソース解像度（size）へ拡大する
+      // （出力はoutTileSize()＝実寸で返すため、512pxソースの詳細が保たれる）
+      if (scaleFactor > 1) {
+        int cropSize = Math.max(1, size / scaleFactor);
+        Bitmap cropped = Bitmap.createBitmap(result, offsetX * cropSize, offsetY * cropSize, cropSize, cropSize);
+        Bitmap scaled = Bitmap.createScaledBitmap(cropped, size, size, true);
+        byte[] bytes = toPng(scaled);
+        result.recycle();
+        cropped.recycle();
+        scaled.recycle();
+        return bytes;
+      }
+
+      byte[] bytes = toPng(result);
+      result.recycle();
+      return bytes;
+
+    } catch (Exception e) {
+      Log.e(TAG, "Error creating gebco shading", e);
+      return null;
+    }
+  }
+
+  // 島名・海底地形名と等値線の数値ラベルは、タイル焼き込みではなくアプリ側のMarker
+  // オーバーレイで表示する（src/components/organisms/HomeSeaLabels.tsx。
+  // 鮮明・正立・タイル境界切れなしのため）
+
+  /** maplibreのexponential補間係数（0-1） */
+  private static double exponentialInterpolationFactor(double input, double base, double lower, double upper) {
+    double difference = upper - lower;
+    double progress = input - lower;
+    if (difference == 0) return 0;
+    if (base == 1) return progress / difference;
+    return (Math.pow(base, progress) - 1.0) / (Math.pow(base, difference) - 1.0);
+  }
+
+  /** GEBCO配色を指数補間(0.8)で求める */
+  private static void gebcoReliefColor(double elev, double[] out) {
+    double[] first = GEBCO_RELIEF_RAMP[0];
+    if (elev <= first[0]) {
+      out[0] = first[1]; out[1] = first[2]; out[2] = first[3];
+      return;
+    }
+    double[] last = GEBCO_RELIEF_RAMP[GEBCO_RELIEF_RAMP.length - 1];
+    if (elev >= last[0]) {
+      out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+      return;
+    }
+    for (int i = 1; i < GEBCO_RELIEF_RAMP.length; i++) {
+      if (elev <= GEBCO_RELIEF_RAMP[i][0]) {
+        double[] lo = GEBCO_RELIEF_RAMP[i - 1];
+        double[] hi = GEBCO_RELIEF_RAMP[i];
+        double t = exponentialInterpolationFactor(elev, GEBCO_EXP_BASE, lo[0], hi[0]);
+        out[0] = lo[1] + (hi[1] - lo[1]) * t;
+        out[1] = lo[2] + (hi[2] - lo[2]) * t;
+        out[2] = lo[3] + (hi[3] - lo[3]) * t;
+        return;
+      }
+    }
+    out[0] = last[1]; out[1] = last[2]; out[2] = last[3];
+  }
+
+  /** 等値線の横断判定（海陸を問わない。GEBCOスタイル用）。NaN隣接は線にしない */
+  private static boolean crossesInterval(float e0, float eRight, float eDown, int interval) {
+    double level = Math.floor((double) e0 / interval);
+    if (!Float.isNaN(eRight) && Math.floor((double) eRight / interval) != level) return true;
+    if (!Float.isNaN(eDown) && Math.floor((double) eDown / interval) != level) return true;
+    return false;
+  }
+
+  /** 8近傍に海（負の標高）があるか。NaN（NoData）は海とみなさない */
+  private static boolean hasSeaNeighbor(float[] buffer, int center, int bufferSize) {
+    return buffer[center - 1] < 0.0f
+      || buffer[center + 1] < 0.0f
+      || buffer[center - bufferSize] < 0.0f
+      || buffer[center + bufferSize] < 0.0f
+      || buffer[center - bufferSize - 1] < 0.0f
+      || buffer[center - bufferSize + 1] < 0.0f
+      || buffer[center + bufferSize - 1] < 0.0f
+      || buffer[center + bufferSize + 1] < 0.0f;
+  }
+
+  /**
+   * 等深線画素の判定。中央と右隣・下隣のfloor(e/interval)が異なれば線とする。
+   * 海域のみ対象で、隣が陸（>=0）またはNoDataなら線を引かない
+   * （0m等深線は引かず、海岸線は段彩の不連続に任せる）。floorは負値でも床関数。
+   */
+  private static boolean isContourPixel(float e0, float eRight, float eDown, int interval) {
+    double level = Math.floor((double) e0 / interval);
+    if (!Float.isNaN(eRight) && eRight < 0.0f && Math.floor((double) eRight / interval) != level) return true;
+    if (!Float.isNaN(eDown) && eDown < 0.0f && Math.floor((double) eDown / interval) != level) return true;
+    return false;
+  }
+
+  private static byte[] toPng(Bitmap bitmap) {
+    ByteArrayOutputStream stream = new ByteArrayOutputStream();
+    bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream);
+    return stream.toByteArray();
+  }
+
+  @Override
+  public void setUrlTemplate(String urlTemplate) {
+    super.setUrlTemplate(cleanUrlTemplate(urlTemplate));
+    this.reliefMode = urlTemplate != null && urlTemplate.startsWith("relief://");
+    this.gebcoStyle = urlTemplate != null && urlTemplate.contains("#style=gebco");
+    this.terrarium = !(this.reliefMode && this.gebcoStyle);
+    shadingCache.evictAll();
+    elevationCache.evictAll();
+  }
+}
