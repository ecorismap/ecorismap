+// 属性（Attributes）を出力し、対応する色と値を返す関数
+NSDictionary *getFeatureAttributes(Tile_Layer *layer, Tile_Feature *feature) {
+  NSMutableDictionary *attributeDict = [NSMutableDictionary dictionary];
+  NSUInteger tagsCount = feature.tagsArray_Count;
+  
+  @try {
+    for (NSUInteger i = 0; i < tagsCount; i += 2) {
+      if (i + 1 >= tagsCount) break; // 範囲チェック
+      
+      NSUInteger keyIndex = [feature.tagsArray valueAtIndex:i];
+      NSUInteger valueIndex = [feature.tagsArray valueAtIndex:i + 1];
+      
+      if (keyIndex >= layer.keysArray_Count || valueIndex >= layer.valuesArray_Count) {
+        continue; // 無効なインデックスをスキップ
+      }
+
+      NSString *key = layer.keysArray[keyIndex];
+      Tile_Value *valueObj = layer.valuesArray[valueIndex];
+      
+      // 型に応じて適切なオブジェクトを設定（文字列変換せずに元の型を保持）
+      if (valueObj.hasStringValue) {
+        [attributeDict setObject:valueObj.stringValue forKey:key];
+      } else if (valueObj.hasIntValue) {
+        [attributeDict setObject:@(valueObj.intValue) forKey:key];
+      } else if (valueObj.hasFloatValue) {
+        [attributeDict setObject:@(valueObj.floatValue) forKey:key];
+      } else if (valueObj.hasDoubleValue) {
+        [attributeDict setObject:@(valueObj.doubleValue) forKey:key];
+      } else if (valueObj.hasBoolValue) {
+        [attributeDict setObject:(valueObj.boolValue ? @YES : @NO) forKey:key];
+      } else {
+        // その他の型の場合は空文字列を設定
+        [attributeDict setObject:@"" forKey:key];
+      }
+    }
+  } @catch (NSException *exception) {
+    NSLog(@"Error in getFeatureAttributes: %@", exception.reason);
+  }
+  
+  return attributeDict;
+}
