+          float labelHaloWidth = (float) StyleExpression.evalNumber(paint.get("text-halo-width"), ctx, 0, layerId + "/text-halo-width");
+          double textOpacity = clamp01(StyleExpression.evalNumber(paint.get("text-opacity"), ctx, 1, layerId + "/text-opacity"));
+          CssColor textColor = StyleExpression.evalColor(paint.get("text-color"), ctx, black, layerId + "/text-color");
