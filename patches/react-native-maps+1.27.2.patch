+//  解釈し、式評価器（StyleExpression）の中で色として受け渡しする。
+//  Foundation だけに依存する（UIKit には依存しない）。UIColor への変換は描画側で行う。
+//  解釈の規則は @maplibre/maplibre-gl-style-spec の parseCssColor と同じ。
+//
+
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface CssColor : NSObject
+
+/// 0〜255（小数も可、非プリマルチプライ）
+@property(nonatomic, readonly) double r;
+@property(nonatomic, readonly) double g;
+@property(nonatomic, readonly) double b;
+/// 0〜1
+@property(nonatomic, readonly) double a;
+
++ (instancetype)colorWithR:(double)r g:(double)g b:(double)b a:(double)a;
+
+/// CSS 色文字列を解釈する。解釈できなければ nil。
++ (nullable CssColor *)parse:(NSString *)input;
+
