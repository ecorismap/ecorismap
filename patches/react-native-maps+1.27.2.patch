+    NSInteger bufferSize = size + 2 * kHalo;
+    NSMutableData *buffer = [NSMutableData dataWithLength:(NSUInteger)(bufferSize * bufferSize * (NSInteger)sizeof(float))];
+    float *dst = (float *)buffer.mutableBytes;
