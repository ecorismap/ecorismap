+      if (isErrorV(haystack)) return kErrorValue;
+      if (!jsTruthy(haystack)) return boxBool(NO);
+      if (!(isBoolV(needle) || isStringV(needle) || isNumberV(needle) || isNullV(needle))) return kErrorValue;
+      if (isStringV(haystack)) {
+        NSString *n = [self valueToString:needle];
+        if (isNullV(needle)) n = @"null"; // JS: "abc".indexOf(null) は "null" を探す
