+
+static double clamp01(double v) {
+  return MIN(MAX(v, 0), 1);
+}
+
+/// スタイルレイヤの描画。paint/layout の各プロパティは地物ごとに式として評価する（データ連動）。
+/// 評価できない値はそのプロパティの既定値（MapLibre Style Spec v8）に退避し、レイヤは落とさない。
+- (void)applyStyleToContext:(CGContextRef)context
+             withStyleLayer:(NSDictionary *)styleLayer
+                  andSource:(VectorSource *)source
+                       zoom:(double)zoom {
+  @try {
+    if (!context || !styleLayer || !source) {
+      NSLog(@"Warning: Invalid parameters for applyStyleToContext");
+      return;
+    }
+    NSString *type = styleLayer[@"type"];
+    if (![type isKindOfClass:[NSString class]]) {
+      NSLog(@"Warning: Invalid or missing layer type");
+      return;
+    }
+    NSDictionary *paint = [styleLayer[@"paint"] isKindOfClass:[NSDictionary class]] ? styleLayer[@"paint"] : @{};
+    NSDictionary *layout = [styleLayer[@"layout"] isKindOfClass:[NSDictionary class]] ? styleLayer[@"layout"] : @{};
+    id filter = styleLayer[@"filter"]; // StyleManager が読込時に式へ正規化済み
+    if (filter == [NSNull null]) filter = nil;
+    NSString *layerId = [styleLayer[@"id"] isKindOfClass:[NSString class]] ? styleLayer[@"id"] : @"?";
+    NSString *(^key)(NSString *) = ^NSString *(NSString *prop) {
+      return [NSString stringWithFormat:@"%@/%@", layerId, prop];
+    };
+    CssColor *black = [CssColor colorWithR:0 g:0 b:0 a:1];
+
+    if ([type isEqualToString:@"circle"]) {
+      for (FeatureData *feature in source.features) {
+        if (![feature.geometry isKindOfClass:[NSArray class]]) continue;
+        EvalContext *ctx = makeEvalContext(feature, zoom);
+        if (![StyleExpression evalFilter:filter context:ctx]) continue;
+
+        CssColor *color = [StyleExpression evalColor:paint[@"circle-color"] context:ctx defaultValue:black key:key(@"circle-color")];
+        double radius = [StyleExpression evalNumber:paint[@"circle-radius"] context:ctx defaultValue:5 key:key(@"circle-radius")];
+        double opacity = clamp01([StyleExpression evalNumber:paint[@"circle-opacity"] context:ctx defaultValue:1 key:key(@"circle-opacity")]);
+        CssColor *strokeColor = [StyleExpression evalColor:paint[@"circle-stroke-color"] context:ctx defaultValue:black key:key(@"circle-stroke-color")];
+        double strokeWidth = [StyleExpression evalNumber:paint[@"circle-stroke-width"] context:ctx defaultValue:0 key:key(@"circle-stroke-width")];
+        double strokeOpacity = clamp01([StyleExpression evalNumber:paint[@"circle-stroke-opacity"] context:ctx defaultValue:1 key:key(@"circle-stroke-opacity")]);
+        if (radius <= 0) continue;
+
+        CGContextSetFillColorWithColor(context, [UIColor colorWithCssColor:color opacity:opacity].CGColor);
+        CGContextSetStrokeColorWithColor(context, [UIColor colorWithCssColor:strokeColor opacity:strokeOpacity].CGColor);
+        CGContextSetLineWidth(context, strokeWidth);
+
+        NSArray<NSValue *> *points = (NSArray<NSValue *> *)feature.geometry;
+        for (NSValue *pointValue in points) {
+          CGPoint point = [pointValue CGPointValue];
+          CGRect circleRect = CGRectMake(point.x - radius, point.y - radius, radius * 2, radius * 2);
+          CGContextFillEllipseInRect(context, circleRect);
+          if (strokeWidth > 0) {
+            CGContextStrokeEllipseInRect(context, circleRect);
+          }
+        }
+      }
+    } else if ([type isEqualToString:@"line"]) {
+      for (FeatureData *feature in source.features) {
+        UIBezierPath *path = nil;
+        if ([feature.geometry isKindOfClass:[LineData class]]) {
+          path = ((LineData *)feature.geometry).path;
+        } else if ([feature.geometry isKindOfClass:[PolygonData class]]) {
+          path = ((PolygonData *)feature.geometry).path;
+        } else {
+          continue;
+        }
+        EvalContext *ctx = makeEvalContext(feature, zoom);
+        if (![StyleExpression evalFilter:filter context:ctx]) continue;
+
+        CssColor *color = [StyleExpression evalColor:paint[@"line-color"] context:ctx defaultValue:black key:key(@"line-color")];
+        double width = [StyleExpression evalNumber:paint[@"line-width"] context:ctx defaultValue:1 key:key(@"line-width")];
+        double opacity = clamp01([StyleExpression evalNumber:paint[@"line-opacity"] context:ctx defaultValue:1 key:key(@"line-opacity")]);
+        if (width <= 0 || opacity <= 0) continue;
+
+        CGContextSetStrokeColorWithColor(context, [UIColor colorWithCssColor:color opacity:opacity].CGColor);
+        CGContextSetLineWidth(context, width);
+        CGContextAddPath(context, path.CGPath);
+        CGContextDrawPath(context, kCGPathStroke);
+      }
+    } else if ([type isEqualToString:@"fill"]) {
+      for (FeatureData *feature in source.features) {
+        if (![feature.geometry isKindOfClass:[PolygonData class]]) continue;
+        PolygonData *polygonData = (PolygonData *)feature.geometry;
+        EvalContext *ctx = makeEvalContext(feature, zoom);
+        if (![StyleExpression evalFilter:filter context:ctx]) continue;
+
+        CssColor *fillColor = [StyleExpression evalColor:paint[@"fill-color"] context:ctx defaultValue:black key:key(@"fill-color")];
+        double fillOpacity = clamp01([StyleExpression evalNumber:paint[@"fill-opacity"] context:ctx defaultValue:1 key:key(@"fill-opacity")]);
+        CssColor *outlineColor = [StyleExpression evalColor:paint[@"fill-outline-color"] context:ctx defaultValue:fillColor key:key(@"fill-outline-color")];
+        if (fillOpacity <= 0) continue;
+
+        CGContextSetFillColorWithColor(context, [UIColor colorWithCssColor:fillColor].CGColor);
+        CGContextSetStrokeColorWithColor(context, [UIColor colorWithCssColor:outlineColor].CGColor);
+        CGContextSetLineWidth(context, 1.0); // 輪郭は常に 1px（maplibre の fill-outline-color と同じ）
+        CGContextAddPath(context, polygonData.path.CGPath);
+        CGContextSetAlpha(context, fillOpacity); // fill-opacity は塗りと輪郭の両方に効く
+        CGContextDrawPath(context, kCGPathEOFillStroke);
+        CGContextSetAlpha(context, 1);
+      }
+    } else if ([type isEqualToString:@"symbol"]) {
+      // 既に描画されたラベルの位置（同じレイヤ・同じタイル内だけで衝突判定する）
+      NSMutableArray<NSValue *> *drawnLabelsRects = [NSMutableArray array];
+      id textField = layout[@"text-field"];
+      CssColor *transparent = [CssColor colorWithR:0 g:0 b:0 a:0];
+
+      for (FeatureData *feature in source.features) {
+        EvalContext *ctx = makeEvalContext(feature, zoom);
+        if (![StyleExpression evalFilter:filter context:ctx]) continue;
+
+        NSString *label = [StyleExpression evalTextField:textField context:ctx];
+        if (label.length == 0) continue;
+        double labelSize = [StyleExpression evalNumber:layout[@"text-size"] context:ctx defaultValue:16 key:key(@"text-size")];
+        double labelHaloWidth = [StyleExpression evalNumber:paint[@"text-halo-width"] context:ctx defaultValue:0 key:key(@"text-halo-width")];
+        double textOpacity = clamp01([StyleExpression evalNumber:paint[@"text-opacity"] context:ctx defaultValue:1 key:key(@"text-opacity")]);
+        CssColor *textColor = [StyleExpression evalColor:paint[@"text-color"] context:ctx defaultValue:black key:key(@"text-color")];
+        CssColor *haloColor = [StyleExpression evalColor:paint[@"text-halo-color"] context:ctx defaultValue:transparent key:key(@"text-halo-color")];
+        if (labelSize <= 0 || textOpacity <= 0) continue;
+        UIColor *labelColor = [UIColor colorWithCssColor:textColor opacity:textOpacity];
+        UIColor *labelHaloColor = [UIColor colorWithCssColor:haloColor opacity:textOpacity];
+
+        float X = 0;
+        float Y = 0;
+        if ([feature.geometry isKindOfClass:[NSArray class]]) {
+          NSArray<NSValue *> *multiPoints = (NSArray<NSValue *> *)feature.geometry;
+          if (multiPoints.count == 0) continue;
+          CGPoint firstPoint = [multiPoints[0] CGPointValue];
+          X = firstPoint.x;
+          Y = firstPoint.y;
+        } else if ([feature.geometry isKindOfClass:[LineData class]]) {
+          LineData *line = (LineData *)feature.geometry;
+          X = line.centerX;
+          Y = line.centerY;
+        } else if ([feature.geometry isKindOfClass:[PolygonData class]]) {
+          PolygonData *polygon = (PolygonData *)feature.geometry;
+          X = polygon.centerX;
+          Y = polygon.centerY;
+        } else {
+          continue;
+        }
+
+        UIFont *font = [UIFont systemFontOfSize:labelSize];
+        CGSize labelSizeCalc = [label sizeWithAttributes:@{NSFontAttributeName : font}];
+        float textWidth = labelSizeCalc.width;
+        float textHeight = labelSizeCalc.height;
+        CGRect newLabelRect = CGRectMake(X - textWidth / 2, Y - textHeight / 2, textWidth, textHeight);
+
+        BOOL shouldDraw = YES;
+        for (NSValue *rectValue in drawnLabelsRects) {
+          if (CGRectIntersectsRect([rectValue CGRectValue], newLabelRect)) {
+            shouldDraw = NO;
+            break;
+          }
+        }
+        if (!shouldDraw) continue;
+
+        if (labelHaloWidth > 0 && haloColor.a > 0) {
+          CGContextSetLineWidth(context, labelHaloWidth);
+          CGContextSetStrokeColorWithColor(context, labelHaloColor.CGColor);
+          CGContextSetTextDrawingMode(context, kCGTextStroke);
+          [label drawAtPoint:CGPointMake(X, Y)
+              withAttributes:@{NSFontAttributeName : font, NSForegroundColorAttributeName : labelHaloColor}];
+        }
+        CGContextSetTextDrawingMode(context, kCGTextFill);
+        [label drawAtPoint:CGPointMake(X, Y)
+            withAttributes:@{NSFontAttributeName : font, NSForegroundColorAttributeName : labelColor}];
+
+        [drawnLabelsRects addObject:[NSValue valueWithCGRect:newLabelRect]];
+      }
+    } else {
+      NSLog(@"Warning: Unknown layer type: %@", type);
+      return;
+    }
+  } @catch (NSException *exception) {
+    // 最終防衛線。通常は式評価器がエラー値で返すのでここには来ない
+    NSLog(@"Error in applyStyleToContext: %@ - %@", exception.name, exception.reason);
+  }
+}
