+        NSInteger ny = (NSInteger)y + ty;
+        if (ny < 0 || ny >= max) continue;
+        for (NSInteger tx = -1; tx <= 1; tx++) {
+            if ((tx == -1 && !needLeft) || (tx == 1 && !needRight)) continue;
+            targets[targetCount][0] = tx;
+            targets[targetCount][1] = ty;
+            targets[targetCount][2] = (((NSInteger)x + tx) % max + max) % max; // 経度方向は巻き戻す
+            targets[targetCount][3] = ny;
+            targetCount++;
