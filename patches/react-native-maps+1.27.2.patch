+          PolygonData polygon = (PolygonData) feature.geometry;
+          EvalContext ctx = makeEvalContext(feature, zoom);
+          if (!StyleExpression.evalFilter(filter, ctx)) continue;
+
+          CssColor fillColor = StyleExpression.evalColor(paint.get("fill-color"), ctx, black, layerId + "/fill-color");
+          double fillOpacity = clamp01(StyleExpression.evalNumber(paint.get("fill-opacity"), ctx, 1, layerId + "/fill-opacity"));
+          CssColor outlineColor = StyleExpression.evalColor(paint.get("fill-outline-color"), ctx, fillColor, layerId + "/fill-outline-color");
+          if (fillOpacity <= 0) continue;
+
+          // fill-opacity は塗りと輪郭の両方に効く（iOS の CGContextSetAlpha と同じ）
+          fillPaint.setColor(argbWithOpacity(fillColor, fillOpacity));
+          fillPaint.setStyle(Paint.Style.FILL);
+          strokePaint.setColor(argbWithOpacity(outlineColor, fillOpacity));
+          strokePaint.setStyle(Paint.Style.STROKE);
+          strokePaint.setStrokeWidth(1); // 輪郭は常に 1px
