+        Log.w("MapPMTileProvider", "Unknown layer type: " + type);
+        return;
+      }
+    } catch (Exception e) {
+      // 最終防衛線。通常は式評価器がエラー値で返すのでここには来ない
+      Log.e("MapPMTileProvider", "Error in applyStyle: " + e.getMessage(), e);
+    }
+  }
