+/**
+ Wraps a promise so that it can be settled only once.
+ Photos framework callbacks (e.g. `requestLivePhoto`) may be invoked multiple times for a single
+ request and resolving an already settled promise crashes the app (expo/expo#46512).
+ */
+internal final class SingleResolvePromise: @unchecked Sendable {
+  private let promise: Promise
+  private let lock = NSLock()
+  private var isSettled = false
+
+  init(_ promise: Promise) {
+    self.promise = promise
+  }
+
+  func resolve(_ value: Any?) {
+    lock.lock()
+    if isSettled {
+      lock.unlock()
+      return
+    }
+    isSettled = true
+    lock.unlock()
+    promise.resolve(value)
+  }
+}
