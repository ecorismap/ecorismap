+  /**
+   * Registration keys are generated from [nextLocalRequestCode]. When the Activity is destroyed and
+   * recreated while the process (and this registry) survives, modules re-register their contracts and
+   * would otherwise receive fresh keys, so results that arrived for the old keys are never delivered
+   * (and [AppContextActivityResultFallbackCallback] never runs). Resetting the counter before the
+   * re-registration makes the keys match again, exactly like after a process restart.
+   */
+  fun resetRequestCodeCounter() {
+    nextLocalRequestCode.set(0)
+  }
